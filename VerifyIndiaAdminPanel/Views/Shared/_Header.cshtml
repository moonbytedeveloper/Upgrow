<script>
    async function reloadAdminMenuPartial() {
        try {
            await new Promise(r => setTimeout(r, 300));
            const res = await fetch('@Url.Action("RenderMenuPartial", "Master", new { area = "Admin" })', { credentials: 'same-origin' });
            if (!res.ok) {
                console.warn('Failed to fetch menu partial', res.status);
                return;
            }
            const html = await res.text();
            const container = document.querySelector('.menu-body.navbar-vertical.tab-content');

            if (container) {
                container.innerHTML = html;
                try {
                    if (window.feather && typeof feather.replace === 'function') feather.replace();
                    if (typeof initializeMenusAndUI === 'function') initializeMenusAndUI();
                    if (typeof activateMenu === 'function') activateMenu();

                    const t = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                    t.forEach(el => {
                        try { new bootstrap.Tooltip(el); } catch (e) { }
                    });
                } catch (e) { console.warn('Menu partial post-init failed', e); }
            } else {
                location.reload();
            }
        } catch (err) {
            console.error('reloadAdminMenuPartial error', err);
            location.reload();
        }
    }

    if (window.jQuery) {
        $(document).ajaxSuccess(function (event, xhr, settings) {
            try {
                var url = (settings && settings.url) ? settings.url.toLowerCase() : '';
                if (!url) return;
                if (url.indexOf('/admin/master/toggle') !== -1) {
                    setTimeout(reloadAdminMenuPartial, 250);
                }
            } catch (e) { }
        });
    }

    document.addEventListener('change', function (evt) {
        try {
            var t = evt.target;
            if (t && t.classList && t.classList.contains('toggle-status')) {
                setTimeout(reloadAdminMenuPartial, 300);
            }
        } catch (e) { }
    }, true);
</script> *@