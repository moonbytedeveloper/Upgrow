@section Scripts {
        <partial name="_ViewScripts" />
        <script src="~/assets/js/inputtypecomponent.js"></script>
        <script src="~/assets/js/custom.js"></script>
        <script src="~/assets/js/dp-dropdown.js"></script>
        <script src="~/assets/js/select2.min.js"></script>
        <script src="~/ckeditor/ckeditor.js"></script>
        <script src="~/assets/js/notification.js"></script>
        <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
        <script src="~/js/api-validation.js"></script>

        <script>
            // Global helper: safe to call from any handler (uses current DOM when invoked)
            window.currentApiXVersionUuid = function () {
                return ($('input[name="ApixVersionCommand.UUID"]').val() || $('#Header_ApiXVersionUUID').val() || '').toString();
            };

            // Global antiforgery header setup for all jQuery AJAX calls
            (function () {
                const token = $('input[name="__RequestVerificationToken"]').first().val() || '';
                if (token) {
                    $.ajaxSetup({
                        headers: { 'RequestVerificationToken': token }
                    });
                }
            })();
        </script>
        <!-- Append this small script near the end of the page  -->
        <script>
            (function () {
                const checkboxSel = 'input[name="ApixVersionCommand.IsRequestBodyRequired"]';
                const $liSchema = $('#tabRequestSchemaItem');
                const $liFields = $('#tabRequestFieldsItem');
                const $paneSchema = $('#RequestSchema');
                const $paneFields = $('#RequestScehmaFields');

                function updateRequestTabVisibility() {
                    const checked = $(checkboxSel).is(':checked');

                    if (checked) {
                        $liSchema.removeClass('d-none');
                        $paneSchema.removeClass('d-none');
                        $liFields.removeClass('d-none');
                        $paneFields.removeClass('d-none');
                    } else {
                        // if either request tab is active, switch to ApiHeader
                        try {
                            const activeTab = document.querySelector('.custom-tabs .nav-link.active');
                            if (activeTab && (activeTab.getAttribute('href') === '#RequestSchema' || activeTab.getAttribute('href') === '#RequestScehmaFields')) {
                                const headerTabEl = document.querySelector('.custom-tabs a[href="#ApiHeader"]');
                                if (headerTabEl && window.bootstrap && bootstrap.Tab) {
                                    bootstrap.Tab.getOrCreateInstance(headerTabEl).show();
                                } else {
                                    $('.custom-tabs a[href="#ApiHeader"]').trigger('click');
                                }
                            }
                        } catch (e) { /* ignore */ }

                        $liSchema.addClass('d-none');
                        $paneSchema.addClass('d-none');
                        $liFields.addClass('d-none');
                        $paneFields.addClass('d-none');
                    }

                    // reposition indicator if necessary (uses moveIndicator defined earlier in this file)
                    try {
                        const active = document.querySelector('.custom-tabs .nav-link.active');
                        if (active && typeof moveIndicator === 'function') moveIndicator(active);
                    } catch (e) { /* ignore */ }
                }

                $(function () {
                    // update initial state on load
                    updateRequestTabVisibility();

                    // listen for change (handles both user clicks and programmatic changes)
                    $(document).on('change', checkboxSel, updateRequestTabVisibility);
                });
            })();
        </script>
        <script>

                    const tabs = document.querySelectorAll('.custom-tabs .nav-link');
                    const indicator = document.querySelector('.tab-indicator');

                    function moveIndicator(element) {
                        const rect = element.getBoundingClientRect();
                        const parentRect = element.closest('.custom-tabs').getBoundingClientRect();

                        indicator.style.width = rect.width + "px";
                        indicator.style.left = (rect.left - parentRect.left) + "px";
                    }

                    tabs.forEach(tab => {
                        tab.addEventListener('shown.bs.tab', function (e) {
                            moveIndicator(e.target);
                        });
                    });

                    // Set initial position
                    window.addEventListener('load', () => {
                        const active = document.querySelector('.custom-tabs .nav-link.active');
                        if (active) moveIndicator(active);
                    });


                    const tokenHeader = { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() };

                    // helper
                    function setButtonMode($btn, mode) {
                        if (!($btn && $btn.length)) return;
                        $btn.text(mode === 'update' ? 'Update' : 'Add').data('mode', mode);
                    }

                    $(document).ready(function () {
                        function currentApiXVersionUuid() {
                            return ($('input[name="ApixVersionCommand.UUID"]').val() || $('#Header_ApiXVersionUUID').val() || '').toString();
                        }

                        function positionMenuAt($menu, pageX, pageY) {
                            const menuW = $menu.outerWidth() || 180;
                            const menuH = $menu.outerHeight() || 120;
                            const winW = $(window).width(), winH = $(window).height();
                            let left = pageX, top = pageY;
                            if (left + menuW > winW) left = winW - menuW - 12;
                            if (top + menuH > winH) top = winH - menuH - 12;
                            $menu.css({ top: top + 'px', left: left + 'px', position: 'absolute' });
                        }

                                           const headersTable = $('#headersTable').DataTable({
                            processing: true,
                            serverSide: true,
                            ajax: {
                                url: '@Url.Action("GetApiXHeaders", "AIX")',
                                type: 'POST',
                                headers: tokenHeader,
                                data: function (d) {
                                    const ver = ($('#Header_ApiXVersionUUID').val() || $('input[name="ApixVersionCommand.UUID"]').val() || '').toString().trim();
                                    if (ver) d.apiXVersionUUID = ver;
                                    // keep DataTables' own params (start/length/search/order) intact
                                },
                                error: function (xhr, textStatus, errorThrown) {
                                    console.error('GetApiXHeaders error', textStatus, errorThrown, xhr?.responseText);
                                }
                            },
                            columns: [
                                { data: null, render: function (data, type, row, meta) { return meta.row + (meta.settings._iDisplayStart || 0) + 1; }, orderable: false },
                                { data: 'uuid', visible: false },
                                { data: 'fieldName' },
                                { data: 'dataType' },
                                { data: 'fieldDetails' },
                                { data: 'isRequired' },
                                { data: 'action', orderable: false }
                            ],
                            createdRow: function (row, data) {
                                try { if (data && data.uuid) $(row).attr('data-uuid', data.uuid); } catch (ex) { /* ignore */ }
                            },
                            drawCallback: function () {
                                $('#rowActionMenu').hide();
                                $('#headersTable tbody tr').removeClass('selected');
                            }
                        });



                        // show floating menu when clicking a header row


                        (function () {
                            // helper to resolve uuid reliably from a row element
                            function resolveHeaderRowUuid($tr) {
                                if (!$tr || !$tr.length) return '';
                                try {
                                    const dt = $('#headersTable').DataTable();
                                    const d = dt.row($tr).data();
                                    if (d && d.uuid) return (d.uuid || '').toString().trim();
                                } catch (e) { /* ignore if DataTable not initialized yet */ }

                                // prefer data-uuid attribute if present
                                const attr = ($tr.attr('data-uuid') || '').toString().trim();
                                if (attr) return attr;

                                // fallback to the hidden column text (index 1) — defensive only
                                const text = ($tr.find('td').eq(1).text() || '').toString().trim();
                                return text;
                            }

                            // ensure menu variable exists (shared scripts expect #rowActionMenu)
                            const $rowActionMenu = $('#rowActionMenu').length ? $('#rowActionMenu').appendTo('body').hide() : $();

                            // show floating menu when clicking a header row — stores resolved uuid on the menu
                            $('#headersTable tbody').off('click.headerRow').on('click.headerRow', 'tr', function (e) {
                                const $tr = $(this);
                                const uuid = resolveHeaderRowUuid($tr);
                                if (!uuid) return;

                                // visual selection
                                $('#headersTable tbody tr').removeClass('selected');
                                $tr.addClass('selected');

                                // show/position menu and store uuid
                                if ($rowActionMenu && $rowActionMenu.length) {
                                    const pageX = e.pageX || (e.clientX + $(window).scrollLeft());
                                    const pageY = e.pageY || (e.clientY + $(window).scrollTop());
                                    try { positionMenuAt($rowActionMenu, pageX, pageY); } catch (ex) { /* ignore */ }
                                    $rowActionMenu.data('uuid', uuid).show();
                                } else {
                                    // as a defensive fallback, also set a global var
                                    window.__lastHeaderUuid = uuid;
                                }

                                e.stopPropagation();
                            });

                            // Edit handler: read uuid from menu (or fallback to selected row via DataTables)
                            $('#editHeaderLink').off('click.editHeader').on('click.editHeader', function (ev) {
                                ev.preventDefault();
                                let uuid = ($rowActionMenu && $rowActionMenu.length) ? ($rowActionMenu.data('uuid') || '') : (window.__lastHeaderUuid || '');

                                if (!uuid) {
                                    // fallback: pick selected row and resolve via DataTables
                                    const $sel = $('#headersTable tbody tr.selected').first();
                                    uuid = resolveHeaderRowUuid($sel);
                                }

                                if (!uuid) { alert('Please select a header row first.'); return; }

                                const apiXVersionUuid = currentApiXVersionUuid();
                                const data = { uuid: uuid };
                                if (apiXVersionUuid && apiXVersionUuid.toString().trim() !== '') data.apiXVersionUUID = apiXVersionUuid.toString().trim();

                                $.get('@Url.Action("EditHeaderJson", "AIX")', data)
                                    .done(function (resp) {
                                            if (!resp || !resp.success || !resp.item) {  showError(resp?.error || (resp?.message || 'Not found'));
            return; }
                                        const item = resp.item;
                                        $('#Header_UUID').val(item.uuid || '');
                                        $('#Header_ApiXVersionUUID').val(item.apiXVersionUUID || $('input[name="ApixVersionCommand.UUID"]').val() || '');
                                        $('input[name="Header.FieldName"]').val(item.fieldName || '');
                                        $('select[name="Header.DataType"]').val(item.dataType || '').trigger('change');
                                        $('textarea[name="Header.FieldDetails"]').val(item.fieldDetails || '');
                                        $('input[name="Header.IsRequired"]').prop('checked', !!item.isRequired);
                                        setButtonMode($('#addHeaderBtn'), 'update');
                                        if ($rowActionMenu && $rowActionMenu.length) $rowActionMenu.hide();
                                        $('html, body').animate({ scrollTop: $('#headerForm').offset().top - 80 }, 220);
                                    })
                                                .fail(function(xhr) {
                showServerError(xhr, 'Server error while loading item');
            });
                            });
                        })();


                        // keep the other global handlers that hide menus in sync (they already reference hideRowMenu/hideRequestMenu)
                        $(document).off('click.hideRowAction keyup.hideRowAction').on('click.hideRowAction keyup.hideRowAction', function (e) {
                            if (e.type === 'keyup' && e.key !== 'Escape') return;

                            const target = $(e.target);
                            const insideHeader = target.closest('#rowActionMenu').length > 0 || target.closest('#headersTable').length > 0;
                            const insideRequest = target.closest('#rowRequestMenu').length > 0 || target.closest('#requestFieldsTable').length > 0 || target.closest('#responseFieldsTable').length > 0 || target.closest('#failureFieldsTable').length > 0;

                            if (!insideHeader) hideRowMenu();
                            if (!insideRequest) hideRequestMenu();
                        });

                        $(window).on('resize scroll', function () { hideRowMenu(); hideRequestMenu(); });

                              function hideRowMenu() {
                const $menu = $('#rowActionMenu');
                if ($menu.length) {
                    $menu.hide();
                }
                $('#headersTable tbody tr').removeClass('selected');
            }

                        // Columns reused by request/response/failure field DataTables.
                        // Must match the shape returned by GetReqResFields (example, displayOrder, allowNull, isArray, action)
                        const commonFieldColumns = [
                            {
                                data: null,
                                render: function (data, type, row, meta) {
                                    return meta.row + (meta.settings._iDisplayStart || 0) + 1;
                                },
                                orderable: false
                            },
                            { data: 'uuid', visible: false },
                            { data: 'fieldName' },
                            { data: 'dataType' },
                            { data: 'example' },        // server returns "example" mapped from DTO.Examlpe
                            { data: 'displayOrder' },
                            { data: 'allowNull' },
                            { data: 'isArray' },
                            { data: 'action', orderable: false }
                        ];

                                   // lazy-init pattern for field/code-mapper tables to ensure identical DataTable rendering as headers
                        let requestFieldsTable, responseFieldsTable, failureFieldsTable, codeMapperTable;

                        function createRequestFieldsTable() {
                            if (requestFieldsTable) return requestFieldsTable;
                            requestFieldsTable = $('#requestFieldsTable').DataTable({
                                processing: true, serverSide: true,
                                ajax: {
                                    url: '@Url.Action("GetReqResFields", "AIX")', type: 'POST',
                                    headers: tokenHeader,
                                    data: function (d) {
                                        d.apiXVersionUUID = ($('input[name="ApixVersionCommand.UUID"]').val() || $('#Header_ApiXVersionUUID').val() || '').toString();
                                        d.schemaUUID = ($('#RequestSchema_UUID').val() || '').toString();
                                    },
                                    error: function (xhr) { console.error('GetReqResFields (request) error', xhr); }
                                },
                                columns: commonFieldColumns,
                                createdRow: function (row, data) { try { if (data && data.uuid) $(row).attr('data-uuid', data.uuid); } catch (e) {} },
                                drawCallback: function () { $('#rowRequestMenu').hide(); $('#requestFieldsTable tbody tr').removeClass('selected'); }
                            });
                            return requestFieldsTable;
                        }

                        function createResponseFieldsTable() {
                            if (responseFieldsTable) return responseFieldsTable;
                            responseFieldsTable = $('#responseFieldsTable').DataTable({
                                processing: true, serverSide: true,
                                ajax: {
                                    url: '@Url.Action("GetReqResFields", "AIX")', type: 'POST',
                                    headers: tokenHeader,
                                    data: function (d) {
                                        d.apiXVersionUUID = ($('input[name="ApixVersionCommand.UUID"]').val() || $('#Header_ApiXVersionUUID').val() || '').toString();
                                        d.schemaUUID = ($('#ResponseSchema_UUID').val() || '').toString();
                                        d.isSchemaForSuccess = true;
                                    },
                                    error: function (xhr) { console.error('GetReqResFields (response) error', xhr); }
                                },
                                columns: commonFieldColumns,
                                createdRow: function (row, data) { try { if (data && data.uuid) $(row).attr('data-uuid', data.uuid); } catch (e) {} },
                                drawCallback: function () { $('#rowRequestMenu').hide(); $('#responseFieldsTable tbody tr').removeClass('selected'); }
                            });
                            return responseFieldsTable;
                        }

                        function createFailureFieldsTable() {
                            if (failureFieldsTable) return failureFieldsTable;
                            failureFieldsTable = $('#failureFieldsTable').DataTable({
                                processing: true, serverSide: true,
                                ajax: {
                                    url: '@Url.Action("GetReqResFields", "AIX")', type: 'POST',
                                    headers: tokenHeader,
                                    data: function (d) {
                                        d.apiXVersionUUID = ($('input[name="ApixVersionCommand.UUID"]').val() || $('#Header_ApiXVersionUUID').val() || '').toString();
                                        d.schemaUUID = ($('#FailureSchema_UUID').val() || '').toString();
                                        d.isSchemaForSuccess = false;
                                    },
                                    error: function (xhr) { console.error('GetReqResFields (failure) error', xhr); }
                                },
                                columns: commonFieldColumns,
                                createdRow: function (row, data) { try { if (data && data.uuid) $(row).attr('data-uuid', data.uuid); } catch (e) {} },
                                drawCallback: function () { $('#rowRequestMenu').hide(); $('#failureFieldsTable tbody tr').removeClass('selected'); }
                            });
                            return failureFieldsTable;
                        }

                        function createCodeMapperTable() {
                            if (codeMapperTable) return codeMapperTable;
                            codeMapperTable = $('#codeMapperTable').DataTable({
                                processing: true, serverSide: true,
                                ajax: {
                                    url: '@Url.Action("GetApiXCodeMappers", "AIX")', type: 'POST',
                                    headers: tokenHeader,
                                    data: function (d) {
                                        const versionUUID = ($('#CodeMapper_ApiXVersionUUID').val() || $('input[name="ApixVersionCommand.UUID"]').val() || '').toString().trim();
                                        if (versionUUID) d.apiXVersionUUID = versionUUID;
                                    },
                                    error: function (xhr) { console.error('GetApiXCodeMappers error', xhr); }
                                },
                                columns: [
                                    { data: null, render: (data, type, row, meta) => meta.row + (meta.settings._iDisplayStart || 0) + 1, orderable: false },
                                    { data: 'uuid', visible: false },
                                    { data: 'statusTitle' },
                                    { data: 'responseSchemaType' },
                                    { data: 'codeExampleTitle' },
                                    { data: 'shortDescription' },
                                    { data: 'action', orderable: false }
                                ],
                                createdRow: function (row, data) { try { if (data && data.uuid) $(row).attr('data-uuid', data.uuid); } catch (e) {} },
                                drawCallback: function () { $('#codeMapperTable tbody tr').removeClass('selected'); }
                            });
                            return codeMapperTable;
                        }

                                    let languageSnippetTable = null;

                        function createLanguageSnippetTable() {

                            if (languageSnippetTable)
                                return languageSnippetTable;

                            languageSnippetTable = $('#languageSnippetTable').DataTable({

                                processing: true,
                                serverSide: true,

                                ajax: {
                                    url: '@Url.Action("GetLanguageSnippets", "AIX")',
                                    type: 'POST',
                                    headers: tokenHeader,

                                    data: function (d) {

                                        const versionUUID =
                                            (
                                                $('#LanguageSnippet_ApiXVersionUUID').val()
                                                || $('input[name="ApixVersionCommand.UUID"]').val()
                                                || ''
                                            ).toString().trim();

                                        console.log("LanguageSnippet UUID:", versionUUID);

                                        if (versionUUID)
                                            d.apiXVersionUUID = versionUUID;
                                    },

                                    error: function (xhr) {
                                        console.error('GetLanguageSnippets error', xhr);
                                    }
                                },

                                columns: [
                                    {
                                        data: null,
                                        render: (data, type, row, meta) =>
                                            meta.row + (meta.settings._iDisplayStart || 0) + 1,
                                        orderable: false
                                    },
                                    { data: 'uuid', visible: false },
                                    { data: 'languageTitle' },
                                    { data: 'action', orderable: false }
