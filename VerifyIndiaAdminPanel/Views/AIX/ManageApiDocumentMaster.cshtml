                    const attr = ($tr.attr('data-uuid') || '').toString().trim();
                    if (attr) return attr;
                    const colText = ($tr.find('td').eq(1).text() || '').toString().trim();
                    return colText;
                }

                function populateLanguageForm(it) {
                    if (!it) return;
                    $('input[name="LanguageSnippet.UUID"]').val(it.uuid || '');
                    $('input[name="LanguageSnippet.ApiXVersionUUID"]').val(it.apiXVersionUUID || $('input[name="ApixVersionCommand.UUID"]').val() || '');
                    $('#LanguageSnippet_ApiXVersionUUID').val($('input[name="LanguageSnippet.ApiXVersionUUID"]').val());
                    $('select[name="LanguageSnippet.LanguageUUID"]').val(it.languageUUID || '').trigger('change');
                    $('textarea[name="LanguageSnippet.LanguageContent"]').val(it.languageContent || '');
                    $('input[name="LanguageSnippet.IsActive"]').val(it.isActive ? 'true' : 'false');
                    setButtonMode($('#addSnippetBtn'), 'update');
                    $('html, body').animate({ scrollTop: $('#languageSnippetForm').offset().top - 80 }, 220);
                }

                // Ensure row click selects row and stores uuid on floating menu (keeps initMasterTable design intact)
                $(document).off('click.languageSnippetRow').on('click.languageSnippetRow', '#languageSnippetTable tbody tr', function (e) {
                    const $tr = $(this);
                    const uuid = resolveRowUuid($tr);
                    if (!uuid) return;
                    $('#languageSnippetTable tbody tr').removeClass('selected');
                    $tr.addClass('selected');

                    // store on floating menu if present
                    const $menu = $('#rowSnippetMenu');
                    if ($menu.length) $menu.data('uuid', uuid);

                    // preserve normal click behavior for other handlers
                });

                // Inline edit anchor -> always load by row data (bypass initMasterTable default that shows error when no selected row)
                $(document).off('click.languageInlineEdit').on('click.languageInlineEdit', '#languageSnippetTable .edit-snippet', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const $tr = $(this).closest('tr');
                    const uuid = resolveRowUuid($tr);
                    if (!uuid) { alert('Please select a row from the table first.'); return; }

                    const apiXVersionUuid = currentApiXVersionUuid();

                    $.get('@Url.Action("GetLanguageSnippetByUuid", "AIX")', { uuid: uuid, apiXVersionUUID: apiXVersionUuid })
                        .done(function (resp) {
                            if (!resp?.success || !resp.item) {
                                alert(resp?.error || 'Snippet not found');
                                return;
                            }
                            populateLanguageForm(resp.item);
                        })
                        .fail(function (xhr) {
                            console.error('GetLanguageSnippetByUuid failed', xhr.status, xhr.statusText, xhr.responseText);
                            alert('Server error while loading snippet');
                        });
                });

                // Floating-menu Edit action - use stored uuid or resolve from currently selected row
                $(document).off('click.rowSnippetEdit').on('click.rowSnippetEdit', '#editSnippetLink', function (e) {
                    e.preventDefault();
                    e.stopPropagation();

                    const $menu = $('#rowSnippetMenu');
                    let uuid = ($menu.data('uuid') || '').toString().trim();

                    // fallback: selected row in the table
                    if (!uuid) {
                        const $sel = $('#languageSnippetTable tbody tr.selected').first();
                        uuid = resolveRowUuid($sel);
                    }

                    if (!uuid) { alert('Please select a row from the table first.'); return; }

                    const apiXVersionUuid = currentApiXVersionUuid();

                    $.get('@Url.Action("GetLanguageSnippetByUuid", "AIX")', { uuid: uuid, apiXVersionUUID: apiXVersionUuid })
                        .done(function (resp) {
                            if (!resp?.success || !resp.item) {
                                alert(resp?.error || 'Snippet not found');
                                return;
                            }
                            populateLanguageForm(resp.item);
                            $menu.hide();
                        })
                        .fail(function (xhr) {
                            console.error('GetLanguageSnippetByUuid failed', xhr.status, xhr.statusText, xhr.responseText);
                            alert('Server error while loading snippet');
                        });
                });

                // Defensive: ensure clicking outside hides floating menu
                $(document).off('click.hideSnippetMenu keyup.hideSnippetMenu').on('click.hideSnippetMenu keyup.hideSnippetMenu', function (e) {
                    if (e.type === 'keyup' && e.key !== 'Escape') return;
                    const target = $(e.target);
                    if (!target.closest('#rowSnippetMenu').length && !target.closest('#languageSnippetTable').length) {
                        $('#rowSnippetMenu').hide();
                        $('#languageSnippetTable tbody tr').removeClass('selected');
                    }
                });

            })();
        </script>
