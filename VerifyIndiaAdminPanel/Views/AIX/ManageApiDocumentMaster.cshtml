@model UpgrowAdminPanel.Models.Apix.ApiXVersionVM
@using System.Text.Json
@using UpgrowAdminPanel
@using UpgrowAdminPanel.Models
@using VerifyIndia.Application.Common.Dropdowns
@{
    // ViewData["Title"] = "API Document Master";
}

@section Styles {
    <partial name="_ViewStyles" />
    <link href="~/assets/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.css" rel="stylesheet" />

    <style>
        /* Neutralize all visual selection/hover backgrounds for datatable rows */
        table.datatableeditpopup,
        table.datatableeditpopup tbody,
        table.datatableeditpopup tbody tr,
        table.datatableeditpopup tbody tr td,
        table.datatableeditpopup tbody tr th {
            -webkit-tap-highlight-color: transparent !important;
        }

            /* Remove any background, image, color, shadow or outline applied on selected/active/focus/hover */
            table.datatableeditpopup tbody tr.selected,
            table.datatableeditpopup tbody tr.selected td,
            table.datatableeditpopup tbody tr.selected th,
            table.datatableeditpopup tbody tr:active,
            table.datatableeditpopup tbody tr:focus,
            table.datatableeditpopup tbody tr td:active,
            table.datatableeditpopup tbody tr td:focus,
            table.datatableeditpopup tbody tr:hover,
            table.datatableeditpopup tbody tr:hover td,
            table.datatableeditpopup tbody tr[style],
            table.datatableeditpopup tbody tr[style] td,
            table.datatableeditpopup tbody tr td[style] {
                background: transparent !important;
                background-color: transparent !important;
                background-image: none !important;
                color: inherit !important;
                box-shadow: none !important;
                -webkit-box-shadow: none !important;
                outline: none !important;
            }

        /* Also override common Bootstrap/DataTables classes that may be used */
        .table-active,
        .table-primary,
        .table-info,
        .bg-primary,
        .bg-info,
        tr.table-active,
        tr.table-primary,
        tr.table-info {
            background: transparent !important;
            background-color: transparent !important;
            color: inherit !important;
            box-shadow: none !important;
            outline: none !important;
        }

        /* Defensive: neutralize any inline background-* style fragments */
        table.datatableeditpopup tbody tr[style*="background"],
        table.datatableeditpopup tbody tr td[style*="background"] {
            background: transparent !important;
            background-color: transparent !important;
            background-image: none !important;
        }
    </style>
}

<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">API Documentation</h3>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">
                <form id="bannerForm"
                      class="needs-validation"
                      asp-action="ManageApiDocumentMaster"
                      asp-controller="AIX"
                      method="post"
                      novalidate>
                    @Html.AntiForgeryToken()
                    <input asp-for="ApixVersionCommand.UUID" id="ApixVersion_UUID" type="hidden" />
                    <input asp-for="ApixVersionCommand.IsActive" type="hidden" />

                    <div class="row align-items-end">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.ApiCategoryUUID"
                                        label="API Group"
                                        type="Select"
                                        required="true"
                                        asp-items="Model?.ApiGroup">

                            </form-field>
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.ApiXCategoryUUID"
                                        label="API Category"
                                        type="Select"
                                        required="true"
                                        asp-items="Model?.ApiCategory">
                                <option value="">-- Select Category --</option>
                            </form-field>
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.VersionNo"
                                        label="API Version"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.ApiMethod"
                                        label="Api Method"
                                        type="Select"
                                        asp-items="@Model.ApiMethods"
                                        placeholder="-- Api Method --"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.ApiPath"
                                        label="API Path"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.Title"
                                        label="API Title"
                                        type="Text"
                                        required="true" />
                        </div>

                        

                      

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.SequenceNo"
                                        label="Sequence No"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.IsRequestBodyRequired"
                                        label="Is Request Body Required"
                                        type="Checkbox"
                                        required="true" />
                        </div>
                        <div class="col-lg-6 col-md-6 col-sm-6 col-12">
                            <form-field asp-for="ApixVersionCommand.Description"
                                        label="API Description"
                                        type="TextArea"
                                        required="true" />
                        </div>


                        <div class="col-lg-6 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                        
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ManageApiDocumentMasterList", "AIX")" />
                            <form-button label="Submit"
                                         type="Submit" class="btn btn-primary w-100" />
                        </div>
                    </div>
                </form>
            </div>

            <div id="tabsSection" class="@(string.IsNullOrWhiteSpace(Model?.ApixVersionCommand?.UUID) ? "d-none" : "")">
                <ul class="nav nav-pills nav-justified custom-tabs position-relative" role="tablist">
                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link active" data-bs-toggle="tab" href="#ApiHeader" role="tab"
                           aria-selected="true">APIX Header</a>
                    </li>

                    <!-- NEW: Request Schema tab (separate) -->
                    <li id="tabRequestSchemaItem" class="nav-item waves-effect waves-light @(Model?.ApixVersionCommand?.IsRequestBodyRequired != true ? "d-none" : "")" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#RequestSchema" role="tab"
                           aria-selected="false" tabindex="-1">Request Schema</a>
                    </li>

                    <!-- NEW: Request Fields tab (separate) -->
                    <li id="tabRequestFieldsItem" class="nav-item waves-effect waves-light @(Model?.ApixVersionCommand?.IsRequestBodyRequired != true ? "d-none" : "")" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#RequestScehmaFields" role="tab"
                           aria-selected="false" tabindex="-1">Request Fields</a>
                    </li>

                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#SuccessReponseSchema" role="tab"
                           aria-selected="false" tabindex="-1">Success Reponse Schema & Fields</a>
                    </li>
                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#FailureReponseSchema" role="tab"
                           aria-selected="false" tabindex="-1">Failure Reponse Schema & Fields</a>
                    </li>
                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#CodeMapper" role="tab"
                           aria-selected="false" tabindex="-1">Code Mapper</a>
                    </li>

                    <li class="nav-item waves-effect waves-light" role="presentation">
                        <a class="nav-link" data-bs-toggle="tab" href="#LanguageSnippet" role="tab"
                           aria-selected="false" tabindex="-1">Language Snippet</a>
                    </li>
                    <span class="tab-indicator"></span>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane p-3 active show" id="ApiHeader" role="tabpanel">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title fs-20">APIX Header</h3>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <form id="headerForm"
                                  asp-action="AddHeader"
                                  asp-controller="AIX"
                                  method="post"
                                  class="needs-validation"
                                  novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="Header_ApiXVersionUUID" asp-for="Header.ApiXVersionUUID" />
                                <input type="hidden" asp-for="Header.UUID" id="Header_UUID" value="" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Header.FieldName" label="Field Name" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Header.DataType" label="Data Type" type="Select" asp-items="Model.DataTypes" required="true">

                                        </form-field>
                                    </div>

                                    

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <div class="form-check mt-4">
                                            <form-field asp-for="Header.IsRequired" label="Is Required" type="Checkbox" />
                                        </div>
                                    </div>
                                    <div class="col-lg-6 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Header.FieldDetails" label="Details" type="TextArea" required="true" />
                                    </div>

                                    <div class="col-lg-6 col-md-12 col-sm-12 col-12 text-end pt-4">
                                        <button type="reset" class="btn btn-secondary btn-round">Cancel</button>
                                        <button type="submit" id="addHeaderBtn" class="btn btn-primary btn-round">Add</button>
                                      
                                    </div>
                                </div>
                            </form>

                            <div class="table-responsive pt-2">
                                <table class="table datatable-common table-bordered table-hover datatableeditpopup" id="headersTable">
                                    <thead class="thead-light">
                                        <tr>
                                            <th>Sr.</th>
                                            <th style="display:none;">UUID</th>
                                            <th>Field Name</th>
                                            <th>Data Type</th>
                                            <th>Details</th>
                                            <th>Is Required</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    <div id="rowActionMenu" class="row-action-menu">
                        <ul>
                            <action-link id="editHeaderLink" label="Edit APIX Header Details" type="Edit"></action-link>
                            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
                        </ul>
                    </div>

                    <!-- NEW: Separate Request Schema tab-pane -->
                    <div class="tab-pane p-3 @(Model?.ApixVersionCommand?.IsRequestBodyRequired != true ? "d-none" : "")" id="RequestSchema" role="tabpanel">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title fs-20">Request Schema</h3>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <form id="requestSchemaForm" asp-action="SaveRequestSchema" asp-controller="AIX" method="post" class="needs-validation" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="RequestSchema_UUID" name="RequestSchema.UUID" value="@Model.RequestSchema.UUID" />

                                <input type="hidden" id="RequestSchema_ApiXVersionUUID" name="RequestSchema.ApiXVersionUUID" value="@Model.RequestSchema.ApiXVersionUUID" />
                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="RequestSchema.RequestType" id="RequestSchema_RequestType" label="Request Type" type="Select" asp-items="@Model.RequestType" required="true" />
                                    </div>
                                    <div class="col-lg-6 col-md-8 col-sm-12 col-12">
                                        <form-field asp-for="RequestSchema.RequestJson" id="RequestSchema_RequestJson" label="Request Json" type="TextArea" required="true" />
                                    </div>
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12 text-end">
                                        <button type="reset" class="btn btn-round btn-secondary ms-2" id="resetRequestSchemaForm">Cancel</button>
                                        <button id="saveRequestSchemaBtn"
                                                type="button"
                                                class="btn btn-primary btn-round">
                                            @(string.IsNullOrWhiteSpace(Model?.RequestSchema?.UUID) ? "Add" : "Update")
                                        </button>

                                    </div>
                                </div>

                                
                              
                            </form>
                        </div>
                        <!-- Replace the Save button markup inside the Request Schema tab with this server-side-aware text so the button
                        initially shows "Add" when no schema exists and "Update" when a schema is present. -->

                        
                    </div>

                    <!-- Request Fields tab-pane (moved field form + table here) -->
                    <div class="tab-pane p-3 @(Model?.ApixVersionCommand?.IsRequestBodyRequired != true ? "d-none" : "")" id="RequestScehmaFields" role="tabpanel">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title fs-20">Request Fields</h3>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <form id="fieldForm" asp-action="AddRequestSchemaField" asp-controller="AIX" method="post" class="needs-validation mt-3" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="Field_UUID" name="Field.UUID" value="" />
                                <input type="hidden" id="Field_ApiXVersionUUID" name="Field.ApiXVersionUUID" value="@Model.ApixVersionCommand.UUID" />
                                <input type="hidden" id="Field_SchemaUUID" name="Field.SchemaUUID" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.FieldName" label="Name" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.DataType" label="Data Type" type="Select" asp-items="Model.DataTypes" id="Field_DataType" required="true" />


                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                        <form-field asp-for="Field.DisplayOrder" label="Display Order" type="Text" value="0" />
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                                        <form-field asp-for="Field.Examlpe" label="Examples" type="Text" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.ParentUUID" id="Field_Parent" label="Parent" type="Select" asp-items="@Model.ApiMethods" />

                                    </div>


                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.Constraints" label="Constraint" type="Text" />
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                        <div class="form-check mt-3">
                                            <form-field asp-for="Field.AllowNull" label="Allow Null" type="Checkbox" />
                                        </div>
                                    </div>



                                    <div class="col-lg-3 text-end">
                                        <button type="reset" class="btn btn-secondary btn-round ms-2" id="resetFieldForm">Cancel</button>
                                        <button id="addFieldBtn" type="button" class="btn btn-primary btn-round">Add</button>
                                        
                                    </div>
                                </div>
                            </form>


                            <!-- Request fields table -->
                            <div class="table-responsive pt-2">
                                <table class="table datatable-common table-bordered table-hover datatableeditpopup" id="requestFieldsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sr.</th>
                                            <th style="display:none;">UUID</th>
                                            <th>Name</th>
                                            <th>Data Type</th>
                                            <th>Examples</th>
                                            <th>Display Order</th>
                                            <th>Allow Null</th>
                                            <th>Is Array</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div id="rowRequestMenu" class="row-action-menu">
                        <ul>
                            <action-link id="editRequestLink" label="Edit APIX Request Details" type="Edit"></action-link>
                            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
                        </ul>
                    </div>
                    <!-- Success Reponse Schema & Fields -->
                    <!-- Success Reponse Schema & Fields -->
                    <div class="tab-pane p-3" id="SuccessReponseSchema" role="tabpanel">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title fs-20">Success Response Schema & Fields</h3>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <!-- Schema form (saved to ResponseSchema) -->
                            <form id="responseSchemaForm" asp-action="SaveResponseSchema" asp-controller="AIX" method="post" class="needs-validation" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="ResponseSchema_UUID" name="ResponseSchema.UUID" value="" />

                                <input type="hidden" id="ResponseSchema_ApiXVersionUUID" asp-for="ResponseSchema.ApiXVersionUUID" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="ResponseSchema.SchemaType" id="ResponseSchema.SchemaType" label="Schema Type" type="Select" asp-items="@Model.RequestType" required="true" />
                                    </div>
                                    <div class="col-lg-6 col-md-8 col-sm-12 col-12">
                                        <form-field asp-for="ResponseSchema.ShortDescription" id="ResponseSchema.ShortDescription" label="Short Description" type="TextArea" required="true" />
                                    </div>

                                    <!-- mark as success schema -->
                                    <input type="hidden" name="ResponseSchema.IsSchemaForSuccess" value="true" />


                                </div>
                            </form>

                            <!-- Field form (posts to existing AddRequestSchemaField endpoint so fields are saved to ReqResSchemaFields) -->
                            <form id="responseFieldForm" asp-action="AddRequestSchemaField" asp-controller="AIX" method="post" class="needs-validation mt-3" novalidate>
                                @Html.AntiForgeryToken()
                                <!-- NOTE: name attributes are the same as Request "Field.*" so they bind to the existing AddRequestSchemaField action -->
                                <input type="hidden" id="Response_Field_UUID" name="Field.UUID" value="" />
                                <input type="hidden" id="Response_Field_ApiXVersionUUID" name="Field.ApiXVersionUUID" value="@Model.ApixVersionCommand.UUID" />
                                <input type="hidden" id="Response_Field_SchemaUUID" name="Field.SchemaUUID" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.FieldName" label="Name" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.DataType" label="Data Type" type="Select" asp-items="Model.DataTypes" required="true">

                                        </form-field>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                        <form-field asp-for="Field.DisplayOrder" label="Display Order" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                                        <form-field asp-for="Field.Examlpe" label="Examples" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.ParentUUID" label="Parent" type="Select" asp-items="@Model.ApiMethods" />
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                        <div class="form-check mt-3">
                                            <form-field asp-for="Field.AllowNull" label="Allow Null" type="Checkbox" />
                                        </div>
                                    </div>

                                    <div class="col-lg-6 text-end mt-3">
                                        <button type="reset" class="btn btn-round btn-secondary ms-2" id="resetResponseFieldForm">Cancel</button>
                                        <button id="addResFieldBtn" type="submit" class="btn btn-primary btn-round">Add </button>
                                       
                                    </div>
                                </div>
                            </form>


                            <div class="table-responsive pt-2">
                                <table class="table datatable-common table-bordered table-hover datatableeditpopup" id="responseFieldsTable">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Sr.</th>
                                            <th style="display:none;">UUID</th>
                                            <th>Name</th>
                                            <th>Data Type</th>
                                            <th>Examples</th>
                                            <th>Display Order</th>
                                            <th>Allow Null</th>
                                            <th>Is Array</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Populated client-side by DataTables -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- FAILURE Response Schema & Fields (insert this block under the Success tab block) -->
                    <div class="tab-pane p-3" id="FailureReponseSchema" role="tabpanel">
                        <div class="card-header">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h3 class="card-title fs-20">Failure Response Schema & Fields</h3>
                                </div>
                            </div>
                        </div>

                        <div class="card-body p-0">
                            <!-- Schema form (posts same ResponseSchema command but sets IsSchemaForSuccess=false) -->
                            <form id="failureSchemaForm" asp-action="SaveResponseSchema" asp-controller="AIX" method="post" class="needs-validation" novalidate>
                                @Html.AntiForgeryToken()
                                <input type="hidden" id="FailureSchema_UUID" name="ResponseSchema.UUID" value="" />
                                <input type="hidden" id="FailureSchema_ApiXVersionUUID" name="ResponseSchema.ApiXVersionUUID" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="ResponseSchema.SchemaType" label="Schema Type" type="Select" asp-items="@Model.RequestType" required="true" />
                                    </div>

                                    <div class="col-lg-6 col-md-8 col-sm-12 col-12">
                                        <form-field asp-for="ResponseSchema.ShortDescription" label="Short Description" type="TextArea" required="true" />
                                    </div>

                                    <!-- mark as failure schema -->
                                    <input type="hidden" name="ResponseSchema.IsSchemaForSuccess" value="false" />

                                </div>
                            </form>

                            <!-- Field form (posts to AddRequestSchemaField like success tab) -->
                            <form id="failureFieldForm" asp-action="AddRequestSchemaField" asp-controller="AIX" method="post" class="needs-validation mt-3" novalidate>
                                @Html.AntiForgeryToken()

                                <input type="hidden" id="Failure_Field_ApiXVersionUUID" name="Field.ApiXVersionUUID" value="@Model.ApixVersionCommand.UUID" />
                                <input type="hidden" id="Failure_Field_SchemaUUID" name="Field.SchemaUUID" />
                                <input type="hidden" id="Failure_Field_UUID" name="Field.UUID" value="" />

                                <div class="row align-items-end">
                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.FieldName" label="Name" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.DataType" label="Data Type" type="Select" asp-items="Model.DataTypes" required="true">

                                        </form-field>
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                                        <form-field asp-for="Field.DisplayOrder" label="Display Order" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                                        <form-field asp-for="Field.Examlpe" label="Examples" type="Text" required="true" />
                                    </div>

                                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                        <form-field asp-for="Field.ParentUUID" label="Parent" type="Select" asp-items="@Model.ApiMethods" />
                                    </div>

                                    <div class="col-lg-3 col-md-3 col-sm-6 col-12">
