        <script>
            // Extract friendly message from XHR / JSON / text
            function extractAjaxErrorMessage(xhr, fallback) {
                try {
                    if (!xhr) return fallback || 'Server error';
                    // jQuery normalized error object may have responseJSON
                    if (xhr.responseJSON) {
                        // prefer error or message properties
                        if (xhr.responseJSON.error) return xhr.responseJSON.error;
                        if (xhr.responseJSON.message) return xhr.responseJSON.message;
                        // some endpoints return { success:false, errors: {...} }
                        if (xhr.responseJSON.errors) {
                            // join first messages
                            const keys = Object.keys(xhr.responseJSON.errors || {});
                            if (keys.length) {
                                const k = keys[0];
                                const val = xhr.responseJSON.errors[k];
                                if (Array.isArray(val)) return val[0];
                                return val;
                            }
                        }
                    }

                    // if responseText is JSON, try parse
                    if (xhr.responseText) {
                        try {
                            const parsed = JSON.parse(xhr.responseText);
                            if (parsed) {
                                if (parsed.error) return parsed.error;
                                if (parsed.message) return parsed.message;
                                if (parsed.errors) {
                                    const keys = Object.keys(parsed.errors || {});
                                    if (keys.length) {
                                        const k = keys[0];
                                        const val = parsed.errors[k];
                                        if (Array.isArray(val)) return val[0];
                                        return val;
                                    }
                                }
                            }
                        } catch (e) {
                            // not JSON — fall through
                        }
                        // fallback to plain text trimmed
                        const txt = (xhr.responseText || '').toString().trim();
                        if (txt) return txt.length > 200 ? txt.substring(0, 200) + '...' : txt;
                    }

                    // statusText fallback
                    if (xhr.statusText && xhr.statusText.toLowerCase() !== 'error') return xhr.statusText;
                } catch (e) {
                    // ignore parsing errors
                }
                return fallback || 'Server error';
            }

            // Small convenience wrapper to show server error as toast
            function showServerError(xhr, fallback) {
                const msg = extractAjaxErrorMessage(xhr, fallback || 'Something went wrong');
                try { showError(msg); } catch (e) { alert(msg); }
            }
        </script>
