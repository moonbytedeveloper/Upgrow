        <script>
            (function () {
                // Ensure tokenHeader and helpers already exist on page
                $(function () {
                    $('#saveRequestSchemaBtn').off('click.saveReq').on('click.saveReq', function (e) {
                        e.preventDefault();
                        const $btn = $(this);
                        const $form = $('#requestSchemaForm');

                        if (!$form.length) { alert('Form not found'); return; }

                        // Ensure ApiXVersionUUID is present on both name/id inputs
                        const ver = currentApiXVersionUuid();
                        $form.find('input[name="RequestSchema.ApiXVersionUUID"]').val(ver);
                        $('#RequestSchema_ApiXVersionUUID').val(ver);

                        // If CKEditor is used, sync its data into textarea
                        try {
                            const ta = $form.find('textarea[name="RequestSchema.RequestJson"]');
                            const taId = ta.attr('id');
                            if (taId && window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances[taId]) {
                                ta.val(CKEDITOR.instances[taId].getData());
                            }
                        } catch (ex) { console.warn('CKEditor sync failed', ex); }

                        // simple client-side required check
                        const reqType = $form.find('[name="RequestSchema.RequestType"]').val() || '';
                        if (!reqType.toString().trim()) {
                            alert('Request Type is required.');
                            return;
                        }

                        $.ajax({
                            url: $form.attr('action') || '@Url.Action("SaveRequestSchema", "AIX")',
                            type: 'POST',
                            data: $form.serialize(),
                            headers: tokenHeader
                        })
                        .done(function (resp) {
                            if (!resp?.success) {
                                // server validation errors object { "RequestSchema.RequestType": ["..."] }
                                if (resp?.errors && typeof resp.errors === 'object') {
                                    Object.keys(resp.errors).forEach(function (k) {
                                        const msg = Array.isArray(resp.errors[k]) ? resp.errors[k][0] : resp.errors[k];
                                        const $field = $form.find('[name="' + k + '"]');
                                        if ($field.length) {
                                            const $wrap = $field.closest('.inputGroup, .formgroup, .form-group') || $field.parent();
                                            $wrap.append('<div class="field-validation-error" style="color:#b71c1c;margin-top:4px;">' + msg + '</div>');
                                        }
                                    });
                                    return;
                                }
                                alert(resp?.error || 'Unable to save request schema');
                                return;
                            }

                            // success: set hidden UUID, switch button to Update, refresh parents
                            const newUuid = (resp.schemaUuid || resp?.item?.uuid || '').toString();
                            if (newUuid) {
                                $('#RequestSchema_UUID').val(newUuid).trigger('change');
                                $form.find('input[name$=".UUID"]').val(newUuid);
                            }

                            setButtonMode($btn, 'update');

                            try { showSuccess(resp?.message || 'Request schema saved'); } catch (ignore) {}

                            // refresh parent selects (so request-fields parent dropdowns update)
                            try { refreshParentSelectsFor('request'); } catch (ignore) {}
                        })
                                    .fail(function (xhr) {
                showServerError(xhr, 'Server error while saving schema');
            });
                    });

                    // Reset/Cancel: clear UUID and button mode
                    $('#resetRequestSchemaForm').off('click.resetReq').on('click.resetReq', function () {
                        $('#RequestSchema_UUID').val('').trigger('change');
                        $('#requestSchemaForm')[0]?.reset?.();
                        setButtonMode($('#saveRequestSchemaBtn'), 'add');
                    });

                    // Keep initial button text in sync with server-rendered model
                    try {
                        const initialUuid = ($('#RequestSchema_UUID').val() || '').toString().trim();
                        setButtonMode($('#saveRequestSchemaBtn'), initialUuid ? 'update' : 'add');
                    } catch (ex) { /* ignore */ }
                });
            })();
        </script>
        <script>
            (function () {
                // Keep a snapshot of the request-schema form so Cancel restores previous state
                const $reqForm = $('#requestSchemaForm');
                const $saveBtn = $('#saveRequestSchemaBtn');

                function snapshotForm() {
                    if (!$reqForm.length) return '';
                    const s = $reqForm.serialize();
                    $reqForm.data('originalState', s);
                    return s;
                }

                function setOriginalMode(mode) {
                    $reqForm.data('originalMode', mode === 'update' ? 'update' : 'add');
                    snapshotForm();
                }

                function restoreFormFromSerialized($form, serialized) {
                    try {
                        const params = new URLSearchParams(serialized);
                        // reset first then apply values
                        $form[0].reset();

                        for (const [name, val] of params.entries()) {
                            // prefer name selector (dot names), fallback to id (dots -> underscores)
                            const $el = $form.find('[name="' + name + '"]');
                            if ($el.length) {
                                if ($el.is(':checkbox')) {
                                    $el.prop('checked', val === 'true' || val === 'on' || val === '1');
                                    $el.trigger('change');
                                } else {
                                    $el.val(val);
                                    $el.trigger('change');
                                }
                                continue;
                            }

                            const id = name.replace(/\./g, '_');
                            const $byId = $('#' + id);
                            if ($byId.length) {
                                $byId.val(val);
                                $byId.trigger('change');
                            }
                        }

                        // sync CKEditor if present
                        try {
                            const $ta = $form.find('textarea[name="RequestSchema.RequestJson"]');
                            const taId = $ta.attr('id');
                            if (taId && window.CKEDITOR && CKEDITOR.instances && CKEDITOR.instances[taId]) {
                                // setData from the textarea's value (serialized contained it)
                                CKEDITOR.instances[taId].setData($ta.val() || '');
                            }
                        } catch (ex) { console.warn('CKEditor restore failed', ex); }
                    } catch (ex) {
                        console.warn('restoreFormFromSerialized failed', ex);
                        $form[0].reset();
                    }
                }

                $(function () {
                    if (!$reqForm.length) return;

                    // initialize original mode & snapshot from server-rendered value
                    const initialMode = ($('#RequestSchema_UUID').val() || '').toString().trim() ? 'update' : 'add';
                    setOriginalMode(initialMode);
                    setButtonMode($saveBtn, initialMode);

                    // When edit actions populate the form (multiple places in page JS),
                    // snapshot state after population. We hook existing edit triggers.
                    $(document).on('click', '.edit-schema, #editSchemaLink', function () {
                        // Allow other handlers to populate fields, then snapshot
                        setTimeout(function () {
                            setOriginalMode('update');
                            setButtonMode($saveBtn, 'update');
                        }, 60);
                    });

                    // Also catch the path where a field's schema is fetched and used to populate the request form.
                    // That code runs elsewhere, but it sets inputs synchronously — snapshot a little later.
                    $(document).on('apix:reqSchemaPopulated', function () {
                        setTimeout(function () {
                            setOriginalMode('update');
                            setButtonMode($saveBtn, 'update');
                        }, 30);
                    });

                    // Keep snapshot on successful save (other code updates hidden UUID on success)
                    $('#RequestSchema_UUID').on('change', function () {
                        const mode = ($(this).val() || '').toString().trim() ? 'update' : 'add';
                        setOriginalMode(mode);
                        setButtonMode($saveBtn, mode);
                    });

                    // Replace reset/cancel behavior: revert to the saved snapshot (or empty for add)
                    $('#resetRequestSchemaForm').off('click.resetReq').on('click.resetReq', function (e) {
                        e.preventDefault();

                        const originalMode = $reqForm.data('originalMode') || 'add';
                        const originalState = $reqForm.data('originalState') || '';

                        if (originalMode === 'update' && originalState) {
                            restoreFormFromSerialized($reqForm, originalState);
                        } else {
                            // add-mode: clear the form and keep add state
                            $reqForm[0].reset();
                            $reqForm.find('input[name="RequestSchema.UUID"]').val('');
                            // ensure ApiXVersionUUID remains set to current version
                            $reqForm.find('input[name="RequestSchema.ApiXVersionUUID"]').val(currentApiXVersionUuid());
                        }

                        setButtonMode($saveBtn, originalMode);
                    });

                    // Defensive: if some other piece of code programmatically puts the form into edit mode,
                    // call setOriginalMode('update') afterwards (example: inlined handlers that populate the request form).
                    // You can also trigger the custom event `apix:reqSchemaPopulated` after populating to ensure snapshotting.
                });
            })();
        </script>
