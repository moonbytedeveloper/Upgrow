                                    }).done(function (fResp) {
                                        if (!fResp?.success) {
                                            if (fResp?.errors && typeof fResp.errors === 'object') {
                                                applyFieldErrors($form, fResp.errors);
                                                try { $('html, body').animate({ scrollTop: $form.offset().top - 80 }, 200); } catch (e) {}
                                                return;
                                            }
                                            showFormTopError($form, fResp?.error || fResp?.message || 'Unable to save field');
                                            return;
                                        }

                                        // success: reset, reload table, refresh parent selects
                                        try { $form[0].reset(); } catch (ex) {}
                                        try {
                                            if (tableToReload && tableToReload.ajax) tableToReload.ajax.reload(null, false);
                                            else {
                                                const selector = ($form.attr('id') === 'responseFieldForm') ? '#responseFieldsTable'
                                                               : ($form.attr('id') === 'failureFieldForm') ? '#failureFieldsTable' : '#requestFieldsTable';
