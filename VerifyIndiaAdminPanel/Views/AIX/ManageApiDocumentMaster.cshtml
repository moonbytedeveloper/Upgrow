                        (function () {
                            // small helpers reused by CodeMapper style handlers
                            function clearValidation($form) {
                                if (!$form || !$form.length) return;
                                $form.find('.input-error').removeClass('input-error');
                                $form.find('.error-icon').removeClass('show');
                                $form.find('[data-valmsg-for]').each(function () { $(this).text('').removeClass('field-validation-error').hide(); });
                                $form.find('.form-error').remove();
                            }

                            function applyFieldErrors($form, errors) {
                                if (!errors || typeof errors !== 'object') return;
                                Object.keys(errors).forEach(function (key) {
                                    const msg = Array.isArray(errors[key]) ? errors[key][0] : errors[key];
                                    // try exact name match
                                    let $field = $form.find('[name="' + key + '"]');
                                    if (!$field.length) {
                                        const parts = key.split('.');
                                        const short = parts[parts.length - 1];
                                        $field = $form.find('[name$=".' + short + '"]');
                                    }
                                    if ($field.length) {
                                        const $wrapper = $field.closest('.inputGroup, .formgroup, .form-group') || $field.parent();
                                        $wrapper.addClass('input-error');
                                        let $icon = $wrapper.find('.error-icon');
                                        if (!$icon.length) {
                                            $icon = $('<span class="error-icon" title="Validation error">!</span>');
                                            $wrapper.append($icon);
                                        }
                                        $icon.addClass('show');

                                        // try to find data-valmsg-for inside the wrapper or globally
                                        let $msg = $wrapper.find('[data-valmsg-for="' + ($field.attr('name') || '') + '"]');
                                        if (!$msg.length) $msg = $form.find('[data-valmsg-for="' + ($field.attr('name') || '') + '"]');
                                        if ($msg.length) {
                                            $msg.text(msg).addClass('field-validation-error').show();
                                        } else {
                                            // fallback inline text
                                            const $fallback = $('<div class="field-validation-error" style="color:#b71c1c;margin-top:4px;font-size:.875em;"></div>').text(msg);
                                            $wrapper.append($fallback);
                                        }
                                    }
                                });
                            }

                            function showFormTopError($form, message) {
                                if (!$form || !$form.length) return;
                                clearValidation($form);
                                const $err = $('<div class="form-error alert alert-danger" role="alert" style="margin-bottom:12px;"></div>').text(message);
                                $form.prepend($err);
                                try { $('html, body').animate({ scrollTop: $form.offset().top - 80 }, 200); } catch (e) { /* ignore */ }
                            }

                            // Replace existing click handler
                            $('#addFieldBtn, #addResFieldBtn, #addFailFieldBtn').off('click').on('click', function (e) {
                                e.preventDefault();

                                const $btn = $(this);
                                let $form = $('#fieldForm');
                                let tableToReload = requestFieldsTable;
                                let schemaFormSelector = '#requestSchemaForm';
                                let saveSchemaUrl = '@Url.Action("SaveRequestSchema", "AIX")';

                                if ($btn.is('#addResFieldBtn')) {
                                    $form = $('#responseFieldForm');
                                    tableToReload = responseFieldsTable;
                                    schemaFormSelector = '#responseSchemaForm';
                                    saveSchemaUrl = '@Url.Action("SaveResponseSchema", "AIX")';
                                } else if ($btn.is('#addFailFieldBtn')) {
                                    $form = $('#failureFieldForm');
                                    tableToReload = failureFieldsTable;
                                    schemaFormSelector = '#failureSchemaForm';
                                    saveSchemaUrl = '@Url.Action("SaveResponseSchema", "AIX")';
                                }

                                // clear previous UI errors for both schema form and field form
                                const $schemaForm = $(schemaFormSelector);
                                clearValidation($schemaForm);
                                clearValidation($form);

                                // client-side required checks (fast feedback)
                                const $name = $form.find('input[name="Field.FieldName"]');
                                const $dtype = $form.find('select[name="Field.DataType"]');
                                let clientHasError = false;
                                if (!$name.length || !$name.val() || $name.val().toString().trim() === '') {
                                    applyFieldErrors($form, { 'Field.FieldName': 'Field Name is required' });
                                    clientHasError = true;
                                }
                                if (!$dtype.length || !$dtype.val() || $dtype.val().toString().trim() === '') {
                                    applyFieldErrors($form, { 'Field.DataType': 'Data Type is required' });
                                    clientHasError = true;
                                }
                                if (clientHasError) { try { $('html, body').animate({ scrollTop: $form.offset().top - 80 }, 200); } catch (e) {} return; }

                                // ensure ApiXVersionUUID and schema form version input set
                                $schemaForm.find('input[name$=".ApiXVersionUUID"]').val(currentApiXVersionUuid());

                                // Save schema first (server may perform validation on schema fields)
                                $.ajax({
                                    url: saveSchemaUrl,
                                    type: 'POST',
                                    data: $schemaForm.serialize(),
                                    headers: tokenHeader
                                })
                                .done(function (resp) {
                                    if (!resp?.success) {
                                        // server-side field errors for schema (object)
                                        if (resp?.errors && typeof resp.errors === 'object') {
                                            applyFieldErrors($schemaForm, resp.errors);
                                            try { $('html, body').animate({ scrollTop: $schemaForm.offset().top - 80 }, 200); } catch (e) {}
                                            return;
                                        }
                                        // generic error -> top-of-form error
                                        showFormTopError($schemaForm, resp?.error || resp?.message || 'Unable to save schema');
                                        return;
                                    }

                                    // schema saved OK -> set schema uuid into correct hidden inputs
                                    const newSchemaUuid = (resp.schemaUuid || resp?.item?.uuid || '').toString();
                                    if (!newSchemaUuid) {
                                        showFormTopError($schemaForm, 'Schema saved but server did not return its UUID.');
                                        return;
                                    }

                                    let schemaHiddenId = '#RequestSchema_UUID';
                                    let targetFieldSelector = '#fieldForm input[name="Field.SchemaUUID"]';
                                    if (schemaFormSelector === '#responseSchemaForm') {
                                        schemaHiddenId = '#ResponseSchema_UUID';
                                        targetFieldSelector = '#responseFieldForm input[name="Field.SchemaUUID"]';
                                    } else if (schemaFormSelector === '#failureSchemaForm') {
                                        schemaHiddenId = '#FailureSchema_UUID';
                                        targetFieldSelector = '#failureFieldForm input[name="Field.SchemaUUID"]';
                                    }

                                    $(schemaHiddenId).val(newSchemaUuid);
                                    $schemaForm.find('input[name$=".UUID"]').val(newSchemaUuid);
                                    $(targetFieldSelector).val(newSchemaUuid);
                                    // keep all forms in sync
                                    $('#fieldForm input[name="Field.SchemaUUID"]').val($('#RequestSchema_UUID').val() || '');
                                    $('#responseFieldForm input[name="Field.SchemaUUID"]').val($('#ResponseSchema_UUID').val() || '');
                                    $('#failureFieldForm input[name="Field.SchemaUUID"]').val($('#FailureSchema_UUID').val() || '');

                                    // now post the field
                                    $form.find('input[name="Field.ApiXVersionUUID"]').val(currentApiXVersionUuid());

