@model UpgrowAdminPanel.Models.Support.SupportTicketDetailsVM
@{
    ViewData["Title"] = "View Open Tickets Details";
}
@functions {
    public string TimeAgo(DateTimeOffset? date)
    {
        if (!date.HasValue)
            return "-";

        var now = DateTimeOffset.Now;
        var time = now - date.Value;

        if (time.TotalMinutes < 1)
            return "Just now";

        if (time.TotalMinutes < 60)
            return $"{(int)time.TotalMinutes} minutes ago";

        if (time.TotalHours < 24)
            return $"{(int)time.TotalHours} hours ago";

        if (time.TotalDays < 7)
            return $"{(int)time.TotalDays} days ago";

        return date.Value.ToString("dd MMM yyyy, hh:mm tt");
    }
}
<div class="container-fluid">

    <div class="row mt-2">

        <!-- ================= LEFT SIDE ================= -->
        <div class="col-lg-9">

            <!-- ================= TICKET CARD ================= -->
            <div class="card mb-3">

                <div class="card-header">
                    <h5>@Model.TicketNumber - @Model.Subject</h5>
                </div>

                <div class="card-body pt-0">

                    <!-- ================= REPLY FORM (QVAULT STYLE + BLOG FORM-FIELD) ================= -->
                    <div class="rounded text-end">

                        <form Id="bannerForm" asp-action="PostReply" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()

                            <input type="hidden" asp-for="TicketUUID" />

                            <div class="row">

                                <!-- MESSAGE -->
                                <div class="col-lg-12">
                                    <form-field asp-for="ReplyMessage"
                                                type="TextArea"
                                                label="Enter your message"
                                                required="true">
                                    </form-field>
                                </div>

                                <!-- ATTACHMENTS -->
                                <div class="col-lg-3">
                                    <form-field asp-for="Files"
                                                type="File"
                                                label="Attachments"
                                                multiple="true">
                                    </form-field>
                                </div>

                                <!-- BUTTON -->
                                <div class="col-lg-9 pt-4 text-end">
                                    <form-button label="Post Reply"
                                                 type="Submit" />
                                </div>

                            </div>

                        </form>

                    </div>

                    <!-- ================= TABS ================= -->
                    <div class="card-body p-0" style="margin: 1.5em 0 0 0;">

                        <ul class="nav nav-pills nav-justified custom-tabs position-relative"
                            role="tablist">
                            <li class="nav-item waves-effect waves-light" role="presentation">
                                <a class="nav-link active" data-bs-toggle="tab" href="#All" role="tab"
                                   aria-selected="true">All</a>
                            </li>
                            <li class="nav-item waves-effect waves-light" role="presentation">
                                <a class="nav-link" data-bs-toggle="tab" href="#Attachments" role="tab"
                                   aria-selected="false" tabindex="-1">Attachments</a>
                            </li>
                            <span class="tab-indicator"></span>
                        </ul>

                        <div class="tab-content">

                            <!-- ================= ALL MESSAGES ================= -->
                            <div class="tab-pane p-3 active show"
                                 id="All"
                                 role="tabpanel">

                                @foreach (var msg in Model.Messages)
                                {
                                    var boxClass = msg.UserType == "Customer" || msg.UserType == "WhiteLabel"
                                    ? "client-box"
                                    : "supportbox";

                                    var firstLetter = msg.UserName?.Substring(0, 1).ToUpper() ?? "?";

                                    <div class="d-flex mb-4 align-items-start">

                                        <!-- Avatar -->

                                        <div class="avatar-circle me-3">
                                            @firstLetter
                                        </div>

                                        <!-- Content -->

                                        <div class="flex-grow-1">

                                            <!-- Header -->

                                            <div class="d-flex justify-content-between align-items-center mb-2">

                                                <strong class="fs-13">
                                                    @msg.UserName
                                                </strong>

                                                <small class="text-muted fs-11">
                                                    @TimeAgo(msg.CreatedAt)
                                                </small>

                                            </div>

                                            <!-- Message -->

                                            <div class="conversation-box @boxClass">

                                                <p class="mb-2">
                                                    @msg.Message
                                                </p>

                                                @if (msg.UrlWithDomain?.Any() == true)
                                                {
                                                    foreach (var file in msg.UrlWithDomain)
                                                    {
                                                        <div class="attachment-box">

                                                            <i class="mdi mdi-paperclip me-1"></i>

                                                            <a href="@file" target="_blank">
                                                                @System.IO.Path.GetFileName(file)
                                                            </a>

                                                        </div>
                                                    }
                                                }

                                            </div>

                                        </div>

                                    </div>
                                }

                            </div>

                            <!-- ================= ATTACHMENTS TAB ================= -->
                            <div class="tab-pane p-3" id="Attachments" role="tabpanel">

                                @foreach (var msg in Model.Messages)
                                {
                                    if (msg.UrlWithDomain?.Any() == true)
                                    {
                                        foreach (var file in msg.UrlWithDomain)
                                        {
                                            <div class="d-flex mb-4 align-items-start">

                                                <div class="avatar-circle me-3">
                                                    @msg.UserName.Substring(0, 1).ToUpper()
                                                </div>

                                                <div class="flex-grow-1">

                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <strong class="fs-13">@msg.UserName</strong>
                                                        <small class="text-muted fs-11">
                                                            @TimeAgo(msg.CreatedAt)
                                                        </small>
                                                    </div>

                                                    <div class="conversation-box">
                                                                    <i class="mdi mdi-paperclip me-1"></i>
                                                                    <a href="@file" target="_blank">
                                                                        @System.IO.Path.GetFileName(file)
                                                                    </a>
                                                    </div>

                                                </div>
                                            </div>
                                        }
                                    }
                                }

                            </div>

                        </div>

                    </div>

                </div>
            </div>

        </div>

        <!-- ================= RIGHT SIDE ================= -->
        <div class="col-lg-3">

            <!-- ================= TICKET DETAILS ================= -->
            <div class="card" style="padding: 0px 15px 5px;">

                <div class="card-header d-flex collapse-header"
                     data-bs-toggle="collapse"
                     data-bs-target="#ticketDetailsCollapse" aria-expanded="true">

                    <h3 class="card-title fs-16 mt-2">Ticket Details</h3>
                    <div class="toggleswitch mt-2">
                        <i class="mdi mdi-chevron-up fs-20"></i>
                    </div>
                </div>

                <div class="collapse" id="ticketDetailsCollapse">

                    <ul class="list-unsyled m-0 ps-0 transaction-history ticketdetails">

                        <li class="align-items-center d-flex justify-content-between">
                            <div class="media">

                                <div class="media-body align-self-center">
                                    <div class="transaction-data">
                                        <h5 class="m-0 fs-12  fw-bold">Status :</h5>

                                    </div>
                                </div>
                            </div>
                            <h5 class="m-0 fs-12">
                                <span class="badge badge-outline-warning">
                                    @Model.Status
                                </span>
                            </h5>

                        </li>

                        <li class="align-items-center d-flex justify-content-between">

                            <div class="media">

                                <div class="media-body align-self-center">
                                    <div class="transaction-data">
                                        <h5 class="m-0 fs-12  fw-bold">Ticket Id :</h5>

                                    </div>
                                </div>
                            </div>

                            <h5 class="m-0 fs-12">
                                @Model.TicketNumber
                            </h5>

                        </li>

                        <li class="align-items-center d-flex justify-content-between">

                            <div class="media">

                                <div class="media-body align-self-center">
                                    <div class="transaction-data">
                                        <h5 class="m-0 fs-12  fw-bold">Created :</h5>

                                    </div>
                                </div>
                            </div>

                            <h5 class="m-0 fs-12">
                                @Model.CreatedAt?.ToString("dd-MM-yyyy hh:mm tt")
                            </h5>

                        </li>

                        <li class="align-items-center d-flex justify-content-between">
                            <div class="media">

                                <div class="media-body align-self-center">
                                    <div class="transaction-data">
                                        <h5 class="m-0 fs-12 fw-bold">Assign To :</h5>

                                    </div>
                                </div>
                            </div>
                            <h5 class="m-0 fs-12">
                                @Model.Assignee
                            </h5>

                        </li>

                    </ul>

                </div>

            </div>

            <!-- ================= CLOSE TICKET ================= -->
            <div class="card mt-3" style="padding: 0px 15px 5px;">

                <div class="card-header d-flex collapse-header"
                     data-bs-toggle="collapse"
                     data-bs-target="#closeticketCollapse" aria-expanded="true">

                    <h3 class="card-title fs-16 mt-2">Close Ticket</h3>

                    <i class="mdi mdi-chevron-up fs-20" id="toggleIcon"></i>

                </div>

                <div class="collapse show" id="closeticketCollapse">
                    <div class="conet mb-2">
                        Enter the 6-digit PIN provided by the customer.
                    </div>
                    <form asp-action="CloseTicket" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="TicketUUID" />
                        <input type="hidden" asp-for="Otp" id="Otp" />

                        <div class="otp-wrapper">
                            @for (int i = 0; i < 6; i++)
                            {
                                <input type="text" maxlength="1" class="otp-box" />
                            }
                        </div>
                        <div class="card-footers" style="padding: 10px 0px;float: inline-end;">
                            <form-button label="Close Ticket"
                                         type="Submit" />
                        </div>
                       
                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {   
        const form = document.querySelector("form[action*='CloseTicket']");

        document.addEventListener("input", function (e) {

            if (!e.target.classList.contains("otp-box")) return;

            let input = e.target;

            input.value = input.value.replace(/[^0-9]/g, '');

            if (input.value.length === 1) {

                let next = input.nextElementSibling;

                while (next && !next.classList.contains("otp-box")) {
                    next = next.nextElementSibling;
                }

                if (next) next.focus();
            }
        });
        document.addEventListener("keydown", function (e) {

            if (!e.target.classList.contains("otp-box")) return;

            if (e.key === "Backspace" && e.target.value === "") {

                let prev = e.target.previousElementSibling;

                while (prev && !prev.classList.contains("otp-box")) {
                    prev = prev.previousElementSibling;
                }

                if (prev) prev.focus();
            }
        });
        if (form) {
            form.addEventListener("submit", function (e) {

                let otp = "";

                document.querySelectorAll(".otp-box").forEach(x => {
                    otp += x.value;
                });

                if (otp.length !== 6) {
                    e.preventDefault();
                    alert("Please enter complete 6-digit OTP");
                    return;
                }

                document.getElementById("Otp").value = otp;
            });
        }

         const indicator = document.querySelector(".tab-indicator");
        function moveIndicator(el) {
        const parent = el.parentElement.parentElement;
        const parentRect = parent.getBoundingClientRect();
        const rect = el.getBoundingClientRect();
               indicator.style.width = rect.width + "px";
               indicator.style.left = (rect.left - parentRect.left) + "px";
        }

        const activeTab = document.querySelector(".custom-tabs .nav-link.active");
        if (activeTab) moveIndicator(activeTab);
        const tabs = document.querySelectorAll(".custom-tabs .nav-link");

        tabs.forEach(tab => {
            tab.addEventListener("shown.bs.tab", function (e) {
                moveIndicator(e.target);
            });
        });

        });
    </script>
}