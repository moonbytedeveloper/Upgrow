@model VerifyIndia.Application.DTO.Auth.AdminPanelLoginDto
@{
    Layout = null;
}

<html lang="en" dir="ltr">

<head>
    
    <meta charset="utf-8" />
    <title>Authenticate India - Login Page</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content name="description" />
    <meta content name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script src="~/assets/js/darktheme.js"></script>

    <!-- App favicon -->
    <partial name="_Favicon" />

    <!-- App css -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.css" rel="stylesheet" />
    <style>
        .Login-Page-Content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .Login-Page-Content-Title {
            color: #ffffff;
            font-size: 40px;
            margin-top: 32px;
            margin-bottom: 20px;
        }

            .Login-Page-Content-Title span {
                color: var(--theme-secondary)
            }

        .right-bg-white {
            border-radius: 15px;
           
        }

        .features-section {
            max-width: 1400px;
            margin: auto;
            padding: 25px 20px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 700px
        }

        .feature-item {
            flex: 1;
            text-align: center;
        }

        .feature-icon {
            font-size: 40px;
            color: #fff;
            margin-bottom: 10px;
        }

        .feature-item h3 {
            font-size: 18px;
            font-weight: 300;
            line-height: 1.35;
            color: #fff;
            margin: 0px;
        }

            .feature-item h3 span {
                color: var(--theme-secondary);
                font-weight: 400;
            }

        .divider {
            width: 1px;
            height: 100px;
            background: var(--theme-secondary);
            opacity: .8;
        }

        .Login-Page-Main-Div{
            padding-top: 10px;
            padding-right: 15px;
        }
        /* Tablet */
        @@media(max - width:992px) {
            .features-section {
                flex-wrap: wrap;
                gap: 50px;
            }

            .divider {
                display: none;
            }

            .feature-item {
                flex: 0 0 45%;
            }
        }

        /* Mobile */
        @@media(max - width:600px) {
            .features-section {
                flex-direction: column;
                padding: 50px 20px;
            }

            .feature-item {
                width: 100%;
            }

            .feature-icon {
                font-size: 45px;
            }

            .feature-item h3 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body id="body" class="auth-page  background-primary">

    <div class="row d-flex justify-content-center overflow-hidden mobile-view Login-Page-Main-Div">
        <div class="col-12">
            <div class="card-body">
                <div class="row">

                    <!-- LEFT SIDE -->
                    <div class="col-lg-8 p-0">
                        <div class="Login-Page-Content">
                            <div class="text-center">
                                <h2 class="Login-Page-Content-Title">India's <span>Trusted</span> Verification Platform</h2>

                                <section class="features-section">

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="fas fa-shield-alt"></i>
                                        </div>

                                        <h3>
                                            <span>Secure</span><br>
                                            Verification
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="fas fa-bolt"></i>
                                        </div>

                                        <h3>
                                            <span>Real-Time</span><br>
                                            Results
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="far fa-id-card"></i>
                                        </div>

                                        <h3>
                                            <span>Fraud</span><br>
                                            Prevention
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="far fa-building
"></i>
                                        </div>

                                        <h3>
                                            <span>Government</span><br>
                                            Grade-Security
                                        </h3>
                                    </div>

                                </section>

                            </div>

                            <div class="text-center">
                                <img src="~/assets/images/newwebsite/LoginPageImage.svg" class="img-fluid" style="width 100%;height: 100%;" />
                            </div>
                        </div>



                    </div>

                    <!-- RIGHT SIDE -->
                    <div class="col-lg-4 p-0">
                        <form Id="bannerForm" asp-action="Login" method="post">
                            @Html.AntiForgeryToken()
                            <div class="bg-white right-bg-white">

                                <div class="login-container">



                                    <div class="login-container__form">

                                        <div class="login-container__form-content">
                                            <header class="text-center">
                                                <div class="login-page-logo justify-content-center mb-3">
                                                    <img src="~/assets/images/newwebsite/AuthenticateIndia-logo-png.png" />
                                                </div>

                                                <h2 class="fw-600 mt-0 mb-0 text-dark" style="color: #020202 !important;">Welcome Back!</h2>
                                            </header>



                                            @if (TempData["Message"] != null)
                                            {
                                                <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show">
                                                    @TempData["Message"]
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                                                </div>
                                            }

                                            <div class="mb-3">
                                                <form-field asp-for="Username"
                                                            label="UserName"
                                                            type="Text"
                                                            required="true" />
                                            </div>

                                            <div class="mb-3">
                                                <form-field asp-for="Password"
                                                            label="Password"
                                                            type="Password"
                                                            required="true" />
                                            </div>

                                            <div class="text-end mb-2">
                                                <a asp-action="ForgotPassword" asp-controller="Auth" class="theme-text-color">
                                                    Forgot password?
                                                </a>
                                            </div>




                                        </div>
                                        <div class="text-center mt-4">
                                            <div class="mt-3 text-center">
                                                <button type="submit" class="btn w-50 btn-secondary btn-round fw-600 fs-15">
                                                    Login
                                                </button>
                                            </div>
                                            <hr />
                                            <p class="fw-500 fs-14 mb-0">
                                                © <span id="currentyear"></span> AuthenticateIndia. All rights reserved.
                                            </p>
                                        </div>
                                    </div>






                                </div>
                            </div>
                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- vendor js -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/feather-icons/feather.min.js"></script>
    <script src="~/assets/js/inputtypecomponent.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
    <script>
        // ==========================================
        // SECURE LOGOUT - PREVENT BACK BUTTON
        // ==========================================

        (function() {
            // Block back button navigation
            window.addEventListener('popstate', function(event) {
                event.preventDefault();
                history.pushState(null, null, window.location.href);
            });

            // Block forward button
            window.addEventListener('hashchange', function(event) {
                event.preventDefault();
            });

            // Replace current history state
            history.replaceState(null, null, window.location.href);

            // Handle page restoration from browser bfcache
            if (window.navigation) {
                window.navigation.addEventListener('navigate', function(event) {
                    if (event.navigationType === 'back-forward') {
                        event.intercept({
                            handler: async () => {
                                window.location.href = window.location.href;
                            }
                        });
                    }
                });
            }

            // Fallback for older browsers
            window.addEventListener('pageshow', function(event) {
                if (event.persisted) {
                    window.location.reload();
                }
            });

            // Disable back button via history length check
            var maxHistory = 0;
            window.addEventListener('load', function() {
                maxHistory = history.length;
            });

            window.addEventListener('popstate', function() {
                if (history.length <= maxHistory) {
                    history.pushState(null, null, window.location.href);
                }
            });
        })();
    </script>
    <script>
        // ==========================================
        // AUTO-HIDE ALERT AFTER 5 SECONDS
        // ==========================================
        setTimeout(function () {
            var alert = document.getElementById('success-alert');
            if (alert) {
                alert.style.display = 'none';
            }
        }, 5000);
    </script>
    <script>
             document.addEventListener("DOMContentLoaded", () => {
            const currentyear = document.getElementById("currentyear");

            if (currentyear) {
                currentyear.textContent = new Date().getFullYear();
            }
        });
    </script>
    <script>
                $(document).on("click", ".password-toggle", function () {

            const input = $(this).siblings("input");

            if (input.attr("type") === "password") {
                input.attr("type", "text");
                $(this).find("i")
                    .removeClass("fa-eye")
                    .addClass("fa-eye-slash");
            }
            else {
                input.attr("type", "password");
                $(this).find("i")
                    .removeClass("fa-eye-slash")
                    .addClass("fa-eye");
            }

        });
    </script>

</body>

</html>