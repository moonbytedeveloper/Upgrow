@model VerifyIndia.Application.DTO.Auth.ResetPasswordDto
@{
    Layout = null;
}
<style>
    #passwordPolicyList li {
        color: #dc3545 !important; 
        transition: all 0.2s ease;
    }

        /* VALID */
        #passwordPolicyList li.valid {
            color: #198754 !important;
            font-weight: 500;
        }

        /* INVALID */
        #passwordPolicyList li.invalid {
            color: #dc3545 !important;
            font-weight: 500;
        }

        /* NEUTRAL (rule not enabled) */
        #passwordPolicyList li.neutral {
            color: #6c757d !important;
            font-style: italic;
        }
</style>
<html lang="en" data-layout="horizontal" data-topbar="dark" data-sidebar-size="lg" data-sidebar="light" data-sidebar-image="none" data-preloader="disable">
<head>
    <meta charset="utf-8" />
    <title>AuthenticateIndia - Reset Password </title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/favicon.png">
    <partial name="_Favicon" />
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.css" rel="stylesheet" />
</head>

<body id="body" class="auth-page"style="background-image: url('assets/images/p-1.png'); background-size: cover; background-position: center center;">
    <div class="auth-page-wrapper pt-5">
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12 text-center text-white-50">
                        <a href="~/Index" class="d-inline-block auth-logo">
                            <img src="~/assets/images/newwebsite/authenticateindiablacklogo.png" alt="Authenticate India" height="80" />
                        </a>
                    </div>
                </div>

                <div class="row justify-content-center">
                    <div class="col-md-8 col-lg-3 col-xl-4">
                        <div class="card mt-4">
                            <div class="card-body p-4">
                                <div class="text-center mt-2">
                                    <h5 class="text-dark">Reset Password</h5>
                                    <p class="text-muted">Enter your new password below.</p>
                                </div>

                                @if (TempData["Message"] != null)
                                {
                                    <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show" role="alert">
                                        <strong>@TempData["Message"]</strong>
                                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                    </div>
                                }
                                <div class="row align-items-center">
                                    <form asp-action="ResetPassword" method="post" id="bannerForm">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" asp-for="Token" />

                                        <div class="mb-3 mt-3">
                                            <form-field asp-for="NewPassword"
                                                        label="New Password"
                                                        type="Password"
                                                        required="true" />
                                        </div>

                                        <div class="mb-3 mt-3">
                                            <form-field asp-for="ConfirmPassword"
                                                        label="Confirm Password"
                                                        type="Password"
                                                        required="true" />
                                        </div>

                                        <div class="mt-4 text-center">
                                            <form-button label="Reset Password"
                                                         type="Submit" />
                                        </div>

                                        <div class="mt-3 text-center">
                                            <a asp-controller="Auth" asp-action="Login" class="text-muted">Back to Login</a>
                                        </div>
                                        <div id="passwordPolicyBox" class="mt-2 small">
                                            @if (Model.PasswordPolicy != null)
                                            {
                                                <ul class="mb-0 ps-3" id="passwordPolicyList">

                                                    <li id="rule-minlength"
                                                        data-rule="minLength">
                                                        Minimum length: @Model.PasswordPolicy.MinLength
                                                    </li>

                                                    @if (Model.PasswordPolicy.UpperCase == true)
                                                    {
                                                        <li id="rule-uppercase" data-rule="uppercase">
                                                            At least one uppercase (A-Z)
                                                        </li>
                                                    }

                                                    @if (Model.PasswordPolicy.LowerCase == true)
                                                    {
                                                        <li id="rule-lowercase" data-rule="lowercase">
                                                            At least one lowercase (a-z)
                                                        </li>
                                                    }

                                                    @if (Model.PasswordPolicy.AllowDigit == true)
                                                    {
                                                        <li id="rule-digit" data-rule="digit">
                                                            At least one number (0-9)
                                                        </li>
                                                    }

                                                    @if (Model.PasswordPolicy.AllowSpecialChar == true)
                                                    {
                                                        <li id="rule-special" data-rule="special">
                                                            At least one special (@Model.PasswordPolicy.SpecialCharacters)
                                                        </li>
                                                    }

                                                </ul>
                                            }
                                        </div>
                                    </form>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_ValidationScriptsPartial" />
<script src="~/assets/js/validationanimation.js"></script>
<script>
    $(document).on('input', '#NewPassword', function () {
        checkPasswordPolicy(this.value || '');
    });

    $(document).ready(function () {
        checkPasswordPolicy($('#NewPassword').val() || '');
    });

    const policy = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        minLength = Model.PasswordPolicy?.MinLength ?? 0,
        upper = Model.PasswordPolicy?.UpperCase == true,
        lower = Model.PasswordPolicy?.LowerCase == true,
        digit = Model.PasswordPolicy?.AllowDigit == true,
        special = Model.PasswordPolicy?.AllowSpecialChar == true,
        specialChars = Model.PasswordPolicy?.SpecialCharacters ?? ""
    }));

    function checkPasswordPolicy(password) {

        // Length rules (always active)
        applyRule("rule-minlength", true, password.length >= policy.minLength);

        // Uppercase
        applyRule(
            "rule-uppercase",
            policy.upper,
            /[A-Z]/.test(password)
        );

        // Lowercase
        applyRule(
            "rule-lowercase",
            policy.lower,
            /[a-z]/.test(password)
        );

        // Digit
        applyRule(
            "rule-digit",
            policy.digit,
            /\d/.test(password)
        );

        // Special character (SAFE regex)
        const specialRegex = new RegExp("[" +
            policy.specialChars.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&') +
        "]");

        applyRule(
            "rule-special",
            policy.special,
            specialRegex.test(password)
        );
    }

    function applyRule(id, isEnabled, isValid) {
        const el = document.getElementById(id);
        if (!el) return;

        el.classList.remove("valid", "invalid", "neutral");

        if (!isEnabled) {
            el.classList.add("neutral");
            return;
        }

        el.classList.add(isValid ? "valid" : "invalid");
    }
</script>
</body>
</html>
