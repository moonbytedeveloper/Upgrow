@model UpgrowAdminPanel.Models.Api.ApiProviderComponentMappingVM
@{
    var isEdit = Model?.ApiComponentMapping != null && !string.IsNullOrEmpty(Model.ApiComponentMapping.UUID);
    ViewData["Title"] = isEdit ? "Edit Api Provider Component Mapping" : "Add Api Provider Component Mapping";
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20"> @ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm"
                      asp-action="AddApiProviderComponentMapping"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden" asp-for="ApiComponentMapping.UUID" />
                    <input type="hidden" asp-for="ApiComponentMapping.IsActive" />

                        <div class="col-lg-9">
                            <div class="row">
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="ApiComponentMapping.ApiUUID"
                                            label="Api Name"
                                                type="Select"
                                                asp-items="@Model.Api"
                                                placeholder="-- Api --"
                                                required="true" />
                                </div>

                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                <form-field asp-for="ApiComponentMapping.ComponentUUID"
                                                label="Component Name"
                                                type="Select"
                                                asp-items="@Model.Component"
                                                placeholder="-- Api Componenet --"
                                                required="true" />
                                </div>
                                
                            </div>
                        </div>
                        <!-- Buttons -->
                        <div class="col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                     url="@Url.Action("ViewApiProviderComponentMapping", "Api")" />

                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/dependent-dropdowns.js"></script>

    <script>
        $(document).ready(function () {
            // Initialize API -> Provider dependent dropdown filtering
            var mappings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ApiProviderMappings ?? new List<UpgrowAdminPanel.Models.Api.ApiProviderMapsItem>()));

            window.DependentDropdowns.initApiProviderDependency(
                '#ApiComponentMapping_ApiUUID',      // API dropdown selector
                '#ApiComponentMapping_ProviderUUID', // Provider dropdown selector
                providerList,                         // All available providers
                mappings,                             // API-to-Provider mappings
                { placeholder: ' ', preserveOnLoad: true }
            );
        });
    </script>
}