@model VerifyIndia.Application.Commands.Master.ApiXCategoryCommand

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.UUID);
    var pageTitle = isEditMode ? "Edit ApiXCategory" : "Add ApiXCategory";
    ViewData["Title"] = pageTitle;
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddApiXCategory" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row align-items-center">

                        <!-- Category Dropdown -->
                        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                            <form-field asp-for="CategoryUUID"
                                        label="Api Category"
                                        type="Select"
                                        required="true"
                                        asp-items="Model?.ApiCategoryList">
                                <option value="">-- Select Api Category --</option>
                            </form-field>
                        </div>

                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Title"
                                        label="Title"
                                        type="Text"                                     
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="SequenceNo"
                                        label="Sequence No"
                                        type="Number"                                      
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Icon"
                                        label="Icon (e.g., fas fa-star)"
                                        type="Text"                                         
                                        required="true" />
                        </div>
                      
                         
                        <div class="col-lg-6 col-md-12 col-sm-12 col-12">
                            <form-field asp-for="Description"
                                        label="Description"
                                        type="TextArea"                                     
                                        required="true" />
                        </div>

                        <div class="col-lg-6 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewApiXCategory", "Api")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>
                    </div>
                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->

<!-- Timer -->
<partial name="_Timer" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
     <script src="~/assets/js/select2.min.js"></script>
}