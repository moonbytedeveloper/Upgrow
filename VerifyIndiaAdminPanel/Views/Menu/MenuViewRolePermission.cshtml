@{
    ViewData["Title"] = "View Role Permission";
}
@section Styles {
    <partial name="_ViewStyles" />
}


        <div class="container-fluid">
            <!-- Page-Title -->

            <div class="row mt-2">


                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                        </div><!--end col-->
                        <div class="col-3 text-align-end">
                            <form-button label="Add Role Permission"
                                         type="Add"
                                 url="@Url.Action("MenuAddRolePermission", "Menu")">
                            </form-button>

                        </div><!--end col-->
                    </div> <!--end row-->
                </div><!--end card-header-->
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Sr.</th>
                                    <th style="display:none;">UUID</th>
                                    <th>Role</th>
                                    <th>Permission</th>
                                    <th data-action-column="true">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>

                    </div>


                </div><!--end card-body-->


            </div><!--end row-->

            <div id="rowActionMenu" class="row-action-menu">
                <ul>
                    <li>
                        <a href="javascript:void(0)" id="editRolePermissionLink">
                            Edit Role Permission Details
                        </a>
                    </li>

                    
                </ul>
            </div>

        </div><!-- container -->
        <!-- Timer -->
        <partial name="_Timer" />





<!-- end page-wrapper -->
@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetMenuRolePermission", "Menu")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'role' },
                { data: 'permission' },

                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editRolePermissionLink',
                    baseUrl: '@Url.Action("MenuEditRolePermission", "Menu")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                }
                
            ]
        });
    </script>

}