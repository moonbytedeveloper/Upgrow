@using VerifyIndiaAdminPanel.Models.Menu
@model MenuRolePermissionVM

@{
    var isEdit = Model?.RolePermission != null && !string.IsNullOrEmpty(Model.RolePermission.UUID);
    ViewData["Title"] = isEdit ? "Edit Role Permission" : "Add Role Permission";
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}


        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="row mt-2">

                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h3 class="card-title fs-20"> @ViewData["Title"]</h3>
                            </div><!--end col-->

                        </div> <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MenuAddRolePermission" method="post">
                            <input type="hidden" asp-for="RolePermission.UUID" />
                            <input type="hidden" asp-for="RolePermission.IsActive" />

                            <div class="row align-items-center">
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="RolePermission.RoleUUID"
                                                label="Select Role"
                                                type="Select"
                                                asp-items="@Model.RoleList"
                                                required="true" />

                                </div>
                                <div class="col-lg-4 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="RolePermission.PermissionUUID"
                                                label="Permission"
                                                type="Select"
                                                asp-items="@Model.PermissionList"
                                                required="true"
                                                placeholder="Select Permission" />
                                </div>


                                <div class="col-lg-12 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                         url="@Url.Action("MenuViewRolePermission", "Menu")" />
                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>

                            </div>
                        </form>
                    </div><!--end card-body-->
                </div><!--end card-->
            </div><!--end row-->
        </div><!-- container -->
        <!-- Timer -->
        <partial name="_Timer" />
    
<!-- end page-wrapper -->
@section Scripts
{

    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>

    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/select-clear.js"></script>
}
