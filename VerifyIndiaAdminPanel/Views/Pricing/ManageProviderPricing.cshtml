@model VerifyIndia.Application.DTO.Pricing.PricingPageVM

@{
    ViewData["Title"] = "Manage Provider Pricing";
}

@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

@section Styles
{
    <link href="~/assets/css/datepicker.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <link href="~/assets/css/ag-grid.css" rel="stylesheet" />
    <link href="~/assets/css/ag-theme-alpine.css" rel="stylesheet" />
   
    <style>
        .group-header-center .ag-header-group-cell-label {
            justify-content: center !important;
        }

        .pricing-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 16px;
            padding: 10px 0 18px 0;
            border-bottom: 1px solid #eef2f7;
        }

        .pricing-title {
            font-weight: 700;
            font-size: 20px;
            color: #0f172a;
            margin: 0;
        }

        .pricing-subtitle {
            font-size: 13px;
            color: #64748b;
            margin-top: 4px;
        }

        .pricing-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: flex-end;
            gap: 12px;
        }

        .action-btn {
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #0f172a;
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 13px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .action-btn.primary {
                background: #2563eb;
                color: #fff;
                border-color: #2563eb;
            }

            .action-btn.outline-primary {
                background: #eef2ff;
                color: #1d4ed8;
                border-color: #c7d2fe;
            }

        .pricing-layout {
            display: grid;
            grid-template-columns: 240px 1fr;
            gap: 16px;
            margin-top: 16px;
            transition: all .25s ease;
        }

            .pricing-layout.filters-hidden {
                grid-template-columns: 0 1fr;
            }

        .pricing-setup {
            margin-top: 16px;
            background: #ffffff;
            border: 1px dashed #e2e8f0;
            border-radius: 16px;
            padding: 24px;
            display: flex;
            justify-content: flex-start;
        }

            .pricing-setup .pricing-actions {
                justify-content: flex-start;
                width: 100%;
            }

        .filter-panel {
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            padding: 14px;
            overflow: hidden;
            transition: all .25s ease;
        }

        .pricing-layout.filters-hidden .filter-panel {
            opacity: 0;
            padding: 0;
            border-width: 0;
            width: 0;
        }

        .filter-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
        }

        .filter-title {
            font-size: 14px;
            font-weight: 700;
            color: #0f172a;
        }

        .filter-clear {
            font-size: 12px;
            color: #2563eb;
            cursor: pointer;
        }

        .filter-search {
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 8px 10px 8px 34px;
            font-size: 12px;
            width: 100%;
        }

        .search-input-group {
            position: relative;
        }

        .search-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 16px;
        }

        .filter-section {
            margin-top: 14px;
        }

        .filter-section-title {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .filter-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #475569;
            margin-bottom: 6px;
        }

        .filter-count {
            margin-left: auto;
            color: #94a3b8;
        }

        .pricing-toolbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 10px;
        }

        .toolbar-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .toolbar-right {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .column-panel-wrapper {
            position: relative;
        }

        .column-panel {
            position: absolute;
            top: 42px;
            right: 0;
            width: 220px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px;
            box-shadow: 0 12px 24px rgba(15, 23, 42, 0.12);
            display: none;
            z-index: 30;
        }

        .column-panel-title {
            font-size: 12px;
            font-weight: 700;
            color: #0f172a;
            margin-bottom: 8px;
        }

        .column-panel-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #475569;
            padding: 4px 0;
        }

        .pricing-section {
            display: none;
        }

        .pricing-grid {
            width: 100%;
            height: 540px;
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid #e2e8f0;
            background: #fff;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            line-height: 1;
        }

        .status-changed {
            background: #e6f0ff;
            color: #1d4ed8;
        }

        .status-unchanged {
            background: #ecfdf3;
            color: #15803d;
        }

        .status-missing {
            background: #fef2f2;
            color: #b91c1c;
        }

        .provider-badge {
            display: inline-flex;
            align-items: center;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 11px;
            font-weight: 600;
            line-height: 1;
        }

        .margin-positive {
            color: #15803d;
            font-weight: 600;
        }

        .margin-negative {
            color: #b91c1c;
            font-weight: 600;
        }

        .pricing-summary {
            margin-top: 14px;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 10px 14px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .summary-left {
            display: flex;
            align-items: center;
            gap: 16px;
            font-size: 12px;
            color: #334155;
        }

        .summary-badge {
            font-weight: 700;
            color: #2563eb;
        }

        .summary-actions {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .draft-status {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 12px;
            color: #64748b;
            margin-right: 6px;
        }

        .ag-price-error {
            border: 2px solid #ef4444 !important;
            border-radius: 6px;
            background: #fff5f5 !important;
        }

        .ag-price-error-icon {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            color: #ef4444;
            font-weight: 700;
        }

        /* .price-cell-wrapper {
            position: relative;
            width: 100%;
            height: 100%;
        } */

        .price-cell-text {
            padding-right: 18px;
        }

        .price-cell-wrapper {
            display: flex;
            align-items: center;
            gap: 8px;
            position: relative;
            width: 100%;
            min-height: 32px;
        }

        .price-value {
            white-space: nowrap;
        }

        .change-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.3;
        }

            .change-badge.positive {
                color: #16a34a;
                background: rgba(22,163,74,.08);
            }

            .change-badge.negative {
                color: #ef4444;
                background: rgba(239,68,68,.08);
            }

            .change-badge.neutral {
                color: #64748b;
                background: rgba(100,116,139,.08);
            }

        .ag-header-group-cell {
            display: grid !important;
            align-items: center;
            height: 100%;
            position: absolute;
        }

        @@media (max-width: 1200px) {
            .pricing-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">
            <div class="card-body pt-0">
                <div class="pricing-header">
                    <div>
                        <h3 class="pricing-title">@ViewData["Title"]</h3>
                        @* <div class="pricing-subtitle">Update and manage API pricing across all providers efficiently</div> *@
                    </div>

                    <div id="pricingHeaderActions" class="pricing-actions"></div>
                </div>

                <div id="pricingSetup" class="pricing-setup">
                    <form id="pricingSetupForm" class="pricing-actions" novalidate="novalidate">
                        <div id="pricingSetupActions" class="pricing-actions">

                            <div style="min-width:180px;">

                                <form-field asp-for="PriceType"
                                            label="Price Type"
                                            type="Select"
                                            Required="true"
                                            asp-items="Model.PriceTypeList">
                                </form-field>
                            </div>

                            <div style="min-width:180px;">
                                <form-field asp-for="ProviderUUID"
                                            label="Provider"
                                            Required="true"
                                            type="Select"
                                            asp-items="Model.ProviderList">
                                </form-field>
                            </div>

                            <div style="min-width:180px;">
                                <form-field asp-for="EffectiveDate"
                                            label="Effective Date"
                                            Required="true"
                                            min-date-today="true"
                                            type="Date">
                                </form-field>
                            </div>

                            <div style="min-width:130px;">
                                <form-button id="btnGetPrice" label="Get Price" />
                            </div>
                        </div>
                    </form>
                </div>

                <div id="pricingSection" class="pricing-section">
                    <div class="pricing-layout">
                        <!-- LEFT FILTERS PANEL -->
                        <div id="pricingFilterPanel" class="filter-panel">
                            <div class="filter-header">
                                <div class="filter-title">Filters</div>
                                <div id="btnClearFilters" class="filter-clear">Clear All</div>
                            </div>

                            <div class="search-input-group">
                                <i class="mdi mdi-magnify search-icon"></i>
                                <input id="filterSearch"
                                       class="filter-search"
                                       placeholder="Search Categories..." />
                            </div>

                            <div class="filter-section">
                                <div class="filter-section-title">Categories</div>
                                <div id="categoryFilters"></div>
                            </div>

                            @*  <div class="filter-section">
                                <div class="filter-section-title">Providers</div>
                                <div id="providerFilters"></div>
                            </div> *@
                        </div>

                        <!-- GRID AREA -->
                        <div>
                            <form id="bannerForm">
                                <div class="pricing-toolbar">
                                    <div class="toolbar-left">

                                        <!-- NEW FILTER BUTTON -->
                                        <button id="btnToggleFilters"
                                                type="button"
                                                class="action-btn">
                                            <i class="mdi mdi-filter-outline"></i>
                                            Filters
                                        </button>

                                        <select id="bulkPriceType"
                                                class="form-control"
                                                style="max-width:180px;">
                                            <option value="newPrice">Bulk Apply (AI)</option>
                                            <option value="newPriceMB">Bulk Apply (MB)</option>
                                            <option value="both">Bulk Apply (MB + AI)</option>
                                        </select>

                                        <input id="bulkPrice"
                                               type="number"
                                               step="0.01"
                                               class="form-control"
                                               style="max-width:160px;"
                                               placeholder="Bulk price" />

                                        <form-button id="btnBulkApply" label="Apply" />
                                    </div>

                                    <div class="toolbar-right">
                                        <div class="column-panel-wrapper">
                                            <button id="btnToggleColumns" class="action-btn outline-primary" type="button">Columns</button>
                                            <div id="columnPanel" class="column-panel">
                                                <div class="column-panel-title">Columns</div>
                                                <div id="columnPanelList"></div>
                                            </div>
                                        </div>

                                        <div class="search-input-group">
                                            <i class="mdi mdi-magnify search-icon"></i>
                                            <input id="pricingSearch"
                                                   type="text"
                                                   class="form-control"
                                                   style="padding-left: 34px;"
                                                   placeholder="Search in table..." />
                                        </div>
                                    </div>
                                </div>

                                <div id="pricingGrid"
                                     class="ag-theme-alpine pricing-grid">
                                </div>
                            </form>
                            <div class="pricing-summary">
                                <div class="summary-left">
                                    <span class="summary-badge" id="selectedCount">0</span> APIs selected
                                    <span class="summary-badge" id="missingCount">0</span> Missing Prices
                                </div>
                                <div class="summary-actions">
                                    <div class="draft-status">
                                        Draft saved: <span class="summary-badge" id="draftSavedAt">Never</span>
                                    </div>
                                    <button id="btnSaveDraft" class="action-btn outline-primary" type="button">Save Draft</button>
                                    <button id="btnCancelPricing" class="action-btn" type="button">Cancel</button>
                                    <form-button id="btnSavePricing" label="Submit" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<partial name="_Timer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/customdate.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/moment.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/notification.js"></script>
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>
    <script src="~/assets/js/ag-grid-community.min.js"></script>

    <script>
        // =====================================
        // SHOW LOADER
        // =====================================

        function showLoader() {

            $("#page-loader")
                .removeClass("fade-out")
                .css("display", "flex");
        }

        // =====================================
        // HIDE LOADER
        // =====================================

        function hideLoader() {

            $("#page-loader")
                .addClass("fade-out");

            setTimeout(function () {

                $("#page-loader")
                    .hide();

            }, 300);
        }

                
    </script>

    <script>
                let pricingGridApi = null;
                let pricingColumnApi = null;
                let selectedCategories = new Set();
                let selectedProviders = new Set();
                let isColumnsPanelOpen = false;
                let autoDraftTimer = null;

                const pricingDraftStorageKey = "pricing.manageProviderPricing.draft";
                const autoDraftIntervalMs = 30000;

                // const providerBadgePalette = [
                //     { bg: "#e0f2fe", text: "#0369a1" },
                //     { bg: "#ede9fe", text: "#6d28d9" },
                //     { bg: "#dcfce7", text: "#15803d" },
                //     { bg: "#ffedd5", text: "#c2410c" },
                //     { bg: "#ffe4e6", text: "#be123c" },
                //     { bg: "#fef9c3", text: "#a16207" }
                // ];

                function normalizePrice(value) {
                    let parsed = parseFloat(value);
                    return Number.isFinite(parsed) ? parsed : null;
                }

                                function getPriceError(row) {

                    return row.priceError || null;
                }

                function currencyFormatter(params) {
                    if (params.value === null || params.value === undefined || params.value === "") {
                        return "";
                    }

                    return `${Number(params.value).toFixed(2)}`;
                }

                function percentFormatter(params) {
                    if (params.value === null || params.value === undefined || params.value === "") {
                        return "";
                    }

                    return `${Number(params.value).toFixed(2)}%`;
                }

                                function getRowStatus(row) {

            let currentAI = normalizePrice(row.currentPrice);
            let newAI = normalizePrice(row.newPrice);

            let currentMB = normalizePrice(row.currentPriceMB);
            let newMB = normalizePrice(row.newPriceMB);

            const aiMissing = !Number.isFinite(newAI);
            const mbMissing = !Number.isFinite(newMB);

            // Missing cases
            if (aiMissing || mbMissing) {

                if (aiMissing && mbMissing)
                    return "Missing (MB + AI)";

                if (mbMissing)
                    return "Missing (MB)";

                return "Missing (AI)";
            }

            const aiChanged =
                !Number.isFinite(currentAI) ||
                Number(currentAI.toFixed(2)) !== Number(newAI.toFixed(2));

            const mbChanged =
                !Number.isFinite(currentMB) ||
                Number(currentMB.toFixed(2)) !== Number(newMB.toFixed(2));

            // Changed cases
            if (aiChanged || mbChanged) {

                if (aiChanged && mbChanged)
                    return "Changed (MB + AI)";

                if (mbChanged)
                    return "Changed (MB)";

                return "Changed (AI)";
            }

            return "Unchanged";
        }

                function marginValueGetter(params) {
                    let currentPrice = normalizePrice(params.data.currentPrice);
                    let newPrice = normalizePrice(params.data.newPrice);

                    if (!Number.isFinite(currentPrice) || currentPrice <= 0 || !Number.isFinite(newPrice)) {
                        return null;
                    }

                    return ((newPrice - currentPrice) / currentPrice) * 100;
                }

                function statusValueGetter(params) {
                    return getRowStatus(params.data);
                }

                        function statusCellRenderer(params) {

            const status = params.value || "";
            let statusClass = "status-unchanged";

            if (status.startsWith("Changed")) {
                statusClass = "status-changed";
            }
            else if (status.startsWith("Missing")) {
                statusClass = "status-missing";
            }

            return `<span class="status-badge ${statusClass}">${status}</span>`;
        }

                // function getProviderBadgeColor(value) {
                //     let hash = 0;
                //     let normalized = (value || "").toString();

                //     for (let i = 0; i < normalized.length; i++) {
                //         hash = ((hash << 5) - hash) + normalized.charCodeAt(i);
                //         hash |= 0;
                //     }

                //     let index = Math.abs(hash) % providerBadgePalette.length;
                //     return providerBadgePalette[index];
                // }

                // function providerBadgeRenderer(params) {
                //     let name = params.value || "";
                //     if (!name) {
                //         return "";
                //     }

                //     let colors = getProviderBadgeColor(name);
                //     return `<span class="provider-badge" style="background:${colors.bg}; color:${colors.text};">${name}</span>`;
                // }

                function getDraftPriceKey(apiUUID, providerUUID) {
                    return `${apiUUID || "none"}::${providerUUID || "none"}`;
                }

                function updateDraftSavedLabel(draft) {
                    if (!draft || !draft.savedAtUtc) {
                        $("#draftSavedAt").text("Never");
                        return;
                    }

                    let date = new Date(draft.savedAtUtc);
                    if (Number.isNaN(date.getTime())) {
                        $("#draftSavedAt").text("Unknown");
                        return;
                    }

                    $("#draftSavedAt").text(date.toLocaleString());
                }

                function getPricingDraft() {
                    let raw = localStorage.getItem(pricingDraftStorageKey);
                    if (!raw) {
                        return null;
                    }

                    try {
                        return JSON.parse(raw);
                    } catch (e) {
                        return null;
                    }
                }

                function savePricingDraft(silent) {
                    if (!pricingGridApi) {
                        if (!silent) {
                            showNotification("Please load pricing before saving draft.", "warning");
                        }
                        return;
                    }

                    let effectiveDate = $("#EffectiveDate").val();
                    let priceType = $("#PriceType").val();

                    if (!effectiveDate || !priceType) {
                        if (!silent) {
                            showNotification("Price type and effective date are required to save draft.", "warning");
                        }
                        return;
                    }

                    let prices = {};

                    pricingGridApi.forEachNode(function (node) {
                        if (!node.data || !node.data.apiUUID) {
                            return;
                        }

                        let price = normalizePrice(node.data.newPrice);
                        if (price !== null) {
                            let key = getDraftPriceKey(node.data.apiUUID, node.data.providerUUID);
                            prices[key]={ai:normalizePrice(node.data.newPrice),mb:normalizePrice(node.data.newPriceMB)};
                        }
                    });

                    let draft = {
                        priceType: priceType,
                        effectiveDate: effectiveDate,
                        prices: prices,
                        savedAtUtc: new Date().toISOString()
                    };

                    localStorage.setItem(pricingDraftStorageKey, JSON.stringify(draft));
                    updateDraftSavedLabel(draft);

                    if (!silent) {
                        showNotification("Draft saved successfully!", "success");
                    }
                }

                function applyDraftToRowData(rowData) {
                    let draft = getPricingDraft();
                    if (!draft) {
                        updateDraftSavedLabel(null);
                        return;
                    }

                    let effectiveDate = $("#EffectiveDate").val();
                    let priceType = $("#PriceType").val();

                    if (!effectiveDate || !priceType) {
                        updateDraftSavedLabel(null);
                        return;
                    }

                    if (draft.priceType !== priceType || draft.effectiveDate !== effectiveDate) {
                        updateDraftSavedLabel(null);
                        return;
                    }

                    rowData.forEach(function (row) {
                        let key = getDraftPriceKey(row.apiUUID, row.providerUUID);
                        if (draft.prices && draft.prices[key] !== undefined) {
                            row.newPrice = normalizePrice(draft.prices[key]?.ai);
                            row.newPriceMB = normalizePrice(draft.prices[key]?.mb);
                        }
                    });

                    updateDraftSavedLabel(draft);
                }

                function startAutoDraftSave() {
                    if (autoDraftTimer) {
                        return;
                    }

                    autoDraftTimer = setInterval(function () {
                        savePricingDraft(true);
                    }, autoDraftIntervalMs);
                }

                function buildColumnPanel() {
                    if (!pricingColumnApi) {
                        return;
                    }

                    let columns = pricingColumnApi.getAllGridColumns() || [];
                    let html = "";

                    columns.forEach(function (column) {
                        let colDef = column.getColDef();
                        let colId = column.getColId();

                        if (colDef.checkboxSelection) {
                            return;
                        }

                        let header = colDef.headerName || colId;
                        let checked = column.isVisible() ? "checked" : "";

                        html += `
                            <div class="column-panel-item">
                                <input type="checkbox"
                                       class="column-toggle"
                                       data-col-id="${colId}"
                                       ${checked} />
                                <span>${header}</span>
                            </div>
                        `;
                    });

                    $("#columnPanelList").html(html);
                }

                function setColumnsPanelState(isOpen) {
                    isColumnsPanelOpen = isOpen;

                    if (isOpen) {
                        buildColumnPanel();
                        $("#columnPanel").show();
                        $("#btnToggleColumns").text("Hide Columns");
                    } else {
                        $("#columnPanel").hide();
                        $("#btnToggleColumns").text("Columns");
                    }
                }

                                        function validateSinglePrice(value) {
            let price = normalizePrice(value);

            return !Number.isFinite(price)
                ? "Price is required."
                : price <= 0
                    ? "Price must be greater than 0."
                    : null;
        }

        function validatePriceRow(
            row,
            forceValidation = false
        ) {
            if (
                !forceValidation &&
                !row.isTouched
            ) {
                row.priceError = null;
                row.priceErrorMB = null;
                return;
            }

            row.priceError =
                validateSinglePrice(row.newPrice);

            row.priceErrorMB =
                validateSinglePrice(row.newPriceMB);
        }


                        function editablePriceColumn(field, headerName) {
            return {
                headerName,
                field,
                width:150,
                editable:true,
                cellEditor:"agNumberCellEditor",
                cellEditorParams:{step:0.01},

                valueParser:function(params){
                    if(params.newValue===""||params.newValue===null)
                        return null;

                    const p=parseFloat(params.newValue);
                    return Number.isFinite(p)?p:null;
                },

                valueFormatter:currencyFormatter,

                tooltipValueGetter:function(params){
                    return field === "newPriceMB"
                        ? params.data.priceErrorMB
                        : params.data.priceError;
                },

                cellClassRules:{
                    "ag-price-error":function(params){
                        return field === "newPriceMB"
                            ? !!params.data.priceErrorMB
                            : !!params.data.priceError;
                    }
                },

                        cellRenderer: function (params) {

            const error =
                field === "newPriceMB"
                    ? params.data.priceErrorMB
                    : params.data.priceError;

            const current =
                field === "newPriceMB"
                    ? normalizePrice(params.data.currentPriceMB)
                    : normalizePrice(params.data.currentPrice);

            const newValue = normalizePrice(params.value);

            let badge = "";

            if (
                Number.isFinite(current) &&
                Number.isFinite(newValue) &&
                current !== 0
            ) {
                const change =
                    ((newValue - current) / current) * 100;

                const cls =
                    change > 0
                        ? "positive"
                        : change < 0
                            ? "negative"
                            : "neutral";

                const sign = change > 0 ? "+" : "";

                badge = `
                    <span class="change-badge ${cls}">
                        (${sign}${change.toFixed(2)}%)
                    </span>
                `;
            }

            return `
                <div class="price-cell-wrapper">
                    <span class="price-value">
                        ${params.value ?? ""}
                    </span>

                    ${badge}

                    ${error
                        ? `<span class="ag-price-error-icon">!</span>`
                        : ""
                    }
                </div>
            `;
        }
            };
        }

        let pricingGridOptions = {
                    columnDefs: [
                        {
                            width: 40,
                            checkboxSelection: true,
                            headerCheckboxSelection: true,
                            sortable: false,
                            filter: false,
                            suppressMenu: true,
                            lockPosition: true,
                            resizable: false
                        },
                        {
                            headerName: "Api Name",
                            field: "apiName",
                            minWidth: 220,
                            flex: 1,
                            sort: "asc",
                            sortIndex: 0
                        },
                        // {
                        //     headerName: "Provider",
                        //     field: "providerName",
                        //     width: 170,
                        //     cellRenderer: providerBadgeRenderer,
                        //     sort: "asc",
                        //     sortIndex: 0
                        // },
                        {
                            headerName: "MB Pricing",
                            marryChildren: true,
                            headerClass: "group-header-center",
                            children: [
                                { headerName: "Current Price", field: "currentPriceMB", width: 150, valueFormatter: currencyFormatter },
                                editablePriceColumn("newPriceMB", "New Price")
                            ]
                        },
                        {
                            headerName: "AI Pricing",
                            marryChildren: true,
                            headerClass: "group-header-center",
                            children: [
                                { headerName: "Current Price", field: "currentPrice", width: 150, valueFormatter: currencyFormatter },
                                editablePriceColumn("newPrice", "New Price")
                            ]
                        },
                        {
                            headerName: "Status",
                            colId: "status",
                            width: 150,
                            valueGetter: statusValueGetter,
                            cellRenderer: statusCellRenderer
                        }
                    ],
                    defaultColDef: {
                        sortable: true,
                        filter: true,
                        resizable: true,
                    },
                    enterNavigatesVertically: true,
                    enterNavigatesVerticallyAfterEdit: true,
                    alwaysMultiSort: true,
                    rowData: [],
                    animateRows: true,
                    pagination: true,
                    paginationPageSize: 20,
                    singleClickEdit: true,
                    stopEditingWhenCellsLoseFocus: true,
                    rowSelection: "multiple",
                    rowMultiSelectWithClick: true,
                    suppressRowClickSelection: true,
                    isExternalFilterPresent: function () {
                        return selectedCategories.size > 0
                            || selectedProviders.size > 0;
                    },
                    doesExternalFilterPass: function (node) {
                        if (selectedCategories.size > 0
                            && !selectedCategories.has(node.data.categoryName)) {
                            return false;
                        }

                        if (selectedProviders.size > 0
                            && !selectedProviders.has(node.data.providerName)) {
                            return false;
                        }

                        return true;
                    },
                    onGridReady: function (params) {
                        pricingGridApi = params.api;
                        pricingColumnApi = params.columnApi;
                        params.api.sizeColumnsToFit();
                        setColumnsPanelState(false);
                    },
                    onColumnVisible: function () {
                        buildColumnPanel();
                    },
                                    onCellValueChanged:
                function (
                    params
                ) {

                    if (
                        params.colDef.field !== "newPrice"
                        && params.colDef.field !== "newPriceMB"
                    ) {
                        return;
                    }

                    params.data.isTouched =
                        true;

                    validatePriceRow(
                        params.data
                    );

                    params.api
                        .refreshCells({

                            rowNodes:
                                [
                                    params.node
                                ],

                            columns:["newPrice","newPriceMB","status"],

                            force:
                                true
                        });

                    updateSummaryCounts();
                },

                    navigateToNextCell: function(params) {
                        if (!params.nextCellPosition) return null;
                        const col = params.previousCellPosition.column.getColId();
                        if (col === "newPrice" || col === "newPriceMB") {
                            return {
                                rowIndex: params.nextCellPosition.rowIndex,
                                rowPinned: null,
                                column: col
                            };
                        }
                        return params.nextCellPosition;
                    },

                    onSelectionChanged: function () {
                        if (!pricingGridApi)
                            return;

                        let selectedCount = pricingGridApi.getSelectedNodes().length;
                        $("#selectedCount").text(selectedCount);
                    }
                };

                function setQuickFilter(value) {
                    if (!pricingGridApi)
                        return;

                    pricingGridApi.setQuickFilter(value);
                }

                function renderFilterList(containerId, items, filterType) {
                    let html = "";

                    items.forEach(function (item, index) {
                        let id = `${filterType}_${index}`;

                        html += `
                            <div class="filter-item" data-filter-label="${item.label.toLowerCase()}">
                                <input type="checkbox"
                                       id="${id}"
                                       class="grid-filter"
                                       data-filter-type="${filterType}"
                                       data-filter-value="${item.value}">
                                <label for="${id}">${item.label}</label>
                                <span class="filter-count">${item.count}</span>
                            </div>
                        `;
                    });

                    $(containerId).html(html);
                }

                function updateFiltersFromUi() {
                    selectedCategories = new Set();
                    selectedProviders = new Set();

                    $(".grid-filter[data-filter-type='category']:checked")
                        .each(function () {
                            selectedCategories.add($(this).data("filter-value"));
                        });

                    $(".grid-filter[data-filter-type='provider']:checked")
                        .each(function () {
                            selectedProviders.add($(this).data("filter-value"));
                        });

                    if (pricingGridApi) {
                        pricingGridApi.onFilterChanged();
                    }
                }

                function updateSummaryCounts() {
                    if (!pricingGridApi)
                        return;

                    let missingCount = 0;

                    pricingGridApi.forEachNodeAfterFilter(function (node) {
                                let price = normalizePrice(node.data.newPrice);
                                if (
                                    !Number.isFinite(price)
                                    ||
                                    price <= 0
                                )
                                {
                                    missingCount++;
                                }
                    });

                    $("#missingCount").text(missingCount);
                    $("#belowCostCount").text(0);
                }

                function applyFilterSearch(value) {
                    let term = (value || "").trim().toLowerCase();

                    $(".filter-item").each(function () {
                        let label = $(this).data("filter-label") || "";

                        if (!term || label.includes(term)) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }

                function resetPricingEdits() {
                    if (!pricingGridApi)
                        return;

                    pricingGridApi.forEachNode(function (node) {
                        node.setDataValue("newPrice", node.data.currentPrice ?? null);
                    });

                    pricingGridApi.refreshCells({
                        columns:["newPrice","newPriceMB","status"],
                        force: true
                    });

                    pricingGridApi.onFilterChanged();
                    updateSummaryCounts();
                }

                function renderPricingGrid(groups) {

                    let rowData = [];
                    let categoryMap = new Map();
                    // let providerMap = new Map();

                    groups.forEach(group => {

                        group.apIs.forEach(api => {

                            let apiUuid = api.apiUUID || api.apiuuid;

                            let row = {
                                apiUUID: apiUuid,
                                providerUUID: api.providerUUID,
                                pricingUUID: api.pricingUUID,
                                apiName: api.apiName,
                                providerName: api.providerName,
                                categoryName: group.categoryName,
                                currentPrice: normalizePrice(api.currentPrice),
                                newPrice: normalizePrice(api.currentPrice),
                                currentPriceMB: normalizePrice(api.currentPriceMB),
                                newPriceMB: normalizePrice(api.currentPriceMB),
                                priceError: null,
                                priceErrorMB: null,
                                isTouched: false
                            };

                            rowData.push(row);

                            categoryMap.set(row.categoryName, (categoryMap.get(row.categoryName) || 0) + 1);
                            // providerMap.set(row.providerName, (providerMap.get(row.providerName) || 0) + 1);
                        });
                    });

                    applyDraftToRowData(rowData);

                    if (!pricingGridApi) {
                        let gridDiv = document.querySelector("#pricingGrid");
                        new agGrid.Grid(gridDiv, pricingGridOptions);
                    }

                    pricingGridOptions.api.setRowData(rowData);
                    pricingGridOptions.api.sizeColumnsToFit();

                    let categoryItems = Array.from(categoryMap.entries())
                        .sort((a, b) => a[0].localeCompare(b[0]))
                        .map(x => ({ value: x[0], label: x[0], count: x[1] }));

                    // let providerItems = Array.from(providerMap.entries())
                    //     .sort((a, b) => a[0].localeCompare(b[0]))
                    //     .map(x => ({ value: x[0], label: x[0], count: x[1] }));

                    renderFilterList("#categoryFilters", categoryItems, "category");
                    // renderFilterList("#providerFilters", providerItems, "provider");

                    $(".grid-filter").prop("checked", false);
                    updateFiltersFromUi();
                    updateSummaryCounts();
                    buildColumnPanel();
                    startAutoDraftSave();
                }

    function submitPricing() {

                    if (!pricingGridApi) {

                        showNotification(
                            "Please load pricing before saving.",
                            "warning"
                        );

                        return;
                    }

                    let effectiveDate =
                        $("#EffectiveDate")
                            .val();

                    let priceType =
                        $("#PriceType")
                            .val();

                    if (!effectiveDate) {

                        showNotification(
                            "Effective date is required.",
                            "warning"
                        );

                        return;
                    }

                    let pricingList = [];

                    let hasErrors =
                        false;

                    let firstErrorIndex = -1;

                    pricingGridApi
                        .forEachNode(
                            function (node) {

                                let row = node.data;

                                if (!row.apiUUID)
                                    return;

                                row.isTouched = true;

                validatePriceRow(
                    row,
                    true
                );

                                if (
                                    row.priceError || 
                                    row.priceErrorMB
                                ) {

                                    hasErrors =
                                        true;

                                            // capture first error row
                if (firstErrorIndex === -1) {
                    firstErrorIndex = node.rowIndex;
                }

                                    return;
                                }

                                let price =
                                    normalizePrice(
                                        row.newPrice
                                    );

                                pricingList
                                    .push({

                                        apiUUID:
                                            row.apiUUID,

                                        providerUUID:
                                            row.providerUUID,

                                        sellerTenantId:
                                            null,

                                        buyerType:
                                            "Tenant",

                                        buyerUUID:
                                            "@Model.PlatformOwnerUUID",

                                        baseAmount: parseFloat(price),
                                        baseAmountMB: normalizePrice(row.newPriceMB)
                                    });
                            });

                    // =====================
                    // REFRESH VALIDATION UI
                    // =====================

                    pricingGridApi
                        .refreshCells({

                            columns:
                                [
                                    "newPrice",
                                    "newPriceMB"
                                ],

                            force:
                                true
                        });

                    updateSummaryCounts();

                    // =====================
                    // STOP SAVE
                    // =====================

                        if (hasErrors) {

            // open page containing first error
            const pageSize =
                pricingGridApi
                    .paginationGetPageSize();

            const targetPage =
                Math.floor(
                    firstErrorIndex / pageSize
                );

            pricingGridApi
                .paginationGoToPage(
                    targetPage
                );

            setTimeout(function () {

                pricingGridApi
                    .ensureIndexVisible(
                        firstErrorIndex,
                        "middle"
                    );

            }, 100);

            return;
        }

                    if (
                        pricingList
                            .length
                        === 0
                    ) {

                        showNotification(
                            "Please enter at least one price.",
                            "warning"
                        );

                        return;
                    }

                    let payload = {

                        priceType:
                            priceType,

                        providerUUID:
                            $("#ProviderUUID")
                                .val(),

                        effectiveDate:
                            effectiveDate,

                        pricingList:
                            pricingList
                    };

                    $.ajax({

                        url:
                            "/Pricing/SavePricing",

                        type:
                            "POST",

                        contentType:
                            "application/json",

                        data:
                            JSON.stringify(
                                payload
                            ),

                        beforeSend:
                            function () {

                                showLoader();
                            },

                        complete:
                            function () {

                                hideLoader();
                            },

                        success:
                            function (res) {

                                if (
                                    !res.success
                                ) {

                                    showNotification(

                                        res.message
                                        ||

                                        "Unable to save pricing.",

                                        "danger"
                                    );

                                    return;
                                }

                                localStorage
                                    .removeItem(
                                        pricingDraftStorageKey
                                    );

                                updateDraftSavedLabel(
                                    null
                                );

                                showNotification(

                                    res.message,

                                    "success"
                                );

                                setTimeout(
                                    function () {

                                        window
                                            .location
                                            .reload();

                                    },

                                    1200
                                );
                            },

                        error:
                            function () {

                                showNotification(

                                    "Something went wrong.",

                                    "danger"
                                );
                            }
                    });
                }

                // =====================================
                // SEARCH (QUICK FILTER)
                // =====================================

                $("#pricingSearch").on("input", function () {
                    setQuickFilter($(this).val());
                });

                $("#filterSearch").on("input", function () {
                    applyFilterSearch($(this).val());
                });

                // =====================
                // FILTER PANEL TOGGLE
                // =====================

                let isFilterOpen = false;

                $("#btnToggleFilters").click(function () {

                    isFilterOpen = !isFilterOpen;

                    $(".pricing-layout")
                        .toggleClass(
                            "filters-hidden",
                            !isFilterOpen
                        );

                    $(this).html(
                        isFilterOpen
                            ? '<i class="mdi mdi-filter-outline"></i>'
                            : '<i class="mdi mdi-filter-plus-outline"></i>'
                    );

                    setTimeout(function () {

                        if (pricingGridApi) {
                            pricingGridApi.sizeColumnsToFit();
                        }

                    }, 250);
                });

                // =====================================
                // FILTER CHECKBOXES
                // =====================================

                $(document).on("change", ".grid-filter", function () {
                    updateFiltersFromUi();
                    updateSummaryCounts();
                });

                $("#btnClearFilters").click(function () {
                    $(".grid-filter").prop("checked", false);
                    updateFiltersFromUi();
                    updateSummaryCounts();
                });

                // =====================================
                // COLUMN PANEL
                // =====================================

                $("#btnToggleColumns").click(function (e) {
                    e.preventDefault();

                    if (!pricingGridApi) {
                        showNotification("Please load pricing before managing columns.", "warning");
                        return;
                    }

                    setColumnsPanelState(!isColumnsPanelOpen);
                });

                $(document).on("click", function (e) {
                    if ($(e.target).closest("#btnToggleColumns, #columnPanel").length === 0) {
                        setColumnsPanelState(false);
                    }
                });

                $(document).on("change", ".column-toggle", function () {
                    if (!pricingColumnApi) {
                        return;
                    }

                    let colId = $(this).data("col-id");
                    let isVisible = $(this).is(":checked");
                    pricingColumnApi.setColumnVisible(colId, isVisible);
                });

                // =====================================
                // SAVE DRAFT
                // =====================================

                $("#btnSaveDraft").click(function (e) {
                    e.preventDefault();
                    savePricingDraft(false);
                });

                // =====================================
                // BULK APPLY
                // =====================================

                $("#btnBulkApply").click(function (e) {

                    e.preventDefault();

                    if (!pricingGridApi) {

                        showNotification("Please load pricing before bulk apply.", "warning");

                        return;
                    }

                    let bulkPrice = normalizePrice($("#bulkPrice").val());

                    if (!Number.isFinite(bulkPrice)) {

                        showNotification("Please enter a valid bulk price.", "warning");

                        return;
                    }

                    let selectedNodes = pricingGridApi.getSelectedNodes();

                    if (selectedNodes.length === 0) {

                        showNotification("Please select at least one API.", "warning");

                        return;
                    }

                    let bulkType = $("#bulkPriceType").val();

                    selectedNodes.forEach(function (node) {
                        if (bulkType === "newPrice" || bulkType === "both") {
                            node.setDataValue("newPrice", bulkPrice);
                        }

                        if (bulkType === "newPriceMB" || bulkType === "both") {
                            node.setDataValue("newPriceMB", bulkPrice);
                        }
                    });

                    pricingGridApi.refreshCells({
                        rowNodes: selectedNodes,
                        columns:["newPrice","newPriceMB","status"],
                        force: true
                    });

                    pricingGridApi.onFilterChanged();
                    updateSummaryCounts();
                });

                // =====================================
                // CANCEL
                // =====================================

                $("#btnCancelPricing").click(function (e) {

                    e.preventDefault();

                    if (!pricingGridApi)
                        return;

                    Swal.fire({
                        icon: "warning",
                        title: "Discard changes?",
                        text: "All changes will be removed.",
                        showCancelButton: true,
                        confirmButtonText: "Yes, discard",
                        cancelButtonText: "Keep editing"
                    }).then(function (result) {
                        if (!result.isConfirmed) {
                            return;
                        }

                        resetPricingEdits();
                        localStorage.removeItem(pricingDraftStorageKey);
                        updateDraftSavedLabel(null);

                // =====================================
                // MOVE CONTROLS BACK
                // =====================================

                if ($("#pricingHeaderActions").children().length)
                {
                    $("#pricingSetupActions")
                        .append(
                            $("#pricingHeaderActions")
                                .children()
                        );
                }

                // =====================================
                // UNLOCK SETUP
                // =====================================

                $("#PriceType")
                    .prop("disabled", false)

                $("#ProviderUUID")
                    .prop("disabled", false)

                $("#EffectiveDate")
                    .prop("readonly", false)
                    .prop("disabled", false);

                // Show Get Price again
                $("#btnGetPrice")
                    .closest("div")
                    .show();

                // Restore setup area
                $("#pricingSection")
                    .hide();

                $("#pricingSetup")
                    .show();
                    });
                });

                // =====================================
                // GET PRICE
                // =====================================

                $("#btnGetPrice").click(function (e) {
                                e.preventDefault();

        const $setupForm = $("#pricingSetupForm");

        if (!$setupForm.data("validator")) {
            $setupForm.validate({ ignore: [] });
        }

        if (!$setupForm.valid()) {
            showValidationAnimation("#pricingSetupForm");
            return;
        }
                    let payload = {

                        priceType:
                            $("#PriceType").val(),

                        providerUUID:
                            $("#ProviderUUID").val(),

                        effectiveDate:
                            $("#EffectiveDate").val()
                    };
                    $.ajax({

                        url: '/Pricing/GetPriceTbl',

                        type: 'POST',

                        contentType: 'application/json',

                        data: JSON.stringify(payload),
                        beforeSend: function () {

                            showLoader();
                        },

                        complete: function () {

                            hideLoader();
                        },

                        success: function (res) {
                            if (!res.success) {

                                showNotification(res.message || "Unable to load pricing.", "danger");

                                $("#pricingSection").hide();

                                return;
                            }

                            $("#pricingSection").show();
                            $("#pricingSetup").hide();

                            // Hide filters by default
                            $(".pricing-layout").addClass("filters-hidden");

                            $("#btnToggleFilters").html(
                                '<i class="mdi mdi-filter-plus-outline"></i>'
                            );

                            if ($("#pricingHeaderActions").is(":empty")) {
                                $("#pricingHeaderActions").append($("#pricingSetupActions").children());
                            }

                            renderPricingGrid(res.pricing);

                            setTimeout(function () {
                                pricingGridApi?.sizeColumnsToFit();
                            }, 50);

                            // =====================================
                            // LOCK FILTERS
                            // =====================================

                                    $("#PriceType")
                    .prop("disabled", true)
                    .trigger("change");

                $("#ProviderUUID")
                    .prop("disabled", true)
                    .trigger("change");

                $("#EffectiveDate")
                    .prop("readonly", true)
                    .prop("disabled", true);

                // Hide Get Price
                $("#btnGetPrice")
                    .closest("div")
                    .hide();
                        },

                        error: function () {
                            showNotification("Something went wrong.", "danger");
                        }
                    });
                });

                // =====================================
                // SAVE PRICING
                // =====================================

                $("#btnSavePricing").click(function (e) {

                    e.preventDefault();

                    if (!pricingGridApi) {

                        showNotification(
                            "Please load pricing before saving.",
                            "warning"
                        );

                        return;
                    }

                    Swal.fire({
                        icon: "question",
                        title: "Submit pricing?",
                        text: "Are you sure you want to submit these prices?",
                        showCancelButton: true,
                        confirmButtonText: "Submit",
                        cancelButtonText: "Cancel"
                    }).then(function (result) {
                        if (!result.isConfirmed) {
                            return;
                        }

                        localStorage.removeItem(pricingDraftStorageKey);
                        updateDraftSavedLabel(null);
                        submitPricing();
                    });
                });

    </script>
}