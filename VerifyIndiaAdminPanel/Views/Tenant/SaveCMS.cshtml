@{
    ViewData["Title"] = "Manage Website Content";
    var tenants = ViewBag.Tenants as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}
@using Microsoft.AspNetCore.Mvc.Rendering
@using VerifyIndia.Application.Commands.WL
@model WLMasterCMSCommand
<div class="container-fluid">
    <!-- Page-Title -->
    <!-- end page title end breadcrumb -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">
                            @ViewData["Title"]
                        </h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="SaveCMS" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UUID" id="HiddenUUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="UploadImage" />
                    <input type="hidden" asp-for="TenantId" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="TenantName"
                                        label="Tenant Name"
                                        type="Text"
                                        attr-readonly="true">
                            </form-field>
                        </div>
                        <!-- Page Title Dropdown -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="PageTitle"
                                        label="Page title"
                                        type="Text"
                                        attr-readonly="true">
                            </form-field>
                        </div>

                        <!-- Upload Image -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Image"
                                        label="Upload image"
                                        type="File"
                                        view-link-path="@Model.ImageUrlwithdomain">
                            </form-field>
                            <a href="#" class="view-file-link" target="_blank" style="display:none; margin-bottom: 0px;
                                        position: absolute;
                                        bottom: 70%;
                                        right: 3%;
                                        max-width: 70%;
                                        margin-bottom: 0;
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        cursor: pointer;
                                    ">View Document</a>
                        </div>
                    </div>

                    <!-- Description CKEditor -->
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 pt-3">
                            <form-field asp-for="Description" label="Description" type="CKEditor" required="true"></form-field>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ViewCMS", "Tenant")" />
                            <form-button label="Update"
                                         type="Submit" />
                        </div>
                    </div>

                </form>
            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts
{

    <script src="~/ckeditor/ckeditor/ckeditor.js"></script>
     <script>
                 function initializeForm() {
            if (typeof jQuery === 'undefined') {
                setTimeout(initializeForm, 100);
                return;
            }
            if (typeof CKEDITOR !== 'undefined') {
                document.querySelectorAll('.ckeditor-textarea').forEach(function (textarea) {
                    if (!CKEDITOR.instances[textarea.id]) {
                        var editor = CKEDITOR.replace(textarea.id, {
                            extraAllowedContent: 'div(*)[*]{*}; span(*)[*]{*}; p(*)[*]{*};',
                            allowedContent: true,
                            height: 300,
                            toolbar: [
                                { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                                { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                                '/',
                                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote'] },
                                { name: 'links', items: ['Link', 'Unlink'] },
                                { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                                '/',
                                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                                { name: 'colors', items: ['TextColor', 'BGColor'] }
                            ]
                        });

                        editor.on('change', function () {
                            editor.updateElement();
                        });
                    }
                });
            }
        }

                   document.addEventListener('DOMContentLoaded', initializeForm);
            if (typeof jQuery !== 'undefined') {
                jQuery(document).ready(function () {
                    initializeForm();

                    // Tell jQuery Validate to ignore nothing, so it can see the hidden textarea
                    if ($.validator) {
                        $.validator.setDefaults({
                            ignore: []
                        });
                    }
                });
            }
    
     </script>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}