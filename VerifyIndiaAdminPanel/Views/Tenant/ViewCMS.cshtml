@model VerifyIndiaAdminPanel.Models.WL.TenantVm
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
@section Styles {
    <partial name="_ViewStyles" />
}
@{
    ViewData["Title"] = "View Website Content";
    var tenants = (Model?.Tenants as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>())
   .ToList();
    
}
<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-9">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="row align-items-center mb-3">
                    <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                        <form-field asp-for="SelectedTenantValue"
                                    label="Tenant"
                                    type="Select"
                                    asp-items="@tenants">
                        </form-field>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Sr.</th>
                                    <th style="display:none;">UUID</th>
                                    <th>Tenant Name</th>
                                    <th>Page Name</th>
                                    <th data-action-column="true">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                            </tbody>
                        </table>

                    </div>


                </div><!--end card-body-->
            </div>
        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editcms" label="Edit Website Content Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>
    
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script>
        const baseUrl = '@Url.Action("GetCMS", "Tenant")';
        const getAjaxUrl = () => `${baseUrl}?tenantUuid=${encodeURIComponent($('#SelectedTenantValue').val() || '')}`;

               initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: getAjaxUrl(),
            columns: [
        { data: 'srno', orderable: false },
        { data: 'uuid', visible: false },
        { data: 'tenantid' },
        { data: 'pagename' },
        { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editcms',
                    baseUrl: '@Url.Action("SaveCMS", "Tenant")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("WL_MasterCMS", rowData.uuid, false, "");
                    }
                }
            ]
        });
           $(function () {
            $('.js-single-select').select2({
                width: '80%',
                allowClear: false,
                minimumResultsForSearch: 0
            });
        });
        $('#SelectedTenantValue').on('change', function () {
            const table = $('#datatable_1').DataTable();
            table.ajax.url(getAjaxUrl()).load();
        });
         $('#SelectedTenantValue').on('change select2:clear', function () {
           const table = $('#datatable_1').DataTable();
           table.ajax.url(getAjaxUrl()).load();
        });
        $('#tenantFilter').on('change', function () {
            const table = $('#datatable_1').DataTable();
            table.ajax.url(getAjaxUrl()).load();
        });

        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                    "TenantId": "/Common/GetTenantName"
                },
                friendlyFieldMap: {
                    "PageTitle": "Page Name",
                    "Description": "Description",
                    "UploadImage": "Page Image",
                    "TenantId": "Tenant Name",
                    "IsActive": "Status"
                },
                hiddenFields: [
                    "UploadImage"
                ]
            })
        );
    </script>

}
