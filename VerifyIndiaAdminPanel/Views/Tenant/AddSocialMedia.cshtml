@model VerifyIndia.Application.Commands.WL.WLSocialMediaCommand
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var isEdit = Model != null && !string.IsNullOrEmpty(Model.UUID);
    ViewData["Title"] = "Add Social Media";
    var tenants = Model?.Tenants ?? Enumerable.Empty<SelectListItem>();
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="AddSocialMedia" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            
                            @if (isEdit)
                            {
                                <!-- Edit mode: readonly display -->
                                <form-field asp-for="TenantName"
                                            label="Tenant Name"
                                            type="Text"
                                            required="true"
                                            attr-readonly="true" />
                                <input type="hidden" asp-for="TenantId" />
                            }
                            else
                            {
                                <!-- Add mode: normal dropdown -->
                                <form-field asp-for="TenantId"
                                            label="Tenant"
                                            type="Select"
                                            asp-items="@tenants"
                                            required="true"
                                            placeholder="Select Tenant" />
                            }
                        </div>

                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="PlatformName" label="Platform Name" type="Text" required="true" />
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="ProfileURL" label="Profile URL" type="Text" required="true" />
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="IconURL" label="Icon (fab fa-instagram)" type="Text" required="true" />
                        </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="DisplayOrder" label="Display Order" type="Number" required="true" />
                        </div>

                        <div class="col-lg-9 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel" type="Cancel" url="@Url.Action("ViewSocialMedia", "Tenant")" />
                            <form-button label="Submit" type="Submit" />
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<partial name="_Timer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}