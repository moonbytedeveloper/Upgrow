@model VerifyIndia.Application.Commands.WL.WLTestimonialCommand

@{

    var isEdit = Model != null && !string.IsNullOrEmpty(Model.UUID);
    ViewData["Title"] = isEdit ? "Edit Testimonial" : "Add Testimonial";
    var tenants = Model?.Tenants ?? Enumerable.Empty<SelectListItem>();
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">

    <div class="row mt-2">

        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">

                <form id="bannerForm" asp-action="AddTestimonial" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="FilePath" value="@(Model?.FilePath ?? string.Empty)" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            @if (isEdit)
                            {
                                <!-- Edit mode: readonly display -->
                                <form-field asp-for="TenantName"
                                            label="Tenant Name"
                                            type="Text"
                                            required="true"
                                            attr-readonly="true" />
                                <input type="hidden" asp-for="TenantId" />
                            }
                            else
                            {
                                <!-- Add mode: normal dropdown -->
                                <form-field asp-for="TenantId"
                                            label="Tenant"
                                            type="Select"
                                            asp-items="@tenants"
                                            required="true"
                                            placeholder="Select Tenant" />
                            }
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="CustomerName"
                                        label="Customer Name"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="CompanyName"
                                        label="Company Name"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Star"
                                        label="Star Rating"
                                        type="Number"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SequenceNo"
                                        label="Display Sequence"
                                        type="Number"
                                        required="true" />
                        </div>

                        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Comment"
                                        label="Customer Comment"
                                        type="TextArea"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Image"
                                        label="Customer Image"
                                        type="File"
                                        required="@(string.IsNullOrEmpty(Model?.FilePath))"
                                        view-link-path="@Model?.ImageUrlwithdomain" />
                        </div>


                        <div class="col-lg-12 text-align-end pt-4">

                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ViewTestimonial", "Tenant")" />

                            <form-button label="Submit"
                                         type="Submit" />

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<partial name="_Timer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}