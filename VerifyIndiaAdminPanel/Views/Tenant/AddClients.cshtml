@model VerifyIndia.Application.Commands.WL.WLClientsCommand

@{
    var isEdit = Model != null && !string.IsNullOrEmpty(Model.UUID);
    ViewData["Title"] = "Add Clients";
    var tenants = Model?.Tenants ?? Enumerable.Empty<SelectListItem>();
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="AddClients" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="IconImage" />
                    

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            @if (isEdit)
                            {
                                <!-- Edit mode: readonly display -->
                                <form-field asp-for="TenantName"
                                            label="Tenant Name"
                                            type="Text"
                                            required="true"
                                            attr-readonly="true" />
                                <input type="hidden" asp-for="TenantId" />
                            }
                            else
                            {
                                <!-- Add mode: normal dropdown -->
                                <form-field asp-for="TenantId"
                                            label="Tenant"
                                            type="Select"
                                            asp-items="@tenants"
                                            required="true"
                                            placeholder="Select Tenant" />
                            }
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">

                            <form-field asp-for="Name"
                                        label="Client Name"
                                        type="Text"
                                        required="true" />
                        </div>
                        
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Image"
                                        label="Upload Icon"
                                        type="File"
                                        accept=".jpg,.jpeg,.png"
                                        required="string.IsNullOrEmpty(Model.IconImage)"
                                        view-link-path="@Model.ImageUrlwithdomain" />
                        </div>
                       
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ViewClients", "Tenant")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>

            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/notification.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}