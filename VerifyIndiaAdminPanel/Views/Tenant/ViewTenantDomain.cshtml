@{
    ViewData["Title"] = "View Tenant Domain";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-align-end">
                    <form-button label="Add Tenant Domain"
                                 type="Add"
                                 url="@Url.Action("AddTenantDomain", "Tenant")">
                    </form-button>
                    
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Domain</th>
                            <th>Domain Type</th>
                            <th>Tenant</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->

        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editTenantDomainLink" label="Edit Tenant Domain Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetTenantDomain", "Tenant")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'domain' },
                { data: 'domaintype' },
                { data: 'tenant' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editTenantDomainLink',
                    baseUrl: '@Url.Action("EditTenantDomain", "Tenant")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("TenantDomain", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                    "TenantId": "/Common/GetTenantName"
                },
                friendlyFieldMap: {
                    "Domain": "Domain",
                    "DomainType": "Domain Type",
                    "TenantId": "Tenant Name",
                    "IsPrimary": "Primary Domain",
                    "IsActive": "Status"
                },
                hiddenFields: [
                ]
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'TenantDomain' });
    </script>
}
