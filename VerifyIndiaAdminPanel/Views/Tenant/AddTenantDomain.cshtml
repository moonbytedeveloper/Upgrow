@model VerifyIndiaAdminPanel.Models.WL.TenantDomainVM
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.TenantDomain.UUID);
    var pageTitle = isEditMode ? "Edit Tenant Domain" : "Add Tenant Domain";
    ViewData["Title"] = pageTitle;
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="AddTenantDomain" method="post">
                    <input type="hidden" asp-for="TenantDomain.UUID" />
                    <input type="hidden" asp-for="TenantDomain.IsActive" />
                    


                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="TenantDomain.TenantId"
                                        label="Tenant"
                                        type="Select"
                                        asp-items="@Model.TenantList"
                                        required="true" />
                       </div>
                        <div class="col-lg-9">
                            <div class="row">
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="TenantDomain.Domain"
                                                label="Domain"
                                                type="Text"
                                                required="true" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="TenantDomain.DomainType"
                                                label="Domain Type"
                                                type="Text"
                                                required="true" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12 pt-4">
                                    <form-field asp-for="TenantDomain.IsPrimary"
                                                label="Is Primary"
                                                type="Checkbox"
                                                required="true" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("ViewTenantDomain", "Tenant")" />
                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>

                            </div>
                            </div>
                        </div>
                </form>
                       </div>
               
            </div>

            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->



</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}

