@model VerifyIndia.Application.Commands.Website.NewsCategoryCommand
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.UUID);
    var pageTitle = isEditMode ? "Edit News Category" : "Add News Category";
    ViewData["Title"] = pageTitle;
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="AddNewsCategory" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Title"
                                        label="News Category Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-6 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ShortDescription" label="News Category  Description" required="true" type="TextArea"></form-field>
                        </div>

                        <div class="col-lg-3  text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ViewNewsCategory", "Website")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->



</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
}

