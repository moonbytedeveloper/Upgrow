@{
    ViewData["Title"] = "View News";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">

        <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-align-end">
                    <form-button label="Add News"
                                 type="Add"
                                 url="@Url.Action("AddNews", "Website")">
                    </form-button>
                    
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>News Title</th>
                                <th>News Category</th>
                                <th>Publish Date</th>
                                <th>Short Description</th>
                                <th>Is Top Story</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->

        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
                <action-link id="editNewsLink" label="Edit News Details" type="Edit"></action-link>
                <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" /> 
@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetNews", "Website")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'title' },
                 { data: 'newcategory' },
                  { data: 'publishdate' },
                 { data: 'shortDescription' },
                 { data: 'istopstory' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editNewsLink',
                    baseUrl: '@Url.Action("EditNews", "Website")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("News", rowData.uuid, false, "");
                    }
                }

            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                    "NewsCategoryUUID": "/Common/GetNewsCategoryName"
                },
                friendlyFieldMap: {
                    "Title": "News Title",
                    "NewsCategoryUUID": "News Category",
                    "ShortDescription": "Short Description",
                    "FullDescription": "Full Description",
                    "Image": "News Image",
                    "IsActive": "Status"
                },
                hiddenFields: [
                    "Image"
                ]
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'News' });
    </script>
}