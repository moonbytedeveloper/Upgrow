@{
    ViewData["Title"] = "View FAQ Category";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-9">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->
                    <div class="col-3 text-align-end">
                        <form-button label="Add FAQ Category"
                                     type="Add"
                                     url="@Url.Action("AddFaqCategory", "Website")">
                        </form-button>

                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr. No</th>
                                <th style="display:none;">UUID</th>
                                <th>FAQ Category Title</th>
                                <th>Icon</th>
                                <th>Short Description</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>

                </div>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>

            <action-link id="editFaqCategoryLink" label="Edit FAQ Category Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetFaqCategory", "Website")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'name' },
                {
                    data: 'icon',
                    orderable: false,
                    render: function (data, type, row) {
                        if (type === 'display' && data) {
                            // Render Font Awesome icon
                            return '<i class="' + data + '" style="font-size: 20px; color: #3498db;"></i>';
                        }
                        return data;
                    }
                },
                { data: 'shortdescription' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editFaqCategoryLink',
                    baseUrl: '@Url.Action("EditFaqCategory", "Website")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Website_FaqCategory", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
            },
            friendlyFieldMap: {
                "Title": "Category Title"
            },
            hiddenFields: [
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Website_FaqCategory' });
    </script>
}
