@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">
        <div class="col-sm-12">
            <div class="page-title-box">
                <h4 class="page-title">Dashboard</h4>
            </div>
        </div>
    </div>

    <!-- Stats Row -->
    <div class="row">
        <div class="col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-row">
                        <div class="col-3 align-self-center">
                            <div class="round">
                                <i class="fas fa-users fs-3"></i>
                            </div>
                        </div>
                        <div class="col-9 align-self-center text-end">
                            <div class="m-l-10">
                                <h5 class="mt-0">1,250</h5>
                                <p class="mb-0 text-muted">Total Users</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-row">
                        <div class="col-3 align-self-center">
                            <div class="round">
                                <i class="fas fa-file-alt fs-3"></i>
                            </div>
                        </div>
                        <div class="col-9 align-self-center text-end">
                            <div class="m-l-10">
                                <h5 class="mt-0">452</h5>
                                <p class="mb-0 text-muted">Pending Verifications</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-row">
                        <div class="col-3 align-self-center">
                            <div class="round">
                                <i class="fas fa-check-circle fs-3"></i>
                            </div>
                        </div>
                        <div class="col-9 text-end align-self-center">
                            <div class="m-l-10">
                                <h5 class="mt-0">8,532</h5>
                                <p class="mb-0 text-muted">Completed</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-3 col-md-6">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex flex-row">
                        <div class="col-3 align-self-center">
                            <div class="round">
                                <i class="fas fa-chart-line fs-3"></i>
                            </div>
                        </div>
                        <div class="col-9 align-self-center text-end">
                            <div class="m-l-10">
                                <h5 class="mt-0">$24,500</h5>
                                <p class="mb-0 text-muted">Revenue</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Tables Row -->
    <div class="row mt-4">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">Recent Activity</h4>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Client Name</th>
                                    <th>Verification Type</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>1</td>
                                    <td>John Doe</td>
                                    <td>Background Check</td>
                                    <td>12 Oct 2023</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                                <tr>
                                    <td>2</td>
                                    <td>Jane Smith</td>
                                    <td>Education Verify</td>
                                    <td>14 Oct 2023</td>
                                    <td><span class="badge bg-warning">Pending</span></td>
                                </tr>
                                <tr>
                                    <td>3</td>
                                    <td>Robert Johnson</td>
                                    <td>Address Check</td>
                                    <td>15 Oct 2023</td>
                                    <td><span class="badge bg-danger">Failed</span></td>
                                </tr>
                                <tr>
                                    <td>4</td>
                                    <td>Emily Davis</td>
                                    <td>Employment Verify</td>
                                    <td>16 Oct 2023</td>
                                    <td><span class="badge bg-info">In Progress</span></td>
                                </tr>
                                <tr>
                                    <td>5</td>
                                    <td>Michael Wilson</td>
                                    <td>Criminal Check</td>
                                    <td>16 Oct 2023</td>
                                    <td><span class="badge bg-success">Completed</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4 class="card-title">System Status</h4>
                </div>
                <div class="card-body">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            API Gateway
                            <span class="badge bg-success rounded-pill">Online</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Database Server
                            <span class="badge bg-success rounded-pill">Online</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Storage Service
                            <span class="badge bg-warning rounded-pill">Degraded</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Email Server
                            <span class="badge bg-success rounded-pill">Online</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>