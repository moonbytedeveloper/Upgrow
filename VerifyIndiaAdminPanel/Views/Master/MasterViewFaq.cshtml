@{
    ViewData["Title"] = "View FAQ";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-3 text-align-end">
                    <form-button label="Add FAQ"
                                 type="Add"
                                 url="@Url.Action("MasterAddFaq", "Master")">
                    </form-button>
                   
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Title</th>
                            <th>FAQ Category</th>
                                <th>FAQ Sub Category</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>

        </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>            
            <action-link id="editFaqLink" label="Edit FAQ Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetFaq", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'title' },
                { data: 'category' },
                { data: 'subcategory' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editFaqLink',
                    baseUrl: '@Url.Action("MasterEditFaq", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                        {
            selector: '#viewHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Master_Faq", rowData.uuid, false, "");
            }
        }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
                "FAQCategoryUUID": "/Common/GetFaqCategoryName",
                "ServiceUUID": "/Common/GetServiceCategoryName"
            },
            friendlyFieldMap: {
                "Title": "Title",
                "FAQCategoryUUID": "FAQ Category",
                "ServiceUUID": "Service Category",
                "Description": "Description"
            },
            hiddenFields: [
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Faq' });
    </script>
}