@{
    ViewData["Title"] = "Manage Website Content";
}
@using Microsoft.AspNetCore.Mvc.Rendering
@using VerifyIndiaAdminPanel.Models.Master
@model MasterCmsVM
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <!-- end page title end breadcrumb -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">
                            @ViewData["Title"]
                        </h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddCMS" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Command.UUID" id="HiddenUUID" />
                    <input type="hidden" asp-for="Command.IsActive" />
                    <input type="hidden" asp-for="Command.UploadImage" />

                    <div class="row align-items-center">
                        <!-- Page Title Dropdown -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.PageTitle"
                                        asp-items="@(Model.CmsOptions.Select(x => new SelectListItem { Value = x.UUID, Text = x.PageTitle }))"
                                        label="Page title"
                                        type="Select"
                                        required="true"
                                        searchable="true">
                            </form-field>
                        </div>

                        <!-- Upload Image -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.ImageFile"
                                        label="Upload image"
                                        type="File"
                                        accept=".jpg,.jpeg,.png"
                                        view-link-path="@Model.Command.ImageUrlwithdomain">
                            </form-field>
                            <a href="#" class="view-file-link" target="_blank" style="display:none; margin-bottom: 0px;
                                        position: absolute;
                                        bottom: 70%;
                                        right: 3%;
                                        max-width: 70%;
                                        margin-bottom: 0;
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        cursor: pointer;
                                    ">View Document</a>
                        </div>
                    </div>

                    <!-- Description CKEditor -->
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 pt-3">
                            <form-field asp-for="Command.Description" label="Description" type="CKEditor" required="true"></form-field>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="row">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterAddCMS", "Master")" />
                            <form-button label="Update"
                                         type="Submit" />
                        </div>
                    </div>

                </form>
            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts
{

    <script src="~/ckeditor/ckeditor/ckeditor.js"></script>
    <script>
        let ckeditorInstance = null;

        $(document).ready(function () {
            // Initialize CKEditor using the element generated by asp-for (name="Command.Description")
            const descElem = $('[name="Command.Description"]');
            if (descElem.length) {
                try {
                    // CKEDITOR.replace accepts a DOM element or id; pass the DOM element for reliability
                    const instance = CKEDITOR.replace(descElem[0], {
                        extraAllowedContent: 'div(*)[*]{*}; span(*)[*]{*}; p(*)[*]{*};',
                        allowedContent: true,
                        height: 300,
                        toolbar: [
                            { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                            { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                            { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                            '/',
                            { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                            { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote'] },
                            { name: 'links', items: ['Link', 'Unlink'] },
                            { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                            '/',
                            { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                            { name: 'colors', items: ['TextColor', 'BGColor'] }
                        ]
                    });
                    ckeditorInstance = instance;
                } catch (e) {
                    console.error('CKEditor init error:', e);
                }
            }

            // Handle dropdown change - use name selector generated by asp-for
            $('[name="Command.PageTitle"]').on('change', function () {
                const uuid = $(this).val();
                $('#HiddenUUID').val(uuid || '');

                if (uuid) {
                    loadCMSData(uuid);
                } else {
                    resetForm();
                }
            });
        });

        function loadCMSData(uuid) {
            $.ajax({
                url: '@Url.Action("GetCMSData", "Master")',
                type: 'POST',
                data: { uuid: uuid },
                success: function (response) {
                    if (response.success) {
                        $('#HiddenUUID').val(response.data.uuid || '');
                        // Use name selectors for asp-for generated hidden inputs
                        $('[name="Command.IsActive"]').val(response.data.isactive || '');
                        $('[name="Command.UploadImage"]').val(response.data.uploadImage || '');

                        if (ckeditorInstance) {
                            ckeditorInstance.setData(response.data.description || '');
                        } else {
                            $('[name="Command.Description"]').val(response.data.description || '');
                        }

                        if (response.data.uploadImage) {
                            const viewImageBtn = $('.view-file-link');
                            viewImageBtn.attr('href', response.data.uploadImage).show();
                        } else {
                            $('.view-file-link').hide();
                        }

                        // Clear file input (asp-for generates name="Command.ImageFile")
                        $('[name="Command.ImageFile"]').val('');
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('Error loading data');
                }
            });
        }

        function resetForm() {
            $('#HiddenUUID').val('');
            $('[name="Command.UploadImage"]').val('');
            if (ckeditorInstance) {
                ckeditorInstance.setData('');
            } else {
                $('[name="Command.Description"]').val('');
            }
            $('[name="Command.ImageFile"]').val('');
            $('.view-file-link').hide();
        }
    </script>
    <script src="~/assets/js/notification.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
}