@model VerifyIndia.Application.Commands.Master.MasterBannerCommand
@{
    var isEdit = Model != null && !string.IsNullOrEmpty(Model.UUID);
    ViewData["Title"] = isEdit ? "Edit Website Banner" : "Add Website Bannerr";
}
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.UUID) ? "Add Banner" : "Edit Banner";
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddBanner" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="BannerImage" value="@Model.BannerImage" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SequenceNo"
                                        label="Sequence No"
                                        type="Number"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="MainTitle"
                                        label="Banner Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SubTitle"
                                        label="Banner Sub Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="OptionalTitle"
                                        label="Banner Optional Title"
                                        type="Text"
                                        />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ButtonText"
                                        label="Button Text"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ButtonURL"
                                        label="Button URL"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            
                            <form-field asp-for="Image" label="Banner image" view-link-path="@Model.ImageUrlwithdomain" type="File" accept=".jpg,.jpeg,.png" required="string.IsNullOrEmpty(Model.BannerImage)">
                            </form-field>

                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewBanner", "Master", new { area = "Admin" })" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->



</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/notification.js"></script>
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}

