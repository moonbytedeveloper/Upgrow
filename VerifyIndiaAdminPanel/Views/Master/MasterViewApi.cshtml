@{
    ViewData["Title"] = "API Management";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-3 text-align-end">
                    <form-button label="Add API"
                                 type="Add"
                                 url="@Url.Action("MasterAddApi", "Master")">
                    </form-button>
                    
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>API Name</th>                            
                            <th>Category</th>
                            <th>Description</th>
                            <th>Sequence No</th>
                            <th>Is Consent Based</th>
                            <th>Is Reminder Required</th>
                            <th>Is Provider Switchable</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>

        </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>            
            <action-link id="editApiLink" label="Edit API Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetApi", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'apiname' },
                { data: 'category' },
                { data: 'description' },
                { data: 'displayorder' },
                { data: 'consentbased', orderable: false },
                { data: 'reminderrequired', orderable: false },
                { data: 'isproviderswitchable', orderable: false },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editApiLink',
                    baseUrl: '@Url.Action("MasterEditApi", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Master_Api", rowData.uuid, false, "");
                    }
                }
            ]
        });
         AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
                "ApiCategoryUUID": "/Common/GetApiCategoryName"
            },
            friendlyFieldMap: {
                "ApiName": "API Name",
                "Code": "Code",
                "ApiCategoryUUID": "API Category",
                "ShortDescription": "Description",
                "DisplayOrder": "Display Order"
            },
            hiddenFields: [
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Api' });
    </script>
}