@model VerifyIndia.Application.Commands.Master.MasterHonorificCommand

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.UUID);
    var pageTitle = isEditMode ? "Edit Honorific" : "Add Honorific";
    ViewData["Title"] = pageTitle;
}

        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="row mt-2">

                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                            </div><!--end col-->

                        </div> <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                        <form id="bannerForm" asp-action="MasterAddHonorific" method="post">
                            <input type="hidden" asp-for="UUID" />
                            <input type="hidden" asp-for="IsActive" />

                            <div class="row align-items-center">
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="Title"
                                                label="Honorific Title"
                                                type="Text"
                                                required="true" />
                                </div>
                                <div class="col-lg-9 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("MasterViewHonorific", "Master")" />
                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>

                            </div>
                        </form>


                    </div><!--end card-body-->
                </div><!--end card-->

            </div><!--end row-->



        </div><!-- container -->
        <!-- Timer -->
        <partial name="_Timer" />

<!-- end page-wrapper -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
}