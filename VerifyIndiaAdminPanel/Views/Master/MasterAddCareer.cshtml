@using Upgrow.Application.Common.Dropdowns
@using UpgrowAdminPanel
@using UpgrowAdminPanel.Models
@model UpgrowAdminPanel.Models.Master.MasterCareerVM
@{
    var isEdit = Model?.Career != null && !string.IsNullOrEmpty(Model.Career.UUID);
    ViewData["Title"] = isEdit ? "Edit Career" : "Add Career";
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20"> @ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddCareer" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Career.UUID" />
                    <input type="hidden" asp-for="Career.IsActive" />
                    <input type="hidden" asp-for="Career.IconImage" value="@(Model?.Career.IconImage ?? string.Empty)" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.Name"
                                        label="Post Name"
                                        type="Text"
                                        required="true" />
                        </div>


                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.DepartmentUUID"
                                        label="Department"
                                        type="Select"
                                        asp-items="@Model.Department"
                                        required="true"
                                        placeholder="Select Department" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.Image"
                                        label="Image/Icon"
                                        type="File"
                                        accept=".jpg,.jpeg,.png" 
                                        required="@(string.IsNullOrEmpty(Model?.Career.IconImage))"
                                        view-link-path="@Model?.Career.ImageUrlwithdomain" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.Experience"
                                        label="Experience"
                                        type="Text"
                                        required="false" />
                        </div>
                        <div class="col-lg-3 col-md-3 col-sm-6 col-12">
                            <form-field asp-for="Career.SkillsUUID"
                                        label="Skills"
                                        type="Select"
                                        asp-items="@Model.Skills"
                                        placeholder="-- Select Skills --"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.JobTypeUUID"
                                        label="Department"
                                        type="Select"
                                        asp-items="@Model.JobType"
                                        placeholder="-- Job Type --"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-3 col-12">

                            <dependent-dropdown asp-for="Career.CountryUUID"
                                                label="Country Name"
                                                key="@DropdownKey.Country"
                                                required="true"
                                                placeholder="- Select Country -" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-3 col-12">
                            <dependent-dropdown asp-for="Career.StateUUID"
                                                label="State Name"
                                                key="@DropdownKey.State"
                                                parent="@DropdownKey.Country"
                                                required="true"
                                                placeholder="- Select State -" />

                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-3 col-12">
                            <dependent-dropdown asp-for="Career.CityUUID"
                                                label="City Name"
                                                key="@DropdownKey.City"
                                                parent="@DropdownKey.State"
                                                required="true"
                                                placeholder="- Select City -" />

                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.NumberOfPosition"
                                        label="No Of Position"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-6 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Career.ShortDescription"
                                        label="Role Overview"
                                        type="TextArea"
                                        required="true" />
                        </div>
                        <div class="col-lg-12 col-sm-6 col-xs-12 pt-3">
                            <form-field asp-for="Career.LongDescription"
                                        label="Description"
                                        type="CKEditor"
                                        required="true" />
                        </div>

                        <div class="col-lg-12 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewCareer", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts
{
    <script src="~/ckeditor/ckeditor/ckeditor.js"></script>
    <script>
        // Keep your existing initialization script (unchanged)
                  function initializeForm() {
            if (typeof jQuery === 'undefined') {
                setTimeout(initializeForm, 100);
                return;
            }
            if (typeof CKEDITOR !== 'undefined') {
                document.querySelectorAll('.ckeditor-textarea').forEach(function (textarea) {
                    if (!CKEDITOR.instances[textarea.id]) {
                        var editor = CKEDITOR.replace(textarea.id, {
                            extraAllowedContent: 'div(*)[*]{*}; span(*)[*]{*}; p(*)[*]{*};',
                            allowedContent: true,
                            height: 300,
                            toolbar: [
                                { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                                { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                                '/',
                                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote'] },
                                { name: 'links', items: ['Link', 'Unlink'] },
                                { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                                '/',
                                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                                { name: 'colors', items: ['TextColor', 'BGColor'] }
                            ]
                        });

                        editor.on('change', function () {
                            editor.updateElement();
                        });
                    }
                });
            }
        }

                document.addEventListener('DOMContentLoaded', initializeForm);
                if (typeof jQuery !== 'undefined') {
                    jQuery(document).ready(function () {
                        initializeForm();

                        // Tell jQuery Validate to ignore nothing, so it can see the hidden textarea
                        if ($.validator) {
                            $.validator.setDefaults({
                                ignore: []
                            });
                        }
                    });
                }
    </script>
    <script src="~/assets/js/notification.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/dp-dropdown.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}