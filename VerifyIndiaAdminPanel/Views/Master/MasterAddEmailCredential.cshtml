@using UpgrowAdminPanel
@using UpgrowAdminPanel.Models
@using static VerifyIndia.Application.Constants
@model VerifyIndia.Application.Commands.Master.MasterEmailCredentialCommand
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.UUID) ? "Add Email Credential" : "Edit Email Credential";
}

        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="row mt-2">

                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                            </div><!--end col-->

                        </div> <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                    <form autocomplete="off" id="bannerForm" asp-action="MasterAddEmailCredential" method="post">
                            <input type="hidden" asp-for="UUID" />
                            <input type="hidden" asp-for="IsActive" />
                            <input type="text"
                                   autocomplete="username"
                                   style="display:none">

                            <input type="password"
                                   autocomplete="current-password"
                                   style="display:none">
                            <div class="row align-items-center">
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="EmailAddress"
                                                label="Email Address"
                                                type="Text"
                                                required="true" />
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="Password"
                                        label="Password"
                                        type="Password"
                                        required="@string.IsNullOrEmpty(Model.UUID)" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="HostServiceProvider"
                                                label="Host/Service Provider"
                                                type="Text"
                                                required="true" />
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="SMTP"
                                                label="SMTP Server"
                                                type="Text"
                                                required="true" />
                                </div>
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="Port"
                                                label="Port"
                                                type="Number"
                                                required="true" />
                                </div>

                                <div class="col-lg-9 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("MasterViewEmailCredential", "Master")" />
                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>

                            </div>
                        </form>


                    </div><!--end card-body-->
                </div><!--end card-->

            </div><!--end row-->



        </div><!-- container -->
        <!-- Timer -->
        <partial name="_Timer" />
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
     <script>
        (function () {
            const form = document.getElementById("bannerForm");
            if (!form) return;

            const portInput = form.querySelector("#Port");
            if (!portInput) return;

            portInput.addEventListener("keydown", function (e) {
                const blockedKeys = ["e", "E", "+", "-", "."];
                if (blockedKeys.includes(e.key)) {
                    e.preventDefault();
                    return;
                }

                const allowedControlKeys = [
                    "Backspace", "Delete", "ArrowLeft", "ArrowRight",
                    "ArrowUp", "ArrowDown", "Tab", "Home", "End"
                ];

                if (
                    !allowedControlKeys.includes(e.key) &&
                    !(e.ctrlKey || e.metaKey) &&
                    !/^\d$/.test(e.key)
                ) {
                    e.preventDefault();
                }
            });

            portInput.addEventListener("input", function () {
                this.value = (this.value || "").replace(/\D/g, "");
            });

            portInput.addEventListener("paste", function (e) {
                e.preventDefault();
                const text = (e.clipboardData || window.clipboardData).getData("text") || "";
                const digitsOnly = text.replace(/\D/g, "");
                document.execCommand("insertText", false, digitsOnly);
            });
        })();

        const MASKED_SECRET = '@SecretMaskConstants.MaskedSecretValue';

         $(document).ready(function () {
             const isEdit = $("#UUID").val() !== "";

             if (isEdit) {
                 $("#Password").val(MASKED_SECRET);
                 $("#Password").data("unchanged", true);
             }
         });
    </script>
     <script>
                $(document).on("click", ".password-toggle", function () {

            const input = $(this).siblings("input");

            if (input.attr("type") === "password") {
                input.attr("type", "text");
                $(this).find("i")
                    .removeClass("fa-eye")
                    .addClass("fa-eye-slash");
            }
            else {
                input.attr("type", "password");
                $(this).find("i")
                    .removeClass("fa-eye-slash")
                    .addClass("fa-eye");
            }

        });
     </script>
}