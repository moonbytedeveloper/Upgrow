@model VerifyIndiaAdminPanel.Models.Master.ProviderApisVM

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.ProviderApi?.UUID);
    var pageTitle = isEditMode ? "Edit Provider API" : "Add Provider API";
    ViewData["Title"] = pageTitle;
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddProviderApis" method="post">
                    <input type="hidden" asp-for="ProviderApi.UUID" />
                    <input type="hidden" asp-for="ProviderApi.IsActive" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ProviderApi.ProviderUUID"
                                        label="Provider"
                                        type="Select"
                                        required="true"
                                        asp-items="Model?.ProviderList">
                                <option value="">-- Select Provider --</option>
                            </form-field>
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="ProviderApi.ApiUUID"
                                        label="API"
                                        type="Select"
                                        required="true"
                                        asp-items="Model?.ApiList">
                                <option value="">-- Select API --</option>
                            </form-field>
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewProviderApis", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>
                    </div>
                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
}