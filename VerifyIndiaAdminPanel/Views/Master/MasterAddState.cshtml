@model VerifyIndiaAdminPanel.Models.Master.MasterStateVM

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.State?.UUID);
    var pageTitle = isEditMode ? "Edit State" : "Add State";
    ViewData["Title"] = pageTitle;
}
@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddState" method="post">
                    <input type="hidden" asp-for="State.UUID" />
                    <input type="hidden" asp-for="State.IsActive" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-3 col-sm-3 col-12">
                            <form-field asp-for="State.CountryUUID"
                                        label="Country Title"
                                        type="Select"
                                        asp-items="@Model.CountryList"
                                        required="true"
                                        placeholder="Select Country" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="State.Title"
                                        label="State Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="State.ShortTitle"
                                        label="State Short Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewState", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->



</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
}

