@model VerifyIndia.Application.Commands.Master.MasterBlogCategoryCommand
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.UUID) ? "Add Website Blog Category" : "Edit Website Blog Category";
}


        <div class="container-fluid">
            <!-- Page-Title -->
            <!-- end page title end breadcrumb -->
            <!-- end page title end breadcrumb -->
            <div class="row mt-2">

                <div class="card">
                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                                <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                            </div><!--end col-->

                        </div> <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                        <form id="bannerForm" asp-action="MasterAddBlogCategory" enctype="multipart/form-data">
                            <input type="hidden" asp-for="UUID" />
                           
                            <input type="hidden" asp-for="IsActive" />

                            <div class="row align-items-center">
                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="Title" label="Blog category title" type="Text" required="true">
                                    </form-field>
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">

                            <form-field asp-for="ImageUrl"
                                        label="Icon (fab fa-instagram)"
                                        type="Text"
                                        required="true" />

                        </div>
                               
                                <div class="col-lg-6 col-md-6 col-sm-12 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("MasterViewBlogCategory", "Master")" />
                                    <form-button label="Submit"
                                                 type="Submit" />

                                </div>

                            </div>
                        </form>


                    </div><!--end card-body-->
                </div><!--end card-->

            </div><!--end row-->



        </div><!-- container -->
        <!-- Timer -->
        <partial name="_Timer" />



@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
}