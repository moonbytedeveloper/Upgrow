@model VerifyIndia.Application.Commands.Master.MasterTestimonialCommand

@{
    var isEdit = Model != null && !string.IsNullOrEmpty(Model.UUID);
    ViewData["Title"] = isEdit ? "Edit Testimonial" : "Add Testimonial";
}

<div class="container-fluid">

    <div class="row mt-2">

        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div>
                </div>
            </div>

            <div class="card-body pt-0">

                <form id="bannerForm" asp-action="MasterAddTestimonial" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="hidden" asp-for="FilePath" value="@(Model?.FilePath ?? string.Empty)" />

                    <div class="row">

                        
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="CustomerName"
                                        label="Customer Name"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="CompanyName"
                                        label="Company Name"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Star"
                                        label="Star Rating"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SequenceNo"
                                        label="Display Sequence"
                                        type="Number"
                                        required="true"
                                        min="0"
                                        max="99" />
                        </div>

                        
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Comment"
                                        label="Customer Comment"
                                        type="TextArea"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Image"
                                        label="Customer Image"
                                        type="File"
                                        accept=".jpg,.jpeg,.png"
                                        required="@(string.IsNullOrEmpty(Model?.FilePath))"
                                        view-link-path="@Model?.FilePath" />
                        </div>

                        <div class="col-lg-3 text-end pt-4">

                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewTestimonial", "Master")" />

                            <form-button label="Submit"
                                         type="Submit" />

                        </div>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

<partial name="_Timer" />

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/notification.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const starInput = document.querySelector('[name="Star"]');
            const seqInput = document.querySelector('[name="SequenceNo"]');

            if (starInput) {
                starInput.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, '').slice(0, 1);
                });
            }

            if (seqInput) {
                seqInput.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, '').slice(0, 2);
                });
            }

        });
    </script>
}