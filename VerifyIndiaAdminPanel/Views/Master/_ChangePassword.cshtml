@model VerifyIndiaAdminPanel.Models.Master.ChangePasswordVM
@{
    ViewData["Title"] = "Change Password";
}
<style>
    #passwordPolicyList li {
        color: #dc3545 !important; /* default = red (invalid) */
        transition: all 0.2s ease;
    }

        /* VALID */
        #passwordPolicyList li.valid {
            color: #198754 !important;
            font-weight: 500;
        }

        /* INVALID */
        #passwordPolicyList li.invalid {
            color: #dc3545 !important;
            font-weight: 500;
        }

        /* NEUTRAL (rule not enabled) */
        #passwordPolicyList li.neutral {
            color: #6c757d !important;
            font-style: italic;
        }
</style>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0">@ViewData["Title"]</h5>
    </div>
    <div class="card-body">
        <form id="bannerForm" asp-controller="Master" asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UUID" />

            <form-field asp-for="CurrentPassword" label="Current Password" type="Password" required="true" />
            <form-field asp-for="NewPassword" label="New Password" type="Password" required="true" />
            <form-field asp-for="ConfirmPassword" label="Confirm Password" type="Password" required="true" />
            <form-field asp-for="Reason" label="Reason" type="TextArea" required="true" />


            <div class="text-end mt-3">
                <button id="btnChangePassword" type="submit" class="btn btn-primary btn-round theme-submit-button">
                    Change Password
                </button>
            </div>
            <div id="passwordPolicyBox" class="mt-2 small">
                @if (Model.PasswordPolicy != null)
                {
                    <ul class="mb-0 ps-3" id="passwordPolicyList">

                        <li id="rule-minlength"
                            data-rule="minLength">
                            Minimum length: @Model.PasswordPolicy.MinLength
                        </li>
                        @if (Model.PasswordPolicy.UpperCase == true)
                        {
                            <li id="rule-uppercase" data-rule="uppercase">
                                At least one uppercase (A-Z)
                            </li>
                        }

                        @if (Model.PasswordPolicy.LowerCase == true)
                        {
                            <li id="rule-lowercase" data-rule="lowercase">
                                At least one lowercase (a-z)
                            </li>
                        }

                        @if (Model.PasswordPolicy.AllowDigit == true)
                        {
                            <li id="rule-digit" data-rule="digit">
                                At least one number (0-9)
                            </li>
                        }

                        @if (Model.PasswordPolicy.AllowSpecialChar == true)
                        {
                            <li id="rule-special" data-rule="special">
                                At least one special (@Model.PasswordPolicy.SpecialCharacters)
                            </li>
                        }

                    </ul>
                }
            </div>
        </form>
    </div>
</div>

    <!-- ✅ LIVE PASSWORD VALIDATION SCRIPT -->
<script>
    $(document).on('input', '#NewPassword', function () {
        checkPasswordPolicy(this.value || '');
    });

    $(document).ready(function () {
        checkPasswordPolicy($('#NewPassword').val() || '');
    });

    const policy = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        minLength = Model.PasswordPolicy?.MinLength ?? 0,
        upper = Model.PasswordPolicy?.UpperCase == true,
        lower = Model.PasswordPolicy?.LowerCase == true,
        digit = Model.PasswordPolicy?.AllowDigit == true,
        special = Model.PasswordPolicy?.AllowSpecialChar == true,
        specialChars = Model.PasswordPolicy?.SpecialCharacters ?? ""
    }));

    function checkPasswordPolicy(password) {

        // Length rules (always active)
        applyRule("rule-minlength", true, password.length >= policy.minLength);

        // Uppercase
        applyRule(
            "rule-uppercase",
            policy.upper,
            /[A-Z]/.test(password)
        );

        // Lowercase
        applyRule(
            "rule-lowercase",
            policy.lower,
            /[a-z]/.test(password)
        );

        // Digit
        applyRule(
            "rule-digit",
            policy.digit,
            /\d/.test(password)
        );

        // Special character (SAFE regex)
        const specialRegex = new RegExp("[" +
            policy.specialChars.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&') +
        "]");

        applyRule(
            "rule-special",
            policy.special,
            specialRegex.test(password)
        );
    }

    function applyRule(id, isEnabled, isValid) {
        const el = document.getElementById(id);
        if (!el) return;

        el.classList.remove("valid", "invalid", "neutral");

        if (!isEnabled) {
            el.classList.add("neutral");
            return;
        }

        el.classList.add(isValid ? "valid" : "invalid");
    }
</script>