@model VerifyIndia.Application.Commands.Master.MasterDosDontsCommand
@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.UUID);
    var pageTitle = isEditMode ? "Edit DO'S & DON'TS" : "Add DO'S & DON'TS";
    ViewData["Title"] = pageTitle;
    // Create dropdown items for DO'S/DON'TS
    var dosDontsItems = new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
    {
        new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = "DO'S", Value = "true", Selected = Model?.IsDos == true },
        new Microsoft.AspNetCore.Mvc.Rendering.SelectListItem { Text = "DON'TS", Value = "false", Selected = Model?.IsDos == false }
    };
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->

            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddDosDonts" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row align-items-center">
                        <div class="col-lg-6 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Message"
                                        label="Message"
                                        type="TextArea"
                                        required="true"
                                         />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="IsDos"
                                        label="Select Type"
                                        type="Select"
                                        asp-items="@dosDontsItems"
                                        required="true" />
                        </div>

                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SequenceNo"
                                        label="Sequence Number"
                                        type="Number"
                                        required="true" />
                        </div>

                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewDosDonts", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>
            </div><!--end card-body-->

        </div><!--end card-->

    </div><!--end row-->

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
}