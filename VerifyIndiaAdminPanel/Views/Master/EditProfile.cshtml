@model VerifyIndiaAdminPanel.Models.Master.ProfileVM

@{
    var isEdit = !string.IsNullOrEmpty(Model?.UUID);
    ViewData["Title"] = "Edit Profile";
}
@section Styles {
    <link href="~/assets/css/datepicker.css" rel="stylesheet" type="text/css" />

}
<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">

            <!-- Header -->
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="EditProfile" method="post" enctype="multipart/form-data">

                    <!-- Hidden Fields -->
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="Profile_URL" />

                    <div class="row align-items-end">

                        <!-- Profile Image -->
                        <div class="col-lg-3">

                            @if (isEdit && !string.IsNullOrEmpty(Model.Profile_URL))
                            {
                                <div class="mt-3 text-center">
                                    <img src="@Model.ProfileUrlwithdomain"
                                         alt="Profile"
                                         style="height:120px;width:120px;object-fit:cover;border-radius:10px;border:1px solid #ddd;" />
                                </div>
                            }

                            <form-field asp-for="Profile"
                                        label="Profile Pic"
                                        type="File"
                                        required="@(string.IsNullOrEmpty(Model.Profile_URL))" />
                        </div>

                        <!-- Form Fields -->
                        <div class="col-lg-9">
                            <div class="row">

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="FirstName"
                                                label="First Name"
                                                type="Text"
                                                required="true" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="LastName"
                                                label="Last Name"
                                                type="Text"
                                                required="true" />
                                </div>

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="BirthDate"
                                                label="Birth Date"
                                                type="Date" />
                                </div>
                                <div class="col-3 text-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("Index", "Dashboard")" />

                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        

                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/customdate.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/moment.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>

}