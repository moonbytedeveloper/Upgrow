@model VerifyIndia.Application.Commands.Master.PasswordPolicyCommand;
@{
    ViewData["Title"] = "Update Password Policy";
}
<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20"> @ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm"
                      asp-action="UpdatePasswordPolicy"
                      method="post"
                      enctype="multipart/form-data">

                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />

                    <div class="row">

                        <div class="col-lg-2">
                            <form-field asp-for="MinLength"
                                        label="Min Length"
                                        type="Number"
                                        required="true" />
                        </div>

                        <div class="col-lg-2 pt-4">
                            <form-field asp-for="UpperCase"
                                        label="Is Upper Case Allowed"
                                        type="Checkbox" />
                        </div>

                        <div class="col-lg-2 pt-4">
                            <form-field asp-for="LowerCase"
                                        label="Is Lower Case Allowed"
                                        type="Checkbox" />
                        </div>

                        <div class="col-lg-2 pt-4">
                            <form-field asp-for="AllowDigit"
                                        label="Is Digit Allowed"
                                        type="Checkbox" />
                        </div>

                        <div class="col-lg-2 pt-4">
                            <form-field asp-for="AllowSpecialChar"
                                        label="Is Special Character Allowed"
                                        type="Checkbox" />
                        </div>

                        <div class="col-lg-2" id="specialCharBox">
                            <form-field asp-for="SpecialCharacters"
                                        label="Special Characters"
                                        type="Text"
                                        required="true" />
                        </div>

                        <div class="col-lg-10 pt-4 text-end" id="updateBtnCol">
                            <form-button label="Update" type="Submit" />
                        </div>

                    </div>

                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script>
               $(document).ready(function () {

            function toggleSpecialCharBox() {
                var isChecked = $('#AllowSpecialChar').is(':checked');

                if (isChecked) {
                    $('#specialCharBox').show();
                    $('#updateBtnCol')
                        .removeClass('col-lg-12')

                } else {
                    $('#specialCharBox').hide();
                    $('#updateBtnCol')
                        
                }
            }

            // On load
            toggleSpecialCharBox();

            // On change
            $('#AllowSpecialChar').change(function () {
                toggleSpecialCharBox();
            });

        });
    </script>
}
