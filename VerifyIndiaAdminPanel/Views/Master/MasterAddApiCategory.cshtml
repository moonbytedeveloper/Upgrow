@model VerifyIndia.Application.Commands.Master.MasterApiCategoryCommand

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.UUID);
    var pageTitle = isEditMode ? "Edit API Category" : "Add API Category";
    ViewData["Title"] = pageTitle;
}
<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@pageTitle</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddApiCategory" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                            <form-field asp-for="CategoryName"
                                        label="Category Name"
                                        type="Text"
                                        required="true" />
                        </div>

                <div class="col-lg-3 col-md-3 col-sm-12 col-12">
                    <form-field asp-for="SequenceNo"
                                label="Sequence No"
                                type="Text"
                                required="true" />
                </div>
                        <div class="col-lg-3 col-md-6 col-sm-12 col-12">
                            <form-field asp-for="Icon"
                                        label="Icon (fab fa-instagram)"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewApiCategory", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>
                </div>
                </div>
                </div>
                </div>
<!-- end page-wrapper -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
}