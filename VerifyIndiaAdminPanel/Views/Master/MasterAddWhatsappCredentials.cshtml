@using static VerifyIndia.Application.Constants
@model VerifyIndia.Application.Commands.Master.CredentialsWhatsappCommand

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.UUID) ? "Add WhatsApp Credentials" : "Edit WhatsApp Credentials";
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form autocomplete="off" id="bannerForm" asp-action="AddEditWhatsappCredentials" method="post">
                    <input type="hidden" asp-for="UUID" />
                    <input type="hidden" asp-for="IsActive" />
                    <input type="text"
                           autocomplete="username"
                           style="display:none">

                    <input type="password"
                           autocomplete="current-password"
                           style="display:none">
                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="APIKey"
                                        label="API Key"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="AccessToken"
                                        label="Access Token"
                                        type="Password"
                                        required="@string.IsNullOrEmpty(Model.UUID)" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="MobileNo"
                                        label="Mobile No"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="SenderName"
                                        label="Sender Name"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterWhatsappCredentials", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>
                    </div>
                </form>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->
</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts{
<partial name="_ValidationScriptsPartial" />
<script src="~/assets/js/validationanimation.js"></script>
 <script>
   const MASKED_SECRET = '@SecretMaskConstants.MaskedSecretValue';

        $(document).ready(function () {
            const isEdit = $("#UUID").val() !== "";

            if (isEdit) {
                $("#AccessToken").val(MASKED_SECRET);
                $("#AccessToken").data("unchanged", true);
            }
        });
</script>

    <script>
                $(document).on("click", ".password-toggle", function () {

            const input = $(this).siblings("input");

            if (input.attr("type") === "password") {
                input.attr("type", "text");
                $(this).find("i")
                    .removeClass("fa-eye")
                    .addClass("fa-eye-slash");
            }
            else {
                input.attr("type", "password");
                $(this).find("i")
                    .removeClass("fa-eye-slash")
                    .addClass("fa-eye");
            }

        });
    </script>
}