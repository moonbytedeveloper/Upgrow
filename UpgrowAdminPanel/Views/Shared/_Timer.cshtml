<style>
    #auditLogsSidebar {
        width: 55%;
        z-index: 1055;
    }

    #activityLogSidebar {
        width: 55%;
        z-index: 1055;
    }

    #activityLogButton {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        color: #000000 !important;
    }

        #activityLogButton #activityLogo,
        #activityLogButton #activityLogo::before,
        #activityLogButton .fa-history,
        #activityLogButton .fa-history::before {
            color: #000000 !important;
        }

        #activityLogButton:hover {
            color: #ffffff !important;
        }

            #activityLogButton:hover #activityLogo,
            #activityLogButton:hover #activityLogo::before,
            #activityLogButton:hover .fa-history,
            #activityLogButton:hover .fa-history::before {
                color: #ffffff !important;
            }

</style>

<div class="offcanvas offcanvas-end" tabindex="-1" id="auditLogsSidebar" aria-labelledby="auditLogsSidebarLabel">
    <div class="offcanvas-header text-white" style="background: linear-gradient(90deg, #111827 0%, #0f172a 100%);">
        <h5 class="offcanvas-title" id="auditLogsSidebarLabel" style="color: white;">
            <i class="fa fa-history me-2"></i>Audit Logs
        </h5>
        <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
        <!-- DataTables controls (Show X entries, Search) -->
        <div class="row mb-3">
            <div class="col-sm-6">
                <div id="auditLogsInfo"></div>
            </div>
            <div class="col-sm-6 text-end">
                <div id="auditLogsFilter"></div>
            </div>
        </div>

        <!-- Table -->
        <div class="border rounded">
            <table class="table table-sm table-bordered align-middle mb-0" id="auditLogsTable">
                <thead class="table-light">
                    <tr>
                        <th style="width: 24%">Date</th>
                        <th style="width: 14%">Action</th>
                        <th style="width: 32%">User</th>
                        <th style="width: 18%">IP</th>
                        <th style="width: 12%">View</th>
                    </tr>
                </thead>
                <tbody id="auditLogsBody">
                    <tr><td colspan="5" class="text-center text-muted">No logs found.</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div id="auditLogsPagination" class="mt-3"></div>
    </div>
</div>

<div class="modal fade" id="auditChangesModal" tabindex="-1" aria-labelledby="auditChangesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: linear-gradient(90deg, #111827 0%, #0f172a 100%);">
                <h5 class="modal-title" id="auditChangesModalLabel">
                    <i class="fa fa-exchange-alt me-2"></i>Field Changes
                </h5>
                <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div id="auditChangesMeta" class="alert alert-secondary py-2 mb-3 d-none"></div>

                <div id="auditChangesLoader" class="text-center py-3 d-none">
                    <div class="spinner-border text-primary"></div>
                </div>

                <div class="table-responsive border rounded">
                    <table class="table table-sm table-bordered align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 25%">Field</th>
                                <th style="width: 37%">Old Value</th>
                                <th style="width: 38%">New Value</th>
                            </tr>
                        </thead>
                        <tbody id="auditChangesBody">
                            <tr><td colspan="3" class="text-center text-muted">No field-level changes.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-light px-5 border" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@* Global Activity Log Sidebar + Button (used by DataTables-based logs) *@
<div class="offcanvas offcanvas-end" tabindex="-1" id="activityLogSidebar" aria-labelledby="activityLogTitle">
    <div class="offcanvas-header text-white" style="background: linear-gradient(90deg, #111827 0%, #0f172a 100%);">
        <h5 class="offcanvas-title" id="activityLogTitle" style="color: #fff;">Master Gender Activity Logs</h5>
        <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div class="table-responsive border rounded">
            <table class="table table-bordered table-hover table-sm" id="activityLogTable">
                <thead class="thead-light">
                    <tr>
                        <th style="width: 150px;">Date</th>
                        <th style="width: 150px;">User Name</th>
                        <th style="width: 100px;">Activity</th>
                        <th style="width: 250px;">Description</th>
                        <th style="width: 200px;">Page URL</th>
                        <th style="width: 120px;">IP Address</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<button type="button"
        class="btn btn-primary btn-round theme-add-button ms-2 d-none"
        id="activityLogButton"
        data-bs-toggle="offcanvas"
        data-bs-target="#activityLogSidebar"
        aria-controls="activityLogSidebar"
        style="background-color: #ffffff; border: 1px solid #ced4da;">
    <i class="fa fa-history me-1" id="activityLogo"></i> Activity Logs
</button>