@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    var antiForgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<style>
    #loginLogoutLogsSidebar {
        width: min(860px, 100vw);
        z-index: 1055;
    }
</style>

<div class="offcanvas offcanvas-end" tabindex="-1" id="loginLogoutLogsSidebar" aria-labelledby="loginLogoutLogsSidebarLabel">
    <div class="offcanvas-header text-white" style="background: linear-gradient(90deg, #111827 0%, #0f172a 100%);">
        <h5 class="offcanvas-title" id="loginLogoutLogsSidebarLabel" style="color: white;">
            <i class="fa fa-user-shield me-2"></i>Login/Logout Logs
        </h5>
        <button type="button" class="btn-close btn-close-white opacity-75" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>

    <div class="offcanvas-body">
        <!-- Hidden form fields for anti-forgery + userUuid -->
        <form id="loginLogoutLogsForm">
            <input type="hidden" name="__RequestVerificationToken" value="@antiForgeryToken" />
            <input type="hidden" id="loginLogoutLogsUserUuid" name="userUuid" value="" />
        </form>

        <div class="table-responsive">
            <table id="loginLogoutLogsTable" class="table table-sm table-bordered align-middle mb-0 w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width: 24%">Date</th>
                        <th style="width: 15%">UserName</th>
                        <th style="width: 14%">Activity</th>
                        <th style="width: 15%">IP</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="loginLogoutLogsLoader" class="text-center py-3 d-none">
            <div class="spinner-border text-primary"></div>
        </div>
    </div>
</div>

<script>
    window.LoginLogoutLogsUI = (function () {
        let sidebar;
        let table;
        let currentUserUuid = null;

        function initDataTable() {
            if ($.fn.DataTable.isDataTable('#loginLogoutLogsTable')) {
                table = $('#loginLogoutLogsTable').DataTable();
                return;
            }

            table = $('#loginLogoutLogsTable').DataTable({
                processing: true,
                serverSide: true,
                paging: true,
                searching: true,
                lengthChange: true,
                pageLength: 10,
                order: [[0, 'desc']], // default: date desc
                ajax: {
                    url: '@Url.Action("GetLoginLogoutLogs", "Auth")',
                    type: 'POST',
                    data: function (d) {
                        d.userUuid = $('#loginLogoutLogsUserUuid').val();
                        d.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]', '#loginLogoutLogsForm').val();
                    }
                },
                columns: [
                    { data: 'date', name: 'date' },
                    { data: 'user', name: 'user' },
                    { data: 'activity', name: 'activity' },
                    { data: 'ip', name: 'ip' }
                ]
            });
        }

        function open(userUuid) {
            if (!sidebar) {
                const el = document.getElementById('loginLogoutLogsSidebar');
                sidebar = bootstrap.Offcanvas.getOrCreateInstance(el);
            }

            currentUserUuid = userUuid || '';
            $('#loginLogoutLogsUserUuid').val(currentUserUuid);

            initDataTable();

            sidebar.show();
            table.ajax.reload();
        }

        return { open };
    })();
</script>