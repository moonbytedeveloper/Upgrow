@model UpgrowAdminPanel.Models.Master.MasterBlogVM
@{
    var isEditMode = !string.IsNullOrEmpty(Model?.Command?.UUID);
    ViewData["Title"] = isEditMode ? "Edit Website Blog" : "Add Website Blog";
}

@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}
@section Styles {
    <link href="~/assets/css/datepicker.css" rel="stylesheet" type="text/css" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <!-- end page title end breadcrumb -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddBlog" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Command.UUID" />
                    <input type="hidden" asp-for="Command.BlogImageUrl" value="@Model.Command.BlogImageUrl" />
                    <input type="hidden" asp-for="Command.BannerImageUrl" value="@Model.Command.BannerImageUrl" />
                    <input type="hidden" asp-for="Command.IsActive" />

                    <div class="row align-items-center">
                        <!-- Blog Category Dropdown -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.BlogCategoryUUID"
                                        label="Select blog category"
                                        type="Select"
                                        asp-items="@Model.BlogCategories"
                                        required="true">
                            </form-field>
                        </div>

                        <!-- Blog Title -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.Title"
                                        label="Blog title"
                                        type="Text"
                                        required="true">
                            </form-field>
                        </div>

                        <!-- Blog Date -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.BlogDate"
                                        label="Blog date"
                                        max-date-today="true"
                                        required="true"
                                        type="Date">
                            </form-field>
                        </div>

                        <!-- Blog Image -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.BlogImageFile"
                                        label="Blog image"
                                        view-link-path="@Model.Command.BlogUrlwithdomain"
                                        type="File"
                                        accept=".jpg,.jpeg,.png"
                                        required="@(string.IsNullOrEmpty(Model.Command.BlogImageUrl))">
                            </form-field>
                        </div>

                        <!-- Blog Banner Image -->
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.BannerImageFile"
                                        view-link-path="@Model.Command.BannerUrlwithdomain"
                                        label="Blog banner image"
                                        type="File"
                                        accept=".jpg,.jpeg,.png"
                                        required="@(string.IsNullOrEmpty(Model.Command.BannerImageUrl))">
                            </form-field>
                        </div>

                        <!-- Short Description -->
                        <div class="col-lg-6 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="Command.ShortDescription"
                                        label="Blog short description"
                                        required="true"
                                        type="TextArea">
                            </form-field>
                        </div>

                        <!-- Full Description (CKEditor) -->
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12">
                            <form-field asp-for="Command.FullDescription"
                                        label="Blog full description"
                                        required="true"
                                        type="CKEditor">
                            </form-field>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="col-lg-12 col-md-12 col-sm-12 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("MasterViewBlog", "Master")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>
            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts
{

    <script src="~/ckeditor/ckeditor/ckeditor.js"></script>
    <script>
        // Keep your existing initialization script (unchanged)
                 function initializeForm() {
            if (typeof jQuery === 'undefined') {
                setTimeout(initializeForm, 100);
                return;
            }
            if (typeof CKEDITOR !== 'undefined') {
                document.querySelectorAll('.ckeditor-textarea').forEach(function (textarea) {
                    if (!CKEDITOR.instances[textarea.id]) {
                        var editor = CKEDITOR.replace(textarea.id, {
                            extraAllowedContent: 'div(*)[*]{*}; span(*)[*]{*}; p(*)[*]{*};',
                            allowedContent: true,
                            height: 300,
                            toolbar: [
                                { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                                { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                                '/',
                                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote'] },
                                { name: 'links', items: ['Link', 'Unlink'] },
                                { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                                '/',
                                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                                { name: 'colors', items: ['TextColor', 'BGColor'] }
                            ]
                        });

                        editor.on('change', function () {
                            editor.updateElement();
                        });
                    }
                });
            }
        }

                document.addEventListener('DOMContentLoaded', initializeForm);
                if (typeof jQuery !== 'undefined') {
                    jQuery(document).ready(function () {
                        initializeForm();

                        // Tell jQuery Validate to ignore nothing, so it can see the hidden textarea
                        if ($.validator) {
                            $.validator.setDefaults({
                                ignore: []
                            });
                        }
                    });
                }
    </script>

    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/customdate.js"></script>
    <script src="~/assets/js/custom.js"></script>
    <script src="~/assets/js/moment.js"></script>
    <script src="~/assets/js/bootstrap-datetimepicker.min.js"></script>
    <script src="~/assets/js/select2.min.js"></script>
    <script src="~/assets/js/select-clear.js"></script>
    <script src="~/assets/js/notification.js"></script>
}