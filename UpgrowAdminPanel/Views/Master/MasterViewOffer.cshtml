
@{
    ViewData["Title"] = "Master View Offer";
}
@section Styles {
    <partial name="_ViewStyles" />
}
<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-9">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->
                    <div class="col-3 text-end">
                        <form-button label="Add Offer"
                                     type="Add"
                                     url="@Url.Action("MasterAddOffer", "Master")">
                        </form-button>

                    </div>
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr. No</th>
                                <th style="display:none;">UUID</th>
                                <th>Name</th>
                                <th>Offer Code</th>
                                <th>Offer Type</th>
                                <th>Description</th>
                                <th>Offer Value</th>
                                <th>Min Order Amount</th>
                                <th>Min Discount Amount</th>
                                <th>Valid From</th>
                                <th>ValidTo</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>

                </div>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editOfferLink" label="Edit Offer Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
            initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetOffers", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'name' },
                { data: 'offerCode' },
                { data: 'offerType' },
                { data: 'description',orderable: false },
                { data: 'offerValue' },
                { data: 'minOrderAmount' },
                { data: 'maxDiscountAmount' },
                { data: 'validFrom'},
                { data: 'validTo'},
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editOfferLink',
                    baseUrl: '@Url.Action("MasterEditOffer", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Master_Offer", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            friendlyFieldMap: {
                "Name": " Name",
                "OfferCode": "OfferCode",
                "Description": "Description",
                "OfferValue": "OfferValue",
                "MinOrderAmount": "MinOrderAmount",
                "MaxDiscountAmount": "MaxDiscountAmount",
                "ValidFrom": "ValidFrom",
                "ValidTo": "ValidTo"
            }
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Offer' });
    </script>
}
