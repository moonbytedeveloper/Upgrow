@{
    ViewData["Title"] = "View City";
}
@section Styles {
    <partial name="_ViewStyles" />
}


<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">View City</h3>
                </div><!--end col-->
                <div class="col-3 text-align-end">
                    <form-button label="Add City"
                                 type="Add"
                                 url="@Url.Action("MasterEditCity", "Master")">
                    </form-button>
                    
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Country Title</th>
                            <th>State Title</th>
                            <th>City Title</th>
                            <th>City Short Title</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>            
            <action-link id="editCityLink" label="Edit City Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        const genderTable = initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetCity", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                 { data: 'country' },
                 { data: 'state' },
                { data: 'name' },
                { data: 'shortname' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editCityLink',
                    baseUrl: '@Url.Action("MasterEditCity", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                        {
            selector: '#viewHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Master_City", rowData.uuid, false, "");
            }
        }
            ]
        });
                AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
                "CountryUUID": "/Common/GetCountryName",
                "StateUUID": "/Common/GetStateName"
            },
            friendlyFieldMap: {
                "Title": "City Title",
                "ShortTitle": "Short Name",
                "CountryUUID": "Country",
                "StateUUID": "State"
            },
            hiddenFields: [
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_City' });
    </script>
}