@{
    ViewData["Title"] = "View Website Blogs";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-3 text-align-end">
                    <form-button label="Add Blog"
                                 type="Add"
                                 url="@Url.Action("MasterAddBlog", "Master")">
                    </form-button>
                   
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Blog Category</th>
                            <th>Blog Image</th>
                            <th>Blog Title</th>
                            <th>Blog Date</th>
                            <th>Short Description</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>
        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>            
            <action-link id="editBlogLink" label="Edit Blog Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetBlog", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'blogcategory' },
                { data: 'blogimage', orderable: false },
                { data: 'title' },
                { data: 'blogdate' },
                { data: 'shortdescription' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editBlogLink',
                    baseUrl: '@Url.Action("MasterEditBlog", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Master_Blog", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
                "BlogCategoryUUID": "/Common/GetBlogCategoryName"
            },
            friendlyFieldMap: {
                "Title": "Blog Title",
                "BlogCategoryUUID": "Category",
                "ShortDescription": "Short Description",
                "FullDescription": "Full Description",
                "BlogDate": "Blog Date",
                "BlogImageUrl": "Blog Image",
                "BannerImageUrl": "Banner Image"
            },
            hiddenFields: [
                "BlogImageUrl",
                "BannerImageUrl"
            ]
        })
        );        
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Blog' });
    </script>
}