@{
    ViewData["Title"] = "View Verification Fee";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-6">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->
                    <div class="col-6 text-align-end">
                        <form-button label="Add Verification Fee"
                                     type="Add"
                                     url="@Url.Action("MasterAddVerificationFee", "Master")">
                        </form-button>

                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr. No</th>
                                <th style="display:none;">UUID</th>
                                <th>Verification Type</th>
                                <th>Amount</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>

                </div>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editVerificationFeeLink" label="Edit Verification Fee Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

    <!-- Timer -->
    <partial name="_Timer" />
@section Scripts {
        <partial name="_ViewScripts" />

        <script>
            initMasterTable({
                tableId: '#datatable_1',
                ajaxUrl: '@Url.Action("GetVerificationFee", "Master")',
                columns: [
                    { data: 'srno', orderable: false },
                    { data: 'uuid', visible: false },
                    { data: 'verificationtype' },
                    { data: 'amount' },
                    { data: 'action', orderable: false }
                ],
                rowActions: [
                    {
                        selector: '#editVerificationFeeLink',
                        baseUrl: '@Url.Action("MasterEditVerificationFee", "Master")',
                        idProperty: 'uuid',
                        paramName: 'uuid'
                    },
                    {
                        selector: '#viewHistoryLink',
                        baseUrl: 'javascript:void(0)',
                        idProperty: 'uuid',
                        handler: function (rowData) {
                            AuditLogsUI.openLogs(
                                "Master_VerificationFee",
                                rowData.uuid,
                                false,
                                ""
                            );
                        }
                    }
                ]
            });

            AuditLogsUI.init(
                AuditLogsUI.common.mergeConfig({
                    friendlyFieldMap: {
                        "VerificationType": "Verification Type",
                        "Amount": "Amount",
                        "CreatedAt": "Created At",
                        "UpdatedAt": "Updated At"
                    },
                    hiddenFields: []
                })
            );
        </script>

        <script>
            initActivityLogTable({
                menuName: 'Master_VerificationFee'
            });
        </script>
}
