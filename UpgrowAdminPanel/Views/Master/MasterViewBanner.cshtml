@section Styles {
    <partial name="_ViewStyles" />
}

@{
    ViewData["Title"] = "View Banners";
}

<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-9">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-3 text-align-end">
                    <form-button label="Add Banner"
                                 type="Add"
                                 url="@Url.Action("MasterAddBanner", "Master")">
                    </form-button>
                    
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr.</th>
                            <th style="display:none;">UUID</th>
                            <th>Banner Image</th>
                            <th>Banner Title</th>
                            <th>Banner Sub Title</th>
                            <th>Button Text</th>
                            <th>Button URL</th>
                            <th>Sequence No</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>            
            <action-link id="editBannerLink" label="Edit Banner Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        const table = initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetBanners", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'image', orderable: false },
                { data: 'maintitle' },
                { data: 'subtitle' },
                { data: 'buttontext' },
                { data: 'buttonurl' },
                
                { data: 'sequenceno' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editBannerLink',
                    baseUrl: '@Url.Action("MasterEditBanner", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                 {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Master_Banner", rowData.uuid, false, "");
                    }
                }
            ]
        });
         AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
            },
            friendlyFieldMap: {
                "MainTitle": "Main Title",
                "SubTitle": "Sub Title",
                "OptionalTitle": "Optional Title",
                "ButtonText": "Button Text",
                "ButtonURL": "Button URL",
                "BannerImage": "Banner Image",
                "SequenceNo": "Sequence Number"
            },
            hiddenFields: [
                "TenantUUID"
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Banner' });
    </script>
}