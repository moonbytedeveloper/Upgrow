@{
    ViewData["Title"] = "View Testimonial";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-end">
                    <form-button label="Add Testimonial"
                                 type="Add"
                                 url="@Url.Action("MasterAddTestimonial", "Master")">
                    </form-button>
                   
                </div>
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Customer Name</th>
                            <th>Company Name</th>
                            <th>Comment</th>
                            <th>Sequence No</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <li>
                <a href="javascript:void(0)" id="editTestimonialLink">
                    Edit Testimonial Details
                </a>
            </li>
            <li>
                <a href="javascript:void(0)" id="viewHistoryLink">
                    View History
                </a>
            </li>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
            initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetTestimonials", "Master")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'customername' },
                { data: 'companyname' },
                { data: 'comment' },
                { data: 'sequenceno' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editTestimonialLink',
                    baseUrl: '@Url.Action("MasterEditTestimonial", "Master")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("Master_Testimonial", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
            },
            friendlyFieldMap: {
                "CustomerName": "Customer Name",
                "CompanyName": "Company Name",
                "Comment": "Comment",
                "Star": "Star Rating",
                "SequenceNo": "Sequence Number"
            },
            hiddenFields: [
                "FilePath"
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Master_Testimonial' });
    </script>
}