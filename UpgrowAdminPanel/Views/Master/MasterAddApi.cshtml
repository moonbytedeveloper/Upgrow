@model UpgrowAdminPanel.Models.Master.MasterApiVM

@{
    var isEditMode = !string.IsNullOrWhiteSpace(Model?.Api?.UUID);
    var pageTitle = isEditMode ? "Edit API" : "Add API";
    ViewData["Title"] = pageTitle;
}

@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}

@section Styles {

    <style>

        .form-switch .form-check-input {
            width: 45px;
            height: 22px;
            cursor: pointer;
        }

        .priority-select:disabled {
            background-color: #f5f5f5;
            cursor: not-allowed;
        }

        .support-radio-wrapper {
            display: none;
        }

        .section-toggle {
            color: inherit !important;
        }

        .collapse-icon {
            transition: transform .25s ease;
        }

        .section-toggle[aria-expanded="true"] .collapse-icon {
            transform: rotate(180deg);
        }
    </style>
}

<div class="container-fluid">

    <div class="row mt-2">

        <div class="card">

            <div class="card-header">
                <h3 class="card-title fs-20">@pageTitle</h3>
            </div>


            <div class="card-body pt-0">

                <form id="bannerForm" asp-action="MasterAddApi" method="post">

                    <input type="hidden" asp-for="Api.UUID" />
                    <input type="hidden" asp-for="Api.IsActive" />
                    <input type="hidden" asp-for="Api.Code" />
                    <input type="hidden" asp-for="ApiEndpoint.UUID" />
                    <input type="hidden" asp-for="ApiEndpoint.IsActive" />
                    <input type="hidden" asp-for="SecondApiEndpoint.UUID" />
                    <input type="hidden" asp-for="SecondApiEndpoint.IsActive" />

                    <div class="card border shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <button type="button"
                                        class="btn btn-link text-decoration-none text-start w-100 p-0 fw-semibold d-flex justify-content-between align-items-center section-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#basicInfoCollapse"
                                        aria-expanded="true">

                                    <span>Basic Information</span>

                                    <i class="fas fa-chevron-down collapse-icon"></i>
                                </button>
                            </h5>
                        </div>
                        <div id="basicInfoCollapse" class="collapse show">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-5">
                                    <form-field asp-for="Api.ApiName" label="API Name" type="Text" required="true" />
                                </div>
                                <div class="col-lg-4">
                                    <form-field asp-for="Api.ApiCategoryUUID" label="API Category" type="Select" required="true" asp-items="Model?.ApiCategoryList">
                                        <option value="">-- Select Category --</option>
                                    </form-field>
                                </div>
                                <div class="col-lg-3">
                                    <form-field asp-for="Api.DisplayOrder" label="Sequence No" type="Number" required="true" />
                                </div>
                                <div class="col-12 mt-3">
                                    <form-field asp-for="Api.ShortDescription" label="Description" type="TextArea" required="true" />
                                </div>
                                    <div class="col-12 mt-3">
                                        <form-field asp-for="Api.VerificationDocument" label="Verification Document" type="CKEditor" required="true" />
                                    </div>
                            </div>
                        </div>
                        </div>
                    </div>

                    <div class="card border shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <button type="button"
                                        class="btn btn-link text-decoration-none text-start w-100 p-0 fw-semibold d-flex justify-content-between align-items-center section-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#configCollapse"
                                        aria-expanded="true">

                                    <span>Configuration Options</span>

                                    <i class="fas fa-chevron-down collapse-icon"></i>
                                </button>
                            </h5>
                        </div>
                        <div id="configCollapse" class="collapse show">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-3"><form-field asp-for="Api.IsMultipleEndPoint" label="Is Multiple Endpoint" type="Checkbox" required="true" /></div>
                                <div class="col-lg-3"><form-field asp-for="Api.IsConsentBased" label="Is Consent Based" type="Checkbox" /></div>
                                <div class="col-lg-3"><form-field asp-for="Api.IsReminderRequired" label="Is Reminder Required" type="Checkbox" /></div>
                                <div class="col-lg-3"><form-field asp-for="Api.IsProviderSwitchable" label="Is Provider Switchable" type="Checkbox" /></div>
                            </div>
                        </div>
                        </div>
                    </div>

                    <div class="card border shadow-sm mb-4">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <button type="button"
                                        class="btn btn-link text-decoration-none text-start w-100 p-0 fw-semibold d-flex justify-content-between align-items-center section-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#primaryEndpointCollapse"
                                        aria-expanded="true">

                                    <span>Primary Endpoint</span>

                                    <i class="fas fa-chevron-down collapse-icon"></i>
                                </button>
                            </h5>
                        </div>
                        <div id="primaryEndpointCollapse" class="collapse show">

                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4">
                                    <form-field asp-for="SelectedComponentUUID" label="Component" type="Select" required="true" asp-items="Model?.ComponentList">
                                        <option value="">-- Select Component --</option>
                                    </form-field>
                                </div>
                                <div class="col-lg-5">
                                    <form-field asp-for="ApiEndpoint.EndpointUrl" label="Endpoint Url" type="Text" required="true" />
                                </div>
                                <div class="col-lg-3">
                                    <form-field asp-for="ApiEndpoint.HttpMethod" label="Http Method" type="Select" asp-items="@Model.HttpMethods" placeholder="-- Http Method --" required="true" />
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>

                    <div id="secondEndpointContainer" class="card border shadow-sm mb-4" style="display:none;">
                        <div class="card-header bg-light">
                            <h5 class="mb-0">
                                <button type="button"
                                        class="btn btn-link text-decoration-none text-start w-100 p-0 fw-semibold d-flex justify-content-between align-items-center section-toggle"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#secondaryEndpointCollapse"
                                        aria-expanded="true">

                                    <span>Secondary Endpoint</span>

                                    <i class="fas fa-chevron-down collapse-icon"></i>
                                </button>
                            </h5>
                        </div>
                        <div id="secondaryEndpointCollapse" class="collapse show">

                        <div class="card-body">
                            <div class="row">
                                <div class="col-lg-4">
                                    <form-field asp-for="SelectedSecondComponentUUID" label="Component" type="Select" required="true" asp-items="Model?.ComponentList">
                                        <option value="">-- Select Second Component --</option>
                                    </form-field>
                                </div>
                                <div class="col-lg-5">
                                    <form-field asp-for="SecondApiEndpoint.EndpointUrl" label="Endpoint Url" type="Text" required="true" />
                                </div>
                                <div class="col-lg-3">
                                    <form-field asp-for="SecondApiEndpoint.HttpMethod" label="Http Method" type="Select" asp-items="@Model.HttpMethods" placeholder="-- Http Method --" required="true" />
                                </div>
                            </div>
                        </div>
                        </div>
                    </div>

                    <!-- PROVIDER TABLE -->
                    <div class="col-12">

                        <div class="card border shadow-sm">

                            <div class="card-header bg-light">
                                <h5 class="mb-0">
                                    <button type="button"
                                            class="btn btn-link text-decoration-none text-start w-100 p-0 fw-semibold d-flex justify-content-between align-items-center section-toggle"
                                            data-bs-toggle="collapse"
                                            data-bs-target="#providerConfigCollapse"
                                            aria-expanded="true">

                                        Provider Configuration

                                        <i class="fas fa-chevron-down collapse-icon"></i>
                                    </button>
                                </h5>
                            </div>
                            <div id="providerConfigCollapse" class="collapse show">

                            <div class="card-body p-0">

                                <div class="table-responsive">

                                    <table class="table table-bordered table-hover align-middle mb-0">

                                        <thead class="table-light">
                                            <tr>
                                                <th>Provider</th>
                                                <th class="text-center">Supports this API(Capability)</th>
                                                <th class="text-center">Active</th>
                                                <th>Priority</th>
                                            </tr>
                                        </thead>

                                        <tbody>

                                            @if (Model.ProviderMappings != null && Model.ProviderMappings.Count > 0)
                                            {
                                                for (int i = 0; i < Model.ProviderMappings.Count; i++)
                                                {
                                                    <tr class="provider-row">

                                                        <input type="hidden"
                                                               asp-for="ProviderMappings[i].ProviderUUID" />

                                                        <input type="hidden"
                                                               asp-for="ProviderMappings[i].ProviderName" />

                                                        <td class="fw-semibold">
                                                            @Model.ProviderMappings[i].ProviderName
                                                        </td>

                                                        <!-- SUPPORT -->
                                                        <td class="text-center">

                                                            <div class="checkbox-mode">

                                                                <div class="form-check d-flex justify-content-center">

                                                                    <input type="checkbox"
                                                                           asp-for="ProviderMappings[i].SupportsApi"
                                                                           class="form-check-input support-checkbox" />

                                                                </div>

                                                            </div>

                                                            <div class="radio-mode support-radio-wrapper">

                                                                <div class="d-flex justify-content-center">

                                                                    <input type="radio"
                                                                           name="selectedSupport"
                                                                           class="form-check-input support-radio"
                                                                           value="@i"
                                                                           @(Model.ProviderMappings[i].SupportsApi ? "checked" : "") />

                                                                </div>

                                                            </div>

                                                        </td>

                                                        <!-- ACTIVE -->
                                                        <td class="text-center">

                                                            <div class="form-check form-switch d-flex justify-content-center">

                                                                <input class="form-check-input active-switch"
                                                                       type="checkbox"
                                                                       asp-for="ProviderMappings[i].IsActive" />

                                                            </div>

                                                        </td>

                                                        <!-- PRIORITY -->
                                                        <td style="width:180px;">

                                                            <select asp-for="ProviderMappings[i].Priority"
                                                                    class="form-select priority-select">
                                                                    
                                                                <option value="">Select Priority</option>

                                                                @for (int p = 1; p <= 3; p++)
                                                                {
                                                                    <option value="@p"
                                                                            selected="@(Model.ProviderMappings[i].Priority == p)">
                                                                        @p
                                                                    </option>
                                                                }

                                                            </select>

                                                        </td>

                                                    </tr>
                                                }
                                            }

                                        </tbody>

                                    </table>

                                </div>

                            </div>
                            </div>

                        </div>

                    </div>


                    <div class="col-12 text-end pb-4">
                        <form-button label="Cancel" type="Cancel" url="@Url.Action("MasterViewApi", "Master")" />
                        <form-button label="Submit" type="Submit" />
                    </div>

                </form>
            </div>
            </div>
            </div>
            </div>


            <!-- TIMER -->
            <partial name="_Timer" />

@section Scripts {

    <script src="~/ckeditor/ckeditor/ckeditor.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Keep your existing initialization script (unchanged)
               function initializeForm() {
            if (typeof jQuery === 'undefined') {
                setTimeout(initializeForm, 100);
                return;
            }
            if (typeof CKEDITOR !== 'undefined') {
                document.querySelectorAll('.ckeditor-textarea').forEach(function (textarea) {
                    if (!CKEDITOR.instances[textarea.id]) {
                        var editor = CKEDITOR.replace(textarea.id, {
                            extraAllowedContent: 'div(*)[*]{*}; span(*)[*]{*}; p(*)[*]{*};',
                            allowedContent: true,
                            height: 300,
                            toolbar: [
                                { name: 'document', items: ['Source', '-', 'Save', 'NewPage', 'Preview'] },
                                { name: 'clipboard', items: ['Cut', 'Copy', 'Paste', 'PasteText', 'PasteFromWord', '-', 'Undo', 'Redo'] },
                                { name: 'editing', items: ['Find', 'Replace', '-', 'SelectAll'] },
                                '/',
                                { name: 'basicstyles', items: ['Bold', 'Italic', 'Underline', 'Strike', 'Subscript', 'Superscript', '-', 'RemoveFormat'] },
                                { name: 'paragraph', items: ['NumberedList', 'BulletedList', '-', 'Outdent', 'Indent', '-', 'Blockquote'] },
                                { name: 'links', items: ['Link', 'Unlink'] },
                                { name: 'insert', items: ['Image', 'Table', 'HorizontalRule'] },
                                '/',
                                { name: 'styles', items: ['Styles', 'Format', 'Font', 'FontSize'] },
                                { name: 'colors', items: ['TextColor', 'BGColor'] }
                            ]
                        });

                        editor.on('change', function () {
                            editor.updateElement();
                        });
                    }
                });
            }
        }

                document.addEventListener('DOMContentLoaded', initializeForm);
                if (typeof jQuery !== 'undefined') {
                    jQuery(document).ready(function () {
                        initializeForm();

                        // Tell jQuery Validate to ignore nothing, so it can see the hidden textarea
                        if ($.validator) {
                            $.validator.setDefaults({
                                ignore: []
                            });
                        }
                    });
                }
    </script>
   <script>

                    $(function () {

                        initPage();

                    });

                    // =========================
                    // LOADER
                    // =========================
                    function showLoader() {

                        $('.loading')
                            .removeClass('fade-out')
                            .css('display', 'flex');
                    }

                    function hideLoader() {

                        $('.loading')
                            .addClass('fade-out');

                        setTimeout(function () {

                            $('.loading').hide();

                        }, 600);
                    }

                    // =========================
                    // INIT
                    // =========================
                    function initPage() {

                        initDefaults();

                        bindEvents();

                        toggleMode();

                        syncState();

                        enforceProviderLimit();

                        if (!$('#Api_IsProviderSwitchable').is(':checked')) {

                            selectPriorityOneProvider();
                        }
                    }

                    // =========================
                    // DEFAULTS
                    // =========================
                    function initDefaults() {

                        var isEditMode = '@isEditMode'.toLowerCase() === 'true';

                        if (!isEditMode) {

                            let order = $('#Api_DisplayOrder').val();

                            if (!order || order === '0') {

                                $('#Api_DisplayOrder').val(1);
                            }
                        }

                        $('#Api_ApiName').on('change blur', function () {

                            let val = $(this).val();

                            if (!val) return;

                            let code = val.toUpperCase()
                                .replace(/[^A-Z0-9]+/g, '_')
                                .replace(/^_|_$/g, '');

                            $('#Api_Code').val(code);
                        });
                    }

                    // =========================
                    // EVENTS
                    // =========================
                    function bindEvents() {

                        $('#Api_IsProviderSwitchable').on('change', function () {

                            let isSwitchable = $(this).is(':checked');

                            toggleMode();

                            if (!isSwitchable) {

                                selectPriorityOneProvider();
                            }
                            else {

                                syncState();

                                refreshPriorityOptions();

                                enforceProviderLimit();
                            }
                        });

                        $(document).on('change', '.support-checkbox', onSupportCheckboxChange);

                        $(document).on('change', '.support-radio', onSupportRadioChange);

                        $(document).on('change', '.active-switch', onActiveChange);

                        $(document).on('change', '.priority-select', onPriorityChange);

                        // FORM SUBMIT
                        $('#bannerForm').on('submit', function () {

                            let isValid = validateForm();

                            if (!isValid) {

                                hideLoader();

                                $('button[type="submit"]').prop('disabled', false);

                                return false;
                            }

                            $('button[type="submit"]').prop('disabled', true);

                            showLoader();

                            return true;
                        });
                    }

                    // =========================
                    // SUPPORT CHECKBOX
                    // =========================
                    function onSupportCheckboxChange() {

                        let row = $(this).closest('tr');

                        let checked = $(this).is(':checked');

                        setSupport(row, checked);

                        if (!checked) {

                            disableRow(row);

                            refreshPriorityOptions();
                        }
                        else {

                            row.find('.active-switch')
                                .prop('disabled', false);
                        }

                        refreshPriorityOptions();

                        enforceProviderLimit();
                    }

                    // =========================
                    // SUPPORT RADIO
                    // =========================
                    function onSupportRadioChange() {

                        let row = $(this).closest('tr');

                        $('.provider-row').each(function () {

                            let currentRow = $(this);

                            currentRow.find('.support-radio').prop('checked', false);

                            currentRow.find('.support-checkbox').prop('checked', false);

                            currentRow.find('.active-switch')
                                .prop('checked', false)
                                .prop('disabled', true);

                            currentRow.find('.priority-select')
                                .val('')
                                .prop('disabled', true);
                        });

                        $(this).prop('checked', true);

                        row.find('.support-checkbox')
                            .prop('checked', true);

                        row.find('.active-switch')
                            .prop('checked', true)
                            .prop('disabled', false);

                        row.find('.priority-select')
                            .html('<option value="1">1</option>')
                            .val('1')
                            .prop('disabled', true);
                    }

                    // =========================
                    // ACTIVE CHANGE
                    // =========================
                    function onActiveChange() {

                        let row = $(this).closest('tr');

                        let support = isSupported(row);

                        let priority = row.find('.priority-select');

                        let isActive = $(this).is(':checked');

                        if (!support) {

                            showNotification(
                                'Please select Supported first.',
                                'danger'
                            );

                            $(this).prop('checked', false);

                            return;
                        }

                        if ($('#Api_IsProviderSwitchable').is(':checked')) {

                            // Check if trying to activate and already at limit
                            if (isActive) {

                                let activeCount =
                                    $('.active-switch:checked').length;

                                if (activeCount > 3) {

                                    showNotification(
                                        'Maximum 3 active providers allowed.',
                                        'danger'
                                    );

                                    $(this).prop('checked', false);

                                    return;
                                }
                            }

                            priority.prop('disabled', !isActive);

                            if (!isActive) {

                                priority.val('');
                            }

                            refreshPriorityOptions();

                            enforceProviderLimit();
                        }
                    }

                    // =========================
                    // PRIORITY CHANGE
                    // =========================
                    function onPriorityChange() {

                        let row = $(this).closest('tr');

                        let priority = $(this).val();

                        let activeSwitch = row.find('.active-switch');

                        // If priority is being set, activate the provider
                        if (priority) {

                            let activeCount =
                                $('.active-switch:checked').length;

                            // Check if already at limit and not currently active
                            if (activeCount >= 3 && !activeSwitch.is(':checked')) {

                                showNotification(
                                    'Maximum 3 active providers allowed.',
                                    'danger'
                                );

                                $(this).val('');

                                return;
                            }

                            row.find('.support-checkbox')
                                .prop('checked', true);

                            activeSwitch
                                .prop('checked', true)
                                .prop('disabled', false);
                        }

                        refreshPriorityOptions();

                        enforceProviderLimit();
                    }

                    // =========================
                    // VALIDATION
                    // =========================
                            function validateForm() {

                        let selectedProviders =
                            $('.support-checkbox:checked').length;

                        // =========================
                        // MIN VALIDATION
                        // =========================
                        if (selectedProviders === 0) {

                            showNotification(
                                'Please select at least one provider.',
                                'danger'
                            );

                            return false;
                        }

                         

                        let priorities = [];

                        let valid = true;

                        $('.provider-row').each(function () {

                            let row = $(this);

                            let support =
                                row.find('.support-checkbox').is(':checked');

                            let active =
                                row.find('.active-switch').is(':checked');

                            let priority =
                                row.find('.priority-select').val();

                            // duplicate priority
                            if (priority) {

                                if (priorities.includes(priority)) {

                                    showNotification(
                                        'Duplicate priority not allowed.',
                                        'danger'
                                    );

                                    valid = false;

                                    return false;
                                }

                                priorities.push(priority);
                            }

                            // priority requires active
                            if (priority && !active) {

                                showNotification(
                                    'Priority requires Active enabled.',
                                    'danger'
                                );

                                valid = false;

                                return false;
                            }

                            // active requires support
                            if (active && !support) {

                                showNotification(
                                    'Active requires Supported.',
                                    'danger'
                                );

                                valid = false;

                                return false;
                            }
                        });

                        return valid;
                    }

                    // =========================
                    // TOGGLE MODE
                    // =========================
                    function toggleMode() {

                        let isSwitchable = $('#Api_IsProviderSwitchable').is(':checked');

                        if (isSwitchable) {

                            $('.checkbox-mode').show();

                            $('.radio-mode').hide();

                            refreshPriorityOptions();
                        }
                        else {

                            $('.checkbox-mode').hide();

                            $('.radio-mode').show();

                            let selected =
                                $('.support-checkbox:checked:first');

                            if (selected.length > 0) {

                                selected.closest('tr')
                                    .find('.support-radio')
                                    .prop('checked', true);
                            }
                        }
                    }

                    // =========================
                    // SYNC
                    // =========================
                    function syncState() {

                        $('.provider-row').each(function () {

                            let row = $(this);

                            let support = isSupported(row);

                            let active = row.find('.active-switch').is(':checked');

                            if (!support) {

                                disableRow(row);
                            }
                            else {

                                row.find('.active-switch')
                                    .prop('disabled', false);

                                row.find('.priority-select')
                                    .prop('disabled', !active);
                            }
                        });
                    }

                    // =========================
                    // HELPERS
                    // =========================
                    function setSupport(row, value) {

                        row.find('.support-checkbox')
                            .prop('checked', value);
                    }

                    function isSupported(row) {

                        return row.find('.support-checkbox').is(':checked');
                    }

                    function disableRow(row) {

                        row.find('.active-switch')
                            .prop('checked', false)
                            .prop('disabled', true);

                        row.find('.priority-select')
                            .val('')
                            .prop('disabled', true);
                    }

                    // =========================
                    // PROVIDER LIMIT
                    // =========================
                    function enforceProviderLimit() {

                        if (!$('#Api_IsProviderSwitchable').is(':checked'))
                            return;

                        let activeCount =
                            $('.active-switch:checked').length;

                        if (activeCount >= 3) {

                            $('.provider-row').each(function () {

                                let activeSwitch =
                                    $(this).find('.active-switch');

                                if (!activeSwitch.is(':checked')) {

                                    activeSwitch.prop('disabled', true);
                                }
                            });
                        }
                        else {

                            $('.active-switch')
                                .prop('disabled', false);
                        }
                    }

                    // =========================
                    // PRIORITY OPTIONS
                    // =========================
                    function refreshPriorityOptions() {

                        if (!$('#Api_IsProviderSwitchable').is(':checked'))
                            return;

                        $('.provider-row').each(function () {

                            let currentRow = $(this);

                            let ddl = currentRow.find('.priority-select');

                            let isActive =
                                currentRow.find('.active-switch').is(':checked');

                            let isSupported =
                                currentRow.find('.support-checkbox').is(':checked');

                            if (!isActive || !isSupported) {

                                ddl.prop('disabled', true).val('');

                                return;
                            }

                            ddl.prop('disabled', false);

                            let currentValue = ddl.val();

                            let usedPriorities = [];

                            $('.provider-row').not(currentRow).each(function () {

                                let otherRow = $(this);

                                let otherActive =
                                    otherRow.find('.active-switch').is(':checked');

                                let otherSupported =
                                    otherRow.find('.support-checkbox').is(':checked');

                                if (!otherActive || !otherSupported)
                                    return;

                                let val =
                                    otherRow.find('.priority-select').val();

                                if (val) {

                                    usedPriorities.push(val.toString());
                                }
                            });

                            ddl.empty();

                            ddl.append('<option value="">Select Priority</option>');

                            for (let i = 1; i <= 3; i++) {

                                let p = i.toString();

                                if (p === currentValue || !usedPriorities.includes(p)) {

                                    ddl.append(
                                        `<option value="${p}">${p}</option>`
                                    );
                                }
                            }

                            ddl.val(currentValue);
                        });
                    }

                    // =========================
                    // SINGLE PROVIDER
                    // =========================
                    function selectPriorityOneProvider() {

                        let selectedRows =
                            $('.support-checkbox:checked');

                        if (selectedRows.length === 0) {

                            let firstRow =
                                $('.provider-row:first');

                            firstRow.find('.support-checkbox')
                                .prop('checked', true);

                            selectedRows =
                                firstRow.find('.support-checkbox');
                        }

                        let selectedRow =
                            selectedRows.first().closest('tr');

                        $('.provider-row').each(function () {

                            let row = $(this);

                            if (row.is(selectedRow)) {

                                row.find('.support-checkbox')
                                    .prop('checked', true);

                                row.find('.support-radio')
                                    .prop('checked', true);

                                row.find('.active-switch')
                                    .prop('checked', true)
                                    .prop('disabled', false);

                                row.find('.priority-select')
                                    .html('<option value="1">1</option>')
                                    .val('1')
                                    .prop('disabled', true);
                            }
                            else {

                                row.find('.support-checkbox')
                                    .prop('checked', false);

                                row.find('.support-radio')
                                    .prop('checked', false);

                                row.find('.active-switch')
                                    .prop('checked', false)
                                    .prop('disabled', true);

                                row.find('.priority-select')
                                    .val('')
                                    .prop('disabled', true);
                            }
                        });
                    }

                </script>
   <script>
                    // Add this to your existing script section

                    $(function () {
                        // Toggle second endpoint visibility
                        toggleSecondEndpoint();

                        $('#Api_IsMultipleEndPoint').on('change', function () {
                            toggleSecondEndpoint();
                        });
                    });

                    function toggleSecondEndpoint() {
                        const isMultiple = $('#Api_IsMultipleEndPoint').is(':checked');
                        const container = $('#secondEndpointContainer');

                        if (isMultiple) {
                            container.show();
                            // Mark second endpoint fields as required
                            container.find('input, select').attr('required', true);
                        } else {
                            container.hide();
                            // Clear and remove required from second endpoint fields
                            container.find('input').val('');
                            container.find('select').val('');
                            container.find('input, select').removeAttr('required');
                        }
                    }
                </script>
