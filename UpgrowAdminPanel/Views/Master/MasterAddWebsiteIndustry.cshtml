@model UpgrowAdminPanel.Models.Website.WebsiteMasterIndustryVM
@{
    var isEditMode = !string.IsNullOrEmpty(Model?.MasterInd?.UUID);
    ViewData["Title"] = isEditMode ? "Edit Website Industry" : "Add Website Industry";
}
@section Styles {
    <partial name="_ViewStyles" />
    <link href="~/assets/css/select2.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.css" rel="stylesheet" />

    <style>
        /* Neutralize all visual selection/hover backgrounds for datatable rows */
        table.datatableeditpopup,
        table.datatableeditpopup tbody,
        table.datatableeditpopup tbody tr,
        table.datatableeditpopup tbody tr td,
        table.datatableeditpopup tbody tr th {
            -webkit-tap-highlight-color: transparent !important;
        }

            /* Remove any background, image, color, shadow or outline applied on selected/active/focus/hover */
            table.datatableeditpopup tbody tr.selected,
            table.datatableeditpopup tbody tr.selected td,
            table.datatableeditpopup tbody tr.selected th,
            table.datatableeditpopup tbody tr:active,
            table.datatableeditpopup tbody tr:focus,
            table.datatableeditpopup tbody tr td:active,
            table.datatableeditpopup tbody tr td:focus,
            table.datatableeditpopup tbody tr:hover,
            table.datatableeditpopup tbody tr:hover td,
            table.datatableeditpopup tbody tr[style],
            table.datatableeditpopup tbody tr[style] td,
            table.datatableeditpopup tbody tr td[style] {
                background: transparent !important;
                background-color: transparent !important;
                background-image: none !important;
                color: inherit !important;
                box-shadow: none !important;
                -webkit-box-shadow: none !important;
                outline: none !important;
            }

        /* Also override common Bootstrap/DataTables classes that may be used */
        .table-active,
        .table-primary,
        .table-info,
        .bg-primary,
        .bg-info,
        tr.table-active,
        tr.table-primary,
        tr.table-info {
            background: transparent !important;
            background-color: transparent !important;
            color: inherit !important;
            box-shadow: none !important;
            outline: none !important;
        }

        /* Defensive: neutralize any inline background-* style fragments */
        table.datatableeditpopup tbody tr[style*="background"],
        table.datatableeditpopup tbody tr td[style*="background"] {
            background: transparent !important;
            background-color: transparent !important;
            background-image: none !important;
        }
    </style>
}
        <div class="container-fluid">
            <!-- Page-Title -->
            <div class="row mt-2">

