                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="MasterInd.Sequence"
                                                label="Sequence"
                                                type="Number"
                                                required="true" />
                                </div>
                         

                                <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                                    <form-field asp-for="MasterInd.Description"
                                                label="Description"
                                                type="TextArea"
                                                required="true" />
                                </div>


                                <div class="col-lg-12 col-md-4 col-sm-6 col-12 text-align-end pt-4">
                                    <form-button label="Cancel"
                                                 type="Cancel"
                                                 url="@Url.Action("MasterViewWebsiteIndustry", "Master")" />
                                    <form-button label="Submit"
                                                 type="Submit" />
                                </div>

                            </div>
                        </form>


                    </div><!--end card-body-->
                </div><!--end card-->

            </div><!--end row-->



        </div><!-- container -->
        <!-- Timer -->
