<!-- end page-wrapper -->
@section Scripts
{
    <partial name="_ViewScripts" />
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/fileupload.js"></script>
    <script src="~/assets/js/imagepreview.js"></script>
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/jquery.dataTables.min.js"></script>
    <script src="~/assets/js/notification.js"></script>
 
    <script>
        const industryUuid = '@Model.MasterInd?.UUID';
        let industryPointsTable = null;

        function clearValidation(formSelector) {

            const form = $(formSelector);

            form.find('.input-error').removeClass('input-error');

            form.find('.error-icon').removeClass('show');

            form.find('[data-valmsg-for]').each(function () {
                $(this)
                    .text('')
                    .removeClass('field-validation-error')
                    .addClass('field-validation-valid')
                    .hide();
            });
        }

        function showError(field, message) {

            if (!field) return;

            // IMPORTANT FIX
            const wrapper =
                field.closest('.inputGroup') ||
                field.closest('.formgroup') ||
                field.parentElement;

            if (!wrapper) return;

            // FORCE CLASS
            wrapper.classList.add('input-error');

            // textarea specific fix
            if (field.tagName === "TEXTAREA") {
                field.classList.add("input-error");
            }

            // icon
            const icon = wrapper.querySelector('.error-icon');

            if (icon) {
                icon.classList.add('show');
            }

            // validation message
            const name = field.getAttribute('name');

            const msg =
                wrapper.querySelector(`[data-valmsg-for="${name}"]`) ||
                document.querySelector(`[data-valmsg-for="${name}"]`);

            if (msg) {

                msg.textContent = message;

                msg.classList.remove('field-validation-valid');

                msg.classList.add('field-validation-error');

                msg.style.display = 'block';
            }

            console.log('Validation Applied:', {
                field: field.name,
                wrapper: wrapper,
                classes: wrapper.className
            });
        }

        $(document).ready(function () {
            $('#editIndustryCaseLink').closest('li').hide();
            $('#viewIndustryCaseHistoryLink').closest('li').hide();

            $('#industryPointForm').on('submit', function (e) {

            e.preventDefault();

            let isValid = true;

            // Clear previous validation
            clearValidation('#industryPointForm');

            const title = $('#IndPoints_Title');

            if ($.trim(title.val()) === '') {
                showError(title[0], 'Industry Point is required.');
                isValid = false;
            }

            // Skip Sequence validation

            if (!isValid)
                return;

            $.ajax({
                url: '/Master/AddIndustryPoint',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {

                    if (response.success) {

                        $('#IndPoints_UUID').val('');
                        $('#IndPoints_Title').val('');
                        $('#IndPoints_Sequence').val('0');
                        $('#addIndustryPointBtn').text('Add');

                        $('#industryPointsTable').DataTable().ajax.reload(null, false);
                    }
                }
            });
        });

            $('#industryCaseForm').on('submit', function (e) {

            e.preventDefault();

            let isValid = true;

            clearValidation('#industryCaseForm');

            const title = $('#IndCases_Title');
            const icon = $('#IndCases_Icon');

            if ($.trim(title.val()) === '') {
                showError(title[0], 'Industry Case is required.');
                isValid = false;
            }

            if ($.trim(icon.val()) === '') {
                showError(icon[0], 'Industry Icon is required.');
                isValid = false;
            }

            // Skip Sequence validation

            if (!isValid)
                return;

            $.ajax({
                url: '/Master/AddIndustryCase',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {

                    if (response.success) {

                        $('#IndCases_UUID').val('');
                        $('#IndCases_Title').val('');
                        $('#IndCases_Icon').val('');
                        $('#IndCases_Sequence').val('0');
                        $('#addIndustryCaseBtn').text('Add');

                        $('#industryCasesTable').DataTable().ajax.reload(null, false);
                    }
                }
            });
        });
            
            $('#industryPointsTable tbody').on('click', 'tr', function () {

            $('#editIndustryCaseLink').closest('li').hide();
            $('#viewIndustryCaseHistoryLink').closest('li').hide();

            $('#editIndustryPointLink').closest('li').show();
            $('#viewIndustryPointHistoryLink').closest('li').show();
        });

            $('#industryCasesTable tbody').on('click', 'tr', function () {

            $('#editIndustryPointLink').closest('li').hide();
            $('#viewIndustryPointHistoryLink').closest('li').hide();

            $('#editIndustryCaseLink').closest('li').show();
            $('#viewIndustryCaseHistoryLink').closest('li').show();
        });

            $('#industryCasesTable tbody').on('click', 'tr', function () {

            $('#editIndustryPointLink').closest('li').hide();
            $('#viewIndustryPointHistoryLink').closest('li').hide();

            $('#editIndustryCaseLink').closest('li').show();
            $('#viewIndustryCaseHistoryLink').closest('li').show();
        });

            $('#industryPointsTable tbody').on('click', 'tr', function () {

            $('#editIndustryCaseLink').closest('li').hide();
            $('#viewIndustryCaseHistoryLink').closest('li').hide();

            $('#editIndustryPointLink').closest('li').show();
            $('#viewIndustryPointHistoryLink').closest('li').show();
        });

        });

        if (industryUuid) {
            initMasterTable({
            tableId: '#industryPointsTable',
            ajaxUrl: '@Url.Action("GetIndustryPoints", "Master")?industryUuid=' + encodeURIComponent(industryUuid),
            columns: [
                    { data: 'srno' },
                    { data: 'uuid', visible: false },
                    { data: 'title' },
                    { data: 'sequence' },
                    { data: 'action', orderable: false }
                ],
            rowActions: [
                {
                   selector: '#editIndustryPointLink',
                   handler: function(rowData){

                $.get('/Master/GetIndustryPoint',
                { uuid: rowData.uuid },
                    function(data){

                    $('input[name="IndPoints.UUID"]').val(data.uuid);
                    $('input[name="IndPoints.Title"]').val(data.title);
                     $('input[name="IndPoints.Sequence"]').val(data.sequence);
                    $('input[name="IndPoints.IsActive"]').val(data.isActive);
                    $('#addIndustryPointBtn').text('Update');
                });
                }
                },
                        {
            selector: '#viewIndustryPointHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Website_IndustryPoints", rowData.uuid, false, "");
            }
        }
            ]
        });
            AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
            },
            friendlyFieldMap: {
                "Title": "Industry Point Title",
            },
            hiddenFields: [
            ]
        })
        );
        }
        

        let industryCasesTable = null;

        if (industryUuid) {
            initMasterTable({
                tableId: '#industryCasesTable',
                ajaxUrl: '@Url.Action("GetIndustryCases", "Master")?industryUuid=' + encodeURIComponent(industryUuid),
                columns: [
                    { data: 'srno' },
                    { data: 'uuid', visible: false },
                    { data: 'title' },
                    { data: 'icon' },
                    { data: 'sequence' },
                    { data: 'action', orderable: false }
                ],
                rowActions: [
                {
                   selector: '#editIndustryCaseLink',
                   handler: function(rowData){

                $.get('/Master/GetIndustryCase',
                { uuid: rowData.uuid },
                    function(data){

                    $('input[name="IndCases.UUID"]').val(data.uuid);
                    $('input[name="IndCases.Title"]').val(data.title);
                    $('input[name="IndCases.Icon"]').val(data.icon);
                    $('input[name="IndCases.Sequence"]').val(data.sequence);
                    $('input[name="IndCases.IsActive"]').val(data.isActive);
                    $('#addIndustryCaseBtn').text('Update');
                });
                }
                },
                        {
            selector: '#viewIndustryCaseHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Website_IndustryCases", rowData.uuid, false, "");
            }
        }
            ]
            });
            AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
            },
            friendlyFieldMap: {
                "Title": "Industry Case Title",
                "Icon": "Icon"
            },
            hiddenFields: [
            ]
        })
        );
        }
    </script>

    <script>
        const tabs = document.querySelectorAll('.custom-tabs .nav-link');
        const indicator = document.querySelector('.tab-indicator');

        function moveIndicator(element) {
            const rect = element.getBoundingClientRect();
            const parentRect = element.closest('.custom-tabs').getBoundingClientRect();

            indicator.style.width = rect.width + "px";
            indicator.style.left = (rect.left - parentRect.left) + "px";
        }

        tabs.forEach(tab => {
            tab.addEventListener('shown.bs.tab', function (e) {
                moveIndicator(e.target);
            });
        });

        // Set initial position
        window.addEventListener('load', () => {
            const active = document.querySelector('.custom-tabs .nav-link.active');
            if (active) moveIndicator(active);
        });
    </script>
}

