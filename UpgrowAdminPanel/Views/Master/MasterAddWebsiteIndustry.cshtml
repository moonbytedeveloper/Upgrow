                    <div class="card-header">
                        <div class="row align-items-center">
                            <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                            </div><!--end col-->

                        </div> <!--end row-->
                    </div><!--end card-header-->
                    <div class="card-body pt-0">
                <form id="bannerForm" asp-action="MasterAddWebsiteIndustry" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="MasterInd.UUID" />
