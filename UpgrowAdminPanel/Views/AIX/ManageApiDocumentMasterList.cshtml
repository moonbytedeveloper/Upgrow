@{
    ViewData["Title"] = "Manage API Documentation";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <div class="row mt-2">
        <div class="card">

            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-6">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div>
                    <div class="col-6 text-align-end">
                        <form-button label="Add API Documentation"
                                     type="Add"
                                     url="@Url.Action("ManageApiDocumentMaster", "AIX")">
                        </form-button>
                    </div>
                </div>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_apix">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr. No</th>
                                <th style="display:none;">UUID</th>
                                <th>API Title</th>
                                <th>Version</th>
                                <th>Method</th>
                                <th>Path</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editApixLink" label="Edit API Version" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

    <partial name="_Timer" />
</div>

@section Scripts {
    <partial name="_ViewScripts" />

    <script>
        // Initialize datatable similar to other master views.
        initMasterTable({
            tableId: '#datatable_apix',
            ajaxUrl: '@Url.Action("GetApiXVersions", "AIX")', // Implement server endpoint to return paged data
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'title' },
                { data: 'versionNo' },
                { data: 'method' },
                { data: 'path' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editApixLink',
                    baseUrl: '@Url.Action("ManageApiDocumentMaster", "AIX")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // default navigation: opens ManageApiDocumentMaster GET with uuid param for edit
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("ApiXVersion", rowData.uuid, false, "");
                    }
                }
            ]
        });

        // Wire up activity log table if needed
        initActivityLogTable({ menuName: 'ApiXVersion' });

        // AuditLogs friendly-field mapping (optional)
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {},
                friendlyFieldMap: {
                    "Title": "API Title",
                    "VersionNo": "Version",
                    "ApiMethod": "Method",
                    "ApiPath": "Path"
                },
                hiddenFields: []
            })
        );
    </script>
}