@{
    ViewData["Title"] = "View Our Team";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-end">
                    <form-button label="Add Team"
                                 type="Add"
                                 url="@Url.Action("AddOurTeam", "Website")">
                    </form-button>
                   
                </div>
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Name</th>
                            <th>Profile</th>
                            <th>Designation</th>
                            <th>Description</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->

        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editteam" label="Edit Team Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
            initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetOurTeams", "Website")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'name' },
                { data: 'image',orderable: false },
                { data: 'designation' },
                { data: 'description',orderable: false },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editteam',
                    baseUrl: '@Url.Action("EditOurTeam", "Website")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },                
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("OurTeam", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
                   AuditLogsUI.common.mergeConfig({
                       foreignKeyMap: {
                       },
                       friendlyFieldMap: {
                           "Name": "Team Member Name",
                           "Designation": "Designation",
                           "ImageFile": "Profile Image",
                           "Description": "Description",
                           "IsActive": "Status"
                       },
                       hiddenFields: [
                           "ImageFile"
                       ]
                   })
               );
    </script>
    <script>
        initActivityLogTable({ menuName: 'OurTeam' });
    </script>
}