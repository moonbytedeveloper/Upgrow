@{
    ViewData["Title"] = "View Certifications";
}

@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">

    <div class="row mt-2">

        <div class="card">
                <!-- Header -->
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-lg-6 col-md-8 col-6">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">
                                @ViewData["Title"]
                            </h3>
                        </div>

                            <div class="col-lg-6 text-end">
                            <form-button label="Add Certification"
                                         type="Add"
                                         url="@Url.Action("AddCertification", "Website")">
                            </form-button>
                        </div>
                    </div>
                </div>

                <!-- Body -->
                <div class="card-body">

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                            <thead class="thead-light">
                                <tr>
                                    <th>Sr. No</th>
                                    <th style="display:none;">UUID</th>
                                    <th>Certification Name</th>
                                    <th>Image</th>
                                    <th data-action-column="true">Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                </div>
        </div><!--end card-->
    </div>

    <!-- Row Action Menu -->
    <div id="rowActionMenu" class="row-action-menu">
        <ul>
                <action-link id="editCertificationLink" label="Edit Certification Details" type="Edit"></action-link>
                <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div>

<partial name="_Timer" />

@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetCertifications", "Website")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'name' },
                { data: 'image', orderable: false },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editCertificationLink',
                    baseUrl: '@Url.Action("EditCertification", "Website")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                        {
            selector: '#viewHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Certifications", rowData.uuid, false, "");
            }
        }
            ]
        });
                AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                },
                friendlyFieldMap: {
                    "Name": "Certification Name",
                    "FilePath": "Certification Image",
                    "IsActive": "Status"
                },
                hiddenFields: [
                    "FilePath"
                ]
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Certification' });
    </script>
}