@{
    Layout = null;
}

<!DOCTYPE html>

<html lang="en" data-layout="horizontal" data-topbar="dark" data-sidebar-size="lg" data-sidebar="light" data-sidebar-image="none" data-preloader="disable">
<head>

    ```
    <meta charset="utf-8">
    <title>Access Denied - Verify India</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Layout config Js -->
    <script src="@Url.Content("~/assets/js/layout.js")"></script>

    <!-- Bootstrap Css -->
    <link href="@Url.Content("~/assets/css/bootstrap.min.css")" rel="stylesheet" />
    <!-- Icons Css -->
    <link href="@Url.Content("~/assets/css/icons.min.css")" rel="stylesheet" />
    <!-- App Css -->
    <link href="@Url.Content("~/assets/css/app.min.css")" rel="stylesheet" />
    <!-- Custom Css -->
    <link href="@Url.Content("~/assets/css/custom.min.css")" rel="stylesheet" />

    <!-- Fix broken layout / svg / particles -->
    <style>
        body, html {
            height: 100%;
        }

        .auth-page-wrapper {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
        }

        .auth-one-bg {
            position: absolute;
            width: 100%;
            height: 100%;
            top: 0;
            left: 0;
            z-index: 0;
        }

            .auth-one-bg .bg-overlay {
                position: absolute;
                width: 100%;
                height: 100%;
                background: rgba(0,0,0,0.5);
                top: 0;
                left: 0;
            }

            /* FIX SVG SHAPE */
            .auth-one-bg .shape {
                position: absolute;
                bottom: 0;
                width: 100%;
                overflow: hidden;
                line-height: 0;
            }

                .auth-one-bg .shape svg {
                    display: block;
                    width: 100%;
                    height: auto;
                }

        /* FIX PARTICLES OVERLAY */
        #auth-particles canvas {
            position: absolute !important;
            top: 0;
            left: 0;
            z-index: 0;
        }

        .auth-page-content {
            position: relative;
            z-index: 2;
        }

    </style>
  

</head>

<body>

    <div class="auth-page-wrapper pt-5">

        <!-- Background -->
        <div class="auth-one-bg-position auth-one-bg" id="auth-particles">
            <div class="bg-overlay"></div>

            <div class="shape">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 120">
                    <path d="M 0,36 C 144,53.6 432,123.2 720,124 C 1008,124.8 1296,56.8 1440,40L1440 140L0 140z"></path>
                </svg>
            </div>
        </div>

        <!-- Content -->
        <div class="auth-page-content">
            <div class="container">
                <div class="row">
                    <div class="col-lg-12">
                        <div class="text-center pt-4">
                            <div class="">
                                <img src="~/assets/images/error.svg" alt="" class="error-basic-img move-animation" style="max-height:500px;">
                            </div>
                            <div class="mt-n4">
                                <h1 class="display-1 fw-medium">Sorry!</h1>
                                <h3 class="text-uppercase">Access Denied 😭</h3>
                                <p class="text-muted mb-4">Please connect administrator for access!</p>
                                <a href="@Url.Action("Index", "Dashboard")" class="btn btn-success"><i class="mdi mdi-home me-1"></i>Back to home</a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end row -->

            </div>
            <!-- end container -->
        </div>
        </div>
    <!-- JAVASCRIPT -->
    <script src="@Url.Content("~/assets/libs/particles.js/particles.js")"></script>
    <script src="@Url.Content("~/assets/js/pages/particles.app.js")"></script>
    <script src="@Url.Content("~/assets/js/plugins.js")"></script>

    <!-- Fallback if particles fail -->
   

</body>
</html>
