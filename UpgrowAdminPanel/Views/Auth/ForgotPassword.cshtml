@model Upgrow.Application.DTO.Auth.ForgotPasswordDto
@{
    Layout = null;  // keep page design unchanged
}
<html lang="en" dir="ltr">

<head>

    <meta charset="utf-8" />
    <title>Upgrow - Login Page</title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta content name="description" />
    <meta content name="author" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <script src="~/assets/js/darktheme.js"></script>

    <!-- App favicon -->
    <partial name="_Favicon" />

    <!-- App css -->
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" />
    <link href="~/assets/css/custom.css" rel="stylesheet" />
    <style>
        .Login-Page-Content {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .Login-Page-Content-Title {
            color: #ffffff;
            font-size: 40px;
            margin-top: 32px;
            margin-bottom: 20px;
        }

            .Login-Page-Content-Title span {
                color: var(--theme-secondary)
            }

        .right-bg-white {
            border-radius: 15px;
            height: 99%;
        }

        .features-section {
            max-width: 1400px;
            margin: auto;
            padding: 25px 20px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 700px
        }

        .feature-item {
            flex: 1;
            text-align: center;
        }

        .feature-icon {
            font-size: 40px;
            color: #fff;
            margin-bottom: 10px;
        }

        .feature-item h3 {
            font-size: 18px;
            font-weight: 300;
            line-height: 1.35;
            color: #fff;
            margin: 0px;
        }

            .feature-item h3 span {
                color: var(--theme-secondary);
                font-weight: 400;
            }

        .divider {
            width: 1px;
            height: 100px;
            background: var(--theme-secondary);
            opacity: .8;
        }

        .Login-Page-Main-Div {
            padding-top: 10px;
            padding-right: 15px;
        }
        /* Tablet */
        @@media(max - width:992px) {
            .features-section {
                flex-wrap: wrap;
                gap: 50px;
            }

            .divider {
                display: none;
            }

            .feature-item {
                flex: 0 0 45%;
            }
        }

        /* Mobile */
        @@media(max - width:600px) {
            .features-section {
                flex-direction: column;
                padding: 50px 20px;
            }

            .feature-item {
                width: 100%;
            }

            .feature-icon {
                font-size: 45px;
            }

            .feature-item h3 {
                font-size: 28px;
            }
        }
    </style>
</head>

<body id="body" class="auth-page background-primary">

    <div class="row d-flex justify-content-center overflow-hidden mobile-view Login-Page-Main-Div">
        <div class="col-12 align-self-center">
            <div class="card-body">
                <div class="row">

                    <!-- LEFT SIDE -->
                    <div class="col-lg-8 p-0">
                        <div class="Login-Page-Content">
                            <div class="text-center">
                                <h2 class="Login-Page-Content-Title">India's <span>Trusted</span> Verification Platform</h2>

                                <section class="features-section">

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="fas fa-shield-alt"></i>
                                        </div>

                                        <h3>
                                            <span>Secure</span><br>
                                            Verification
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="fas fa-bolt"></i>
                                        </div>

                                        <h3>
                                            <span>Real-Time</span><br>
                                            Results
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="far fa-id-card"></i>
                                        </div>

                                        <h3>
                                            <span>Fraud</span><br>
                                            Prevention
                                        </h3>
                                    </div>

                                    <div class="divider"></div>

                                    <div class="feature-item">
                                        <div class="feature-icon">
                                            <i class="far fa-building
"></i>
                                        </div>

                                        <h3>
                                            <span>Government</span><br>
                                            Grade-Security
                                        </h3>
                                    </div>

                                </section>

                            </div>

                            <div class="text-center">
                                <img src="~/assets/images/newwebsite/LoginPageImage.svg" class="img-fluid" style="width 100%;height: 100%; max-width:99%;" />
                            </div>
                        </div>



                    </div>
                    <!--end card-body-->
                    <!-- RIGHT SIDE -->
                    <div class="col-lg-4">
                        <div class="bg-white right-bg-white">
                            <form Id="bannerForm" asp-action="ForgotPassword" asp-controller="Auth" method="post" novalidate>
                                @Html.AntiForgeryToken()
                                <div class="login-container">
                                    <header class="text-center">
                                        <div class="login-page-logo mb-3">
                                            <img src="~/assets/images/newwebsite/AuthenticateIndia-logo-png.png" />
                                        </div>

                                        <h2 class="fw-600 mt-0 mb-0 text-dark" style="color: #020202 !important;">Welcome Back!</h2>
                                        <br />
                                        @*  <br /> *@
                                    </header>


                                    <div class="login-container__form">

                                        <div class="login-container__form-content">


                                            @* TempData-based alert (same keys used elsewhere) *@
                                            @if (TempData["Message"] != null)
                                            {
                                                <div class="alert alert-@TempData["MessageType"] alert-dismissible border-2 bg-body-secondary fade show" id="success-alert" role="alert" style="margin-bottom:0px;">
                                                    <strong>@TempData["Message"]</strong>
                                                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                                                </div>
                                            }

                                            @* Validation summary *@
                                            <div class="mb-3">
                                                <span asp-validation-summary="ModelOnly" class="text-danger"></span>
                                            </div>

                                            @* Use shared form-field for consistent rendering and model binding *@
                                            <div class="mb-3">
                                                <form-field asp-for="Email"
                                                            label="Email Id"
                                                            type="Text"
                                                            required="true" />
                                            </div>

                                            <div class="form-group mt-3">

                                                <div class="text-end">
                                                    <a asp-action="Login" asp-controller="Auth" class="theme-text-color font-13">
                                                        <i class="dripicons-lock"></i>
                                                        Sign in ?
                                                    </a>
                                                </div><!--end col-->
                                            </div><!--end form-group-->



                                        </div>

                                        <div class="text-center mt-4">
                                            <div class="form-group mb-0 text-center mt-3">


                                                <button type="submit" class="btn w-50 btn-secondary btn-round fw-600 fs-15">
                                                    Login
                                                </button>

                                            </div> <!--end form-group-->
                                            <hr />
                                            <p class="fw-500 fs-14 mb-0">
                                                © <span id="currentyear"></span> AuthenticateIndia. All rights reserved.
                                            </p>
                                        </div>
                                        <!--end form-->
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- vendor js -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/simplebar/simplebar.min.js"></script>
    <script src="~/assets/libs/feather-icons/feather.min.js"></script>

    <!-- App js -->
    <script src="~/assets/js/app.js"></script>

    <script>
        // auto-hide alert after 5s (same behavior as other auth pages)
        setTimeout(function () {
            var alert = document.getElementById('success-alert');
            if (alert) { alert.style.display = 'none'; }
        }, 5000);
    </script>
    <script>
             document.addEventListener("DOMContentLoaded", () => {
            const currentyear = document.getElementById("currentyear");

            if (currentyear) {
                currentyear.textContent = new Date().getFullYear();
            }
        });
    </script>
</body>

</html>