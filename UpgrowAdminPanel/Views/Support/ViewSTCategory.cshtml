@{
    ViewData["Title"] = "Support Ticket Category";
}
@section Styles {
    <partial name="_ViewStyles" />
}


<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">

        <div class="card">
        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-align-end">
                    <form-button label="Add Support Ticket Category"
                                 type="Add"
                                 url="@Url.Action("AddSTCategory", "Support")">
                    </form-button>
                   
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Title</th>
                            <th>Designation</th>
                            <th>User Type</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>

                </table>

            </div>


        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>

            <action-link id="editLink" label="Edit Support Ticket Category" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>

        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />


@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        const genderTable = initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetSTCategory", "Support")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'title' },
                { data: 'designation' },
                { data: 'usertype' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editLink',
                    baseUrl: '@Url.Action("EditSTCategory", "Support")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                        {
            selector: '#viewHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Support_TicketCategory", rowData.uuid, false, "");
            }
        }
            ]
        });

                AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
            foreignKeyMap: {
                "DesignationUUID": "/Common/GetDesignationName"
            },
            friendlyFieldMap: {
                "Title": "Ticket Category",
                "DesignationUUID": "Designation"
            },
            hiddenFields: [
            ]
        })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Support_TicketCategory' });
    </script>
}