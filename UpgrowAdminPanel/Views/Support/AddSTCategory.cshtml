@using UpgrowAdminPanel
@using UpgrowAdminPanel.Models
@using UpgrowAdminPanel.Models.Support
@model SupportTicketCategoryVM
@{
    var isEditMode = !string.IsNullOrEmpty(Model?.STC.UUID);
    ViewData["Title"] = isEditMode ? "Edit Support Ticket Category" : "Add Support Ticket Category";
}

@section HighPriority {
    <link href="~/assets/css/select2.min.css" rel="stylesheet" type="text/css" />
}


<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">

        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="card-title fs-20">@ViewData["Title"]</h3>
                    </div><!--end col-->

                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body pt-0">
                <form id="bannerForm" asp-action="AddSTCategory" method="post">
                    <input type="hidden" asp-for="STC.UUID" />
                    <input type="hidden" asp-for="STC.IsActive" />

                    <div class="row align-items-center">
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="STC.Title"
                                        label="Title"
                                        type="Text"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="STC.DesignationUUID"
                                        label="Designation"
                                        type="Select"
                                        asp-items="Model?.DesignationList"
                                        required="true" />
                        </div>
                        <div class="col-lg-3 col-md-4 col-sm-6 col-12">
                            <form-field asp-for="STC.UserType"
                                        label="User Type"
                                        type="Select"
                                        asp-items="Model?.UserTypeList"
                                        required="true" />
                        </div>


                        <div class="col-lg-3 col-md-12 col-sm-6 col-12 text-align-end pt-4">
                            <form-button label="Cancel"
                                         type="Cancel"
                                         url="@Url.Action("ViewSTCategory", "Support")" />
                            <form-button label="Submit"
                                         type="Submit" />
                        </div>

                    </div>
                </form>


            </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->



</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />



<!-- end page-wrapper -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/assets/js/validationanimation.js"></script>
    <script src="~/assets/js/select2.min.js"></script>

}

