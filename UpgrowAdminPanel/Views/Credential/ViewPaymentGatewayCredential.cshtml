@{
    ViewData["Title"] = "View Payment Gateway Credentials";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-6">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                    </div><!--end col-->
                    <div class="col-6 text-align-end">
                        <form-button label="Add Payment Gateway Credentials"
                                     type="Add"
                                     url="@Url.Action("AddPaymentGatewayCredential", "Credential")">
                        </form-button>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr.</th>
                                <th style="display:none;">UUID</th>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Api Key</th>
                                <th>Merchant Id</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                        </tbody>
                    </table>
                </div>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editPaymentGatewayLink" label="Edit Payment Gateway Credential Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />

@section Scripts {
    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetPaymentGatewayCredentials", "Credential")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'name' },
                { data: 'code' },
                { data: 'apikey' },
                { data: 'merchantId' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editPaymentGatewayLink',
                    baseUrl: '@Url.Action("EditPaymentGatewayCredential", "Credential")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("PaymentGatewayCredential", rowData.uuid, false, "");
                    }
                }
            ]
        });

        // Initialize Audit Logging with Field Mapping
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {},
                friendlyFieldMap: {
                    "Name": "Name",
                    "APIKey": "API Key",
                    "Code": "Code",
                    "MerchantId": "Merchant Id",
                    // "EncryptedKeySecret": "Secret Key",
                    "IsActive": "Status"
                },
                hiddenFields: [
                    "APIKey",
                    "Secret"
                ]
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'PaymentGatewayCredential' });
    </script>
}