@{
    ViewData["Title"] = "API X Status Codes Management";
}
@section Styles {
    <partial name="_ViewStyles" />
}

<div class="container-fluid">
    <!-- Page-Title -->
    <div class="row mt-2">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col-6">
                        <h3 class="card-title fs-20 mt-3 mb-3 ms-2">View ApiXStatus Codes</h3>
                    </div><!--end col-->
                    <div class="col-6 text-align-end">
                        <form-button label="Add Status Code"
                                     type="Add"
                                     url="@Url.Action("MasterAddApiXStatusCodes", "Api")">
                        </form-button>
                    </div><!--end col-->
                </div> <!--end row-->
            </div><!--end card-header-->
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                        <thead class="thead-light">
                            <tr>
                                <th>Sr. No</th>
                                <th style="display:none;">UUID</th>
                                <th>Title</th>
                                <th>Status Code</th>
                                <th>Is Success</th>
                                <th data-action-column="true">Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div><!--end card-body-->
        </div><!--end card-->
    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>           
            <action-link id="editApiXStatusCodesLink" label="Edit Status Code Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>
</div><!-- container -->

<!-- Timer -->
<partial name="_Timer" />

@section Scripts {
    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetApiXStatusCodes", "Api")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'title' },
                { data: 'statusCode' },
                {
                    data: 'isSuccess',
                    orderable: false,
                    render: function (data, type, row) {
                        return data ? '<span class="badge badge-outline-success">Success</span>' : '<span class="badge badge-outline-danger">Error</span>';
                    }
                },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editApiXStatusCodesLink',
                    baseUrl: '@Url.Action("MasterEditApiXStatusCodes", "Api")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                },
                {
                    selector: '#viewHistoryLink',
                    baseUrl: 'javascript:void(0)',
                    idProperty: 'uuid',
                    handler: function (rowData) {
                        AuditLogsUI.openLogs("ApiXStatusCodes", rowData.uuid, false, "");
                    }
                }
            ]
        });
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                },
                friendlyFieldMap: {
                    "Title": "Title",
                    "StatusCode": "Status Code",
                    "IsSuccess": "Is Success"
                },
                hiddenFields: [
                ]
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'ApiXStatusCodes' });
    </script>
}