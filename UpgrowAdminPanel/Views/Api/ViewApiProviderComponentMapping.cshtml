@{
    ViewData["Title"] = "View Api Provider Component Mapping";
}
@section Styles {
    <partial name="_ViewStyles" />
}



<div class="container-fluid">
    <!-- Page-Title -->

    <div class="row mt-2">
        <div class="card">

        <div class="card-header">
            <div class="row align-items-center">
                <div class="col-6">
                    <h3 class="card-title fs-20 mt-3 mb-3 ms-2">@ViewData["Title"]</h3>
                </div><!--end col-->
                <div class="col-6 text-align-end">
                        <form-button label="Add Component Mapping"
                                 type="Add"
                                 url="@Url.Action("AddApiProviderComponentMapping", "Api")">
                    </form-button>
                   
                </div><!--end col-->
            </div> <!--end row-->
        </div><!--end card-header-->
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-hover datatableeditpopup" id="datatable_1">
                    <thead class="thead-light">
                        <tr>
                            <th>Sr. No</th>
                            <th style="display:none;">UUID</th>
                            <th>Api Name</th>
                            <th>Component Name</th>
                            <th data-action-column="true">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>

            </div>


        </div><!--end card-body-->
        </div><!--end card-->

    </div><!--end row-->

    <div id="rowActionMenu" class="row-action-menu">
        <ul>
            <action-link id="editApiProviderComponentMappingLink" label="Edit Api Provider Component Mapping Details" type="Edit"></action-link>
            <action-link id="viewHistoryLink" label="View History" type="ViewHistory"></action-link>
        </ul>
    </div>

</div><!-- container -->
<!-- Timer -->
<partial name="_Timer" />
@section Scripts {

    <partial name="_ViewScripts" />

    <script>
        initMasterTable({
            tableId: '#datatable_1',
            ajaxUrl: '@Url.Action("GetApiProviderComponentMapping", "Api")',
            columns: [
                { data: 'srno', orderable: false },
                { data: 'uuid', visible: false },
                { data: 'api' },
                { data: 'component' },
                { data: 'action', orderable: false }
            ],
            rowActions: [
                {
                    selector: '#editApiProviderComponentMappingLink',
                    baseUrl: '@Url.Action("EditApiProviderComponentMapping", "Api")',
                    idProperty: 'uuid',
                    paramName: 'uuid'
                    // No handler = default navigation
                },
                        {
            selector: '#viewHistoryLink',
            baseUrl: 'javascript:void(0)',
            idProperty: 'uuid',
            handler: function (rowData) {
                AuditLogsUI.openLogs("Api_ProviderComponentMapping", rowData.uuid, false, "");
            }
        }
            ]
        });
         // Initialize Audit Logging with Foreign Key Mapping
        AuditLogsUI.init(
            AuditLogsUI.common.mergeConfig({
                foreignKeyMap: {
                    "ApiUUID": "/Common/GetApiName",
                    "ProviderUUID": "/Common/GetProviderName",
                    "ComponentUUID": "/Common/GetApiComponentName"
                },
                friendlyFieldMap: {
                    "ApiUUID": "Api Name",
                    "ProviderUUID": "Provider Name",
                    "ComponentUUID": "Component Name",
                    "IsActive": "Status"
                },
                hiddenFields: []
            })
        );
    </script>
    <script>
        initActivityLogTable({ menuName: 'Api_ProviderComponentMapping' });
    </script>
}